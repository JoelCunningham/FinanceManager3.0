{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch FinanceManager.WebApp",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/FinanceManager.WebApp/FinanceManager.WebApp.csproj"
        },
        {
            "name": "Watch FinanceManager.WebApp (Hot Reload)",
            "type": "node-terminal",
            "request": "launch",
            "command": "dotnet watch --project \"${workspaceFolder}/FinanceManager.WebApp/FinanceManager.WebApp.csproj\" run --launch-profile watch"
        }
    ]
}