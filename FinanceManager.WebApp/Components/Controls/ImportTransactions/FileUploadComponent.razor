@code {
    [Parameter]
    public ParserInfo? SelectedBank { get; set; }
    [Parameter]
    public FileValidationState ValidationState { get; set; }
    [Parameter]
    public string? ImportErrorMessage { get; set; }
    [Parameter]
    public EventCallback<IBrowserFile> OnFileImport { get; set; }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        await OnFileImport.InvokeAsync(e.File);
    }

    private string ValidationCssClass => ValidationState switch
    {
        FileValidationState.Valid => "is-valid",
        FileValidationState.Invalid => "is-invalid",
        _ => string.Empty
    };
}

@if (SelectedBank?.SupportedExtensions.Count > 0)
{
    <h2 class="section-heading">Upload your transactions:</h2>
    <InputFile OnChange="OnFileSelected" accept="@string.Join(',', SelectedBank.SupportedExtensions)" class="@($"form-control {ValidationCssClass}")" />
    @if (ValidationState == FileValidationState.Valid)
    {
        <div class="valid-feedback">File uploaded successfully.</div>
    }
    @if (ValidationState == FileValidationState.Invalid)
    {
        <div class="invalid-feedback">@ImportErrorMessage</div>
    }
}