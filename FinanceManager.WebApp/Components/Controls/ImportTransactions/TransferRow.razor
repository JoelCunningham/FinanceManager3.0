@code {
    [Parameter, EditorRequired]
    public ImportedTransaction Transfer { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<ImportedTransaction> AcceptTransfer { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<ImportedTransaction> RejectTransfer { get; set; }

    private string? _animationClass;
    private bool _isAnimating => _animationClass is not null;

    private async Task Accept()
    {
        _animationClass = "accepting";
        await Task.Delay(700);
        await AcceptTransfer.InvokeAsync(Transfer);
        _animationClass = null;
    }

    private async Task Reject()
    {
        _animationClass = "rejecting";
        await Task.Delay(700);
        await RejectTransfer.InvokeAsync(Transfer);
        _animationClass = null;
    }
}

<div class="transaction-group @_animationClass">
    <div class="general-row transaction-row">
        <div>@Transfer.Date.ToShortDateString()</div>
        <div>@Transfer.BankRecord.AccountNumber</div>
        <div>@Transfer.Description</div>
        <div>@Transfer.Amount.ToString("C")</div>
        <div></div>
        <div></div>
    </div>
    @if (Transfer.Transfers is not null)
    {
        <div class="general-row transfer-row">
            <div>@Transfer.Transfers.Date.ToShortDateString()</div>
            <div>@Transfer.Transfers.BankRecord.AccountNumber</div>
            <div>@Transfer.Transfers.Description</div>
            <div>@Transfer.Transfers.Amount.ToString("C")</div>
            <div><button type="button" class="btn btn-danger" onclick="@Reject" disabled="@_isAnimating">Reject</button></div>
            <div><button type="button" class="btn btn-success" onclick="@Accept" disabled="@_isAnimating">Accept</button></div>
        </div>
    }
</div>