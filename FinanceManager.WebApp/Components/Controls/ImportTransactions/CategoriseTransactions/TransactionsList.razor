@using FinanceManager.WebApp.Models.ImportPage

@code {
    [Parameter, EditorRequired]
    public required ImportPageCategoriseModel Model { get; set; }
}

@if (Model.GroupedTransactions.Count > 0)
{
    <h2 class="section-heading">Categorise your transactions:</h2>

    <TransactionsHeader>
        @foreach (var transaction in Model.GroupedTransactions)
        {
            <TransactionGroupRow Transaction="transaction" CurrentTransactions="Model.AllTransactions" />
        }
    </TransactionsHeader>
}
else
{
    <div class="alert alert-info" role="alert">
        No other transactions were detcted in your upload
    </div>
}