@using FinanceManager.WebApp.Models.ImportPage

@code {
    [Parameter, EditorRequired]
    public required ImportPageReimbursementsModel Model { get; set; }

    private bool HasPendingReimbursements => Model.DetectedReimbursements.Count > 0;
    private bool HasResolvedReimbursements => Model.AcceptedReimbursements.Count > 0 || Model.RejectedReimbursements.Count > 0;
}

<TransferListActions HasPendingTransfers="@HasPendingReimbursements"
                     HasResolvedTransfers="@HasResolvedReimbursements"
                     OnReset="@Model.Reset"
                     OnRejectAll="@Model.RejectRemainingReimbursements"
                     OnAcceptAll="@Model.AcceptRemainingReimbursements" />

@if (HasPendingReimbursements)
{
    <TransfersHeader>
        @foreach (var reimbursement in Model.GroupedReimbursements)
        {
            <TransferPairRow Transfer="reimbursement" AcceptTransfer="Model.AcceptTransfer" RejectTransfer="Model.RejectTransfer" />
        }
    </TransfersHeader>
}
else
{
    <div class="alert alert-success" role="alert">
        All detected Reimbursements have been resolved
    </div>
}
