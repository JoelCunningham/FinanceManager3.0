@code {
    [Parameter, EditorRequired]
    public required ImportPageUploadModel Model { get; set; }

    [Parameter]
    public EventCallback<IBrowserFile> OnFileImport { get; set; }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        await OnFileImport.InvokeAsync(e.File);
    }

    private string ValidationCssClass => Model.FileValidationState switch
    {
        FileValidationState.Valid => "is-valid",
        FileValidationState.Invalid => "is-invalid",
        _ => string.Empty
    };
}

@if (Model.SelectedBank?.SupportedExtensions.Count > 0)
{
    <h2 class="section-heading">Upload your transactions:</h2>
    <InputFile OnChange="OnFileSelected" accept="@string.Join(',', Model.SelectedBank.SupportedExtensions)" class="@($"form-control {ValidationCssClass}")" />
    @if (Model.FileValidationState == FileValidationState.Valid)
    {
        <div class="valid-feedback">File uploaded successfully.</div>
    }
    @if (Model.FileValidationState == FileValidationState.Invalid)
    {
        <div class="invalid-feedback">@Model.FileErrorMessage</div>
    }
}