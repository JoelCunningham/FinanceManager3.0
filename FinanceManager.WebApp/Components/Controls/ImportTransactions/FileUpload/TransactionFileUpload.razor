@code {
    [Parameter, EditorRequired]
    public required ImportPageUploadModel Model { get; set; }

    [Parameter]
    public EventCallback<IBrowserFile> OnFileUploaded { get; set; }

    private async Task OnFileSelected(IBrowserFile file)
    {
        await OnFileUploaded.InvokeAsync(file);
    }

    private FormValidationState ValidationState => Model.FileValidationState switch
    {
        UploadValidationState.Valid => FormValidationState.Valid,
        UploadValidationState.Invalid => FormValidationState.Invalid,
        UploadValidationState.Accepted => FormValidationState.Valid,
        _ => FormValidationState.None
    };

    private string? ValidationMessage => Model.FileValidationState switch
    {
        UploadValidationState.Valid => "File uploaded successfully.",
        UploadValidationState.Invalid => Model.FileErrorMessage,
        _ => null
    };
}

@if (Model.SelectedBank is not null)
{
    <FileUploadInput Heading="Upload your transactions:"
                     AcceptedExtensions="@string.Join(',', Model.SelectedBank.SupportedExtensions)"
                     ValidationState="@ValidationState"
                     ValidationMessage="@ValidationMessage"
                     OnFileSelected="@OnFileSelected" />
}