@code {
    [Parameter, EditorRequired]
    public required string BankName { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private string GetBankLogoPath(string bankName)
    {
        return $"/images/banks/{bankName.ToLowerInvariant().Replace(" ", "-")}.svg";
    }

    private async Task HandleClick()
    {
        await OnSelect.InvokeAsync(BankName);
    }
}

<div class="bank-card" @onclick="HandleClick">
    <input type="radio" class="bank-card-input" name="bankSelect" id="@BankName" checked="@IsSelected" @onchange="HandleClick" />
    <label class="bank-card-label" for="@BankName">
        <div class="bank-card-content">
            <img class="bank-logo" src="@GetBankLogoPath(BankName)" alt="@BankName logo" />
            <div class="bank-name">@BankName</div>
        </div>
    </label>
</div>
