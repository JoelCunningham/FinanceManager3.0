@using FinanceManager.WebApp.Models.ImportPage

@code {
    [Parameter, EditorRequired]
    public required ImportPageTransfersModel Model { get; set; }

    public string _resetClass => GetResetClass();

    private string GetResetClass()
    {
        if (Model.AcceptedTransfers.Count > 0 || Model.RejectedTransfers.Count > 0)
        {
            return "btn btn-info";
        } else
        {
            return "btn btn-secondary disabled";
        }
    }
}

@if (Model.DetectedTransfers.Count > 0)
{
    <div class="transaction-grid">
        <div class="transaction-grid-buttons">
            <div></div>
            <div></div>
            <div></div>
            <button type="button" class="@_resetClass" @onclick="@Model.Reset">Reset</button>
            <button type="button" class="btn btn-danger" @onclick="@Model.RejectRemainingTransfers">Reject All</button>
            <button type="button" class="btn btn-success" @onclick="@Model.AcceptRemainingTransfers">Accept All</button>
        </div>
        <div class="transaction-grid-header">
            <div>Date</div>
            <div>Account</div>
            <div>Description</div>
            <div>Amount</div>
            <div></div>
            <div></div>
        </div>
        @foreach (var transfer in Model.GroupedTransfers)
        {
            <TransferRow Transfer="transfer" AcceptTransfer="Model.AcceptTransfer" RejectTransfer="Model.RejectTransfer" />
        }
    </div>
}
else
{
    <div class="transaction-grid">
        <div class="transaction-grid-buttons">
            <div></div>
            <div></div>
            <div></div>
            <div></div>
            <div></div>
            <button type="button" class="btn btn-info" @onclick="@Model.Reset">Reset</button>
        </div>
    </div>
    <div class="alert alert-success" role="alert">
        All detected transfers have been resolved
    </div>
}
