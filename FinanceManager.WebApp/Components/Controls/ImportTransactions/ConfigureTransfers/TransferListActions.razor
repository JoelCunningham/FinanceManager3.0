@code {
    [Parameter, EditorRequired]
    public required bool HasPendingTransfers { get; set; }

    [Parameter, EditorRequired]
    public required bool HasResolvedTransfers { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback OnRejectAll { get; set; }

    [Parameter]
    public EventCallback OnAcceptAll { get; set; }

    private string ResetButtonClass => HasResolvedTransfers ? "btn btn-info" : "btn btn-secondary disabled";
}

<div class="transfer-actions">
    <div></div>
    <div></div>
    <div></div>
    @if (HasPendingTransfers)
    {
        <button type="button" class="@ResetButtonClass" @onclick="OnReset">Reset</button>
        <button type="button" class="btn btn-danger" @onclick="OnRejectAll">Reject All</button>
        <button type="button" class="btn btn-success" @onclick="OnAcceptAll">Accept All</button>
    }
    else
    {
        <div></div>
        <div></div>
        <button type="button" class="btn btn-info" @onclick="OnReset">Reset</button>
    }
</div>
