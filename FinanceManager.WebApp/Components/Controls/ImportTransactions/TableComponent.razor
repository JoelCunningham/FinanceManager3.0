@code {
    [Parameter]
    public IReadOnlyList<BankRecord>? Transactions { get; set; }
}

@if (Transactions is not null && Transactions.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Transactions)
            {
                <tr>
                    <td>@transaction.Date.ToShortDateString()</td>
                    <td>@transaction.Narrative</td>
                    <td>@transaction.TotalAmount</td>
                </tr>
            }
        </tbody>
    </table>
}
