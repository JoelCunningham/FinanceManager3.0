@inject TransactionService TransactionService

@code {
    private List<Transaction>? transactions;


    protected override async Task OnInitializedAsync()
    {
        transactions = (await TransactionService.GetTransactionsByNameAsync()).ToList();
    }
}

@if (transactions is null || !transactions.Any())
{
    <p><em>Loading...</em></p>
}
else
{
    <h3>Transactions</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in transactions)
            {
               <TransactionListItemComponent Transaction="transaction" />
            }
        </tbody>
    </table>
}
