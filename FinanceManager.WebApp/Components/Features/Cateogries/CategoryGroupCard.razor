@code {
    [Parameter] public CategoryGroupSummary Group { get; set; } = default!;
}

<div class="group-card" style="--group-accent-color: @Group.Colour;">
    <div class="group-card-header">
        @if (Group.IsIncome)
        {
            <div class="group-card-icon group-card-icon-income">
                <HxTooltip Text="Income">
                    <HxIcon Icon="BootstrapIcon.GraphUpArrow" />
                </HxTooltip>
            </div>
        }
        else
        {
            <div class="group-card-icon group-card-icon-expense">
                <HxTooltip Text="Expense">
                    <HxIcon Icon="BootstrapIcon.GraphDownArrow" />
                </HxTooltip>
            </div>
        }
        <div class="group-card-title" title="@Group.Name">@Group.Name</div>
    </div>

    <div class="group-card-subtitle">
        @Group.CategoryCount categories
    </div>
</div>
