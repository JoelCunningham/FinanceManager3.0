@code {
    [Parameter, EditorRequired]
    public required UncategorisedViewData TransactionGroup { get; set; }

    [Parameter]
    public IEnumerable<Category> Categories { get; set; } = [];

    private void SetAmount(decimal value, UncategorisedTransaction transaction)
    {
        try
        {
            TransactionGroup.SetAmount(transaction, value);
        }
        catch
        {
            // TODO Maybe a warning?
        }
    }

    private void SetCategory(Guid? categoryId, UncategorisedTransaction transaction)
    {
        if (categoryId is null) return;
        transaction.Category = Categories.FirstOrDefault(c => c.Id == categoryId);
    }

    private bool IsTransferDisabled => TransactionGroup.Transactions.Count() != 1;
}

<div class="transaction-group">
    <div class="transaction-rows">
        @foreach (var (transaction, index) in TransactionGroup.Transactions.Select((t, i) => (t, i)))
        {
            <div class="transactions-row">
                <select class="form-control form-select" @bind:get="transaction.Category?.Id" @bind:set="v => SetCategory(v, transaction)">
                    <option disabled value="">Select category</option>
                    @foreach (var category in Categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
                <input type="date" class="form-control" @bind="transaction.Date" @bind:format="yyyy-MM-dd" max="@TransactionGroup.Record.Date.ToString("yyyy-MM-dd")" />
                <input type="text" class="form-control" @bind="transaction.Description" @bind:event="oninput" />
                <input type="number" class="form-control" @bind:get="transaction.Amount" @bind:set="v => SetAmount(v, transaction)" min="0" max="@TransactionGroup.Record.Amount" />
                @if (index == 0)
                {
                    <button class="btn btn-secondary" @onclick="() => TransactionGroup.Split()">Split</button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="() => TransactionGroup.Unsplit(transaction)">Unsplit</button>
                }
                <button class="btn btn-secondary">Reimburse</button>
            </div>
        }
    </div>
    <div class="action-buttons">
        <button class="btn btn-secondary @(IsTransferDisabled ? "disabled" : "")"
                disabled="@IsTransferDisabled"
                title="@(IsTransferDisabled ? "Cannot transfer split records" : "")">
            Change to transfer
        </button>
        <button class="btn btn-secondary" @onclick="TransactionGroup.Reset">Reset</button>
        <button class="btn btn-primary">Confirm</button>
    </div>
</div>