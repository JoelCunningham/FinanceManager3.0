@code {
    [Parameter, EditorRequired]
    public required TransactionViewData Transaction { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<TransactionViewData> CurrentTransactions { get; set; }
}

<div class="transaction-group">
    <div class="base-transaction">
        <TransactionRow Transaction="Transaction" CurrentTransactions="CurrentTransactions" />
    </div>
    @if (Transaction.Reimburses is not null)
    {
        <div class="reimbused-transaction">
            <TransactionRow Transaction="Transaction.Reimburses" CurrentTransactions="CurrentTransactions" />
        </div>
    }
</div>