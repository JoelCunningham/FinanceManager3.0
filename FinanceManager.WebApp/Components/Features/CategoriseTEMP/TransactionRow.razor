@inject CategoryService CategoryService;

@code {
    [Parameter, EditorRequired]
    public required TransactionViewData Transaction { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<TransactionViewData> CurrentTransactions { get; set; }

    private IReadOnlyList<string> categories = [];

    private bool isModalOpen = false;

    protected override void OnInitialized()
    {
        categories = CategoryService.GetCategories().ToList();
    }

    private void OnDateChanged(ChangeEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(e.Value?.ToString()))
        {
            Transaction.ResetDate();
        }
        else
        {
            Transaction.Backdate(DateTime.Parse(e.Value!.ToString()!));
        }
    }

    private void OnDescriptionChanged(ChangeEventArgs e)
    {
        Transaction.Description = e.Value!.ToString()!;
    }

    private void OpenReimburseModal()
    {
        isModalOpen = true;
    }

    private void CloseReimburseModal()
    {
        isModalOpen = false;
    }

    private void OnImportedReimburseSelected(TransactionViewData selectedTransaction)
    {
        Transaction.SetReimburses(selectedTransaction);
    }

    private void OnExistingReimburseSelected(Transaction selectedTransaction)
    {
        Transaction.SetReimbursesExisting(selectedTransaction.Id);
    }
}

<div class="transaction-row">
    <div>
        <select class="form-control">
            <option value="" selected disabled hidden>Select a category</option>
            @foreach (var category in categories)
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>
    <div>@Transaction.Amount.ToString("C")</div>
    <div>
        <input type="date"
               class="form-control"
               value="@Transaction.Date.ToString("yyyy-MM-dd")"
               min="@Transaction.BankRecord.Date.ToString("yyyy-MM-dd")"
               max="@DateTime.Today.ToString("yyyy-MM-dd")"
               onchange="@OnDateChanged" />
    </div>
    <div>
        <input type="text"
               class="form-control"
               value="@Transaction.Description"
               onchange="@OnDescriptionChanged" />

    </div>
    <div>
        <button type="button"
                class="form-control"
                @onclick="OpenReimburseModal">
            @if (Transaction.Reimburses != null || Transaction.ReimbursesExistingTransactionId != null)
            {
                <text>Reimbursed</text> //TODO
            }
            else
            {
                <text>Reimburse</text>
            }
        </button>
    </div>
</div>

<ReimburseModal IsOpen="@isModalOpen"
                CurrentTransactions="@CurrentTransactions"
                OnClose="@CloseReimburseModal"
                OnSelectImported="@OnImportedReimburseSelected"
                OnSelectExisting="@OnExistingReimburseSelected" />
