@code {
    [Parameter] public IReadOnlyList<BudgetCategoryUsage> CategoryUsages { get; set; } = [];

    private decimal TotalSpending => CategoryUsages.Sum(c => c.Amount);
    private decimal GetAmountProportion(decimal amount) => TotalSpending == 0 ? 0 : amount / TotalSpending;

    private object GetChartOptions()
    {
        var options = new
        {
            tooltip = new { trigger = "item", formatter = "{b}: {d}%" },
            legend = new { orient = "vertical", right = "right", top = "center" },
            series = new[]
            {
                new
                {
                    name = "Spending",
                    type = "pie",
                    radius = new List<string>() { "40%", "70%" },
                    center = new List<string>() { "40%", "50%" },
                    data = CategoryUsages.Select(c => new { value = GetAmountProportion(c.Amount), name = c.CategoryName }),
                    label = new { show = false },
                    emphasis = new
                    {
                        itemStyle = new
                        {
                            shadowBlur = 10,
                            shadowOffsetX = 0,
                            shadowColor = "rgba(0, 0, 0, 0.5)"
                        }
                    }
                }
            }
        };
        return options;
    }
}

<div class="card">
    <h5 class="card-title>">Spending by group</h5>
    <div class="chart">
        <HxEChart Options="@GetChartOptions()" AutoResize="true" />
    </div>
</div>