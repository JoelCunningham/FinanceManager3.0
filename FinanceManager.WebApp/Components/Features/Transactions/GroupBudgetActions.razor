@using FinanceManager.WebApp.Components.Shared

@code
{
    [Parameter] public IReadOnlyList<DateTime> AvailableMonths { get; set; } = [];

    [Parameter] public DateTime Period { get; set; }
    [Parameter] public EventCallback<DateTime> PeriodChanged { get; set; }

    [Parameter] public TransactionsGraphMode Mode { get; set; }
    [Parameter] public EventCallback<TransactionsGraphMode> ModeChanged { get; set; }

    [Parameter] public bool IsGroupLevel { get; set; }

    [Parameter] public Func<Task> ResetLevelAsync { get; set; } = () => Task.CompletedTask;

    [Parameter] public Func<Task> ReloadAsync { get; set; } = () => Task.CompletedTask;

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income
    ];

    private async Task OnPeriodChangedAsync(DateTime period)
    {
        await PeriodChanged.InvokeAsync(period);
        await ReloadAsync();
    }

    private async Task OnModeChangedAsync(TransactionsGraphMode mode)
    {
        await ModeChanged.InvokeAsync(mode);
        await ReloadAsync();
    }
}

<div class="graph-actions">
    <MonthSelect AvailableMonths="AvailableMonths"
                 Value="Period"
                 ValueChanged="OnPeriodChangedAsync"
                 MonthLabel="Month"
                 YearLabel="Year" />

    <HxSelect Label="Mode"
              Value="Mode"
              ValueChanged="OnModeChangedAsync"
              ValueExpression="() => Mode"
              Data="SupportedModes"
              TItem="TransactionsGraphMode"
              TValue="TransactionsGraphMode"
              Nullable="false"
              AutoSort="false"
              Enabled="!IsGroupLevel"
              TextSelector="m => m.ToString()"
              ValueSelector="m => m" />

    @if (IsGroupLevel)
    {
        <div class="mt-2">
            <HxButton Text="Back to groups" Icon="BootstrapIcon.ArrowLeft" OnClick="ResetLevelAsync" />
        </div>
    }
</div>