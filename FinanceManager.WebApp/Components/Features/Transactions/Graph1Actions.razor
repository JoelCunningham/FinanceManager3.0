@code
{
    [Parameter, EditorRequired] public ChartModel Chart { get; set; } = default!;

    [Parameter] public IReadOnlyList<DateOnly> AvailableMonths { get; set; } = [];

    [Parameter] public DateOnly MonthFrom { get; set; }
    [Parameter] public EventCallback<DateOnly> MonthFromChanged { get; set; }

    [Parameter] public DateOnly MonthTo { get; set; }
    [Parameter] public EventCallback<DateOnly> MonthToChanged { get; set; }

    private static readonly TransactionsGraphMode[] GraphModes = Enum.GetValues<TransactionsGraphMode>();

    private async Task OnFromChangedAsync(DateOnly from)
    {
        await MonthFromChanged.InvokeAsync(from);
        await Chart.RefreshAsync();
    }

    private async Task OnToChangedAsync(DateOnly to)
    {
        await MonthToChanged.InvokeAsync(to);
        await Chart.RefreshAsync();
    }
}

<GraphActions Modes="GraphModes" Chart="Chart">
    <MonthSelectors>
        <MonthSelect AvailableMonths="AvailableMonths" Value="MonthFrom" ValueChanged="OnFromChangedAsync" MonthLabel="From month" YearLabel="From year" />
        <MonthSelect AvailableMonths="AvailableMonths" Value="MonthTo" ValueChanged="OnToChangedAsync" MonthLabel="To month" YearLabel="To year" />
    </MonthSelectors>
</GraphActions>