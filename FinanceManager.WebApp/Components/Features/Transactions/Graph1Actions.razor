@code
{
    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public ScopedPeriod Period { get; set; } = default!;
    [Parameter] public EventCallback<ScopedPeriod> PeriodChanged { get; set; }

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income,
        TransactionsGraphMode.Net
    ];

    private async Task OnPeriodChangedAsync(ScopedPeriod from)
    {
        await PeriodChanged.InvokeAsync(from);
        await Chart.RefreshAsync();
    }
}

<GraphActions Modes="SupportedModes" Chart="Chart">
    <Actions>
        <MonthSelect Value="Period" ValueChanged="OnPeriodChangedAsync" MonthLabel="From month" YearLabel="From year" ChangeLength />
        <MonthSelect Value="Period" ValueChanged="OnPeriodChangedAsync" MonthLabel="To month" YearLabel="To year" ChangeEndDate ChangeLength />
    </Actions>
</GraphActions>