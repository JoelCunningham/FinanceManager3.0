@code {
    [Parameter] public TransactionSummary EditTransaction { get; set; } = default!;

    [Parameter] public IReadOnlyList<CategorySummary> Categories { get; set; } = [];
    [Parameter] public ValidationModel Validation { get; set; } = default!;

    [Parameter] public EventCallback<CategorySummary?> SetCategory { get; set; }
    [Parameter] public EventCallback<decimal> SetAmount { get; set; }
    [Parameter] public EventCallback<DateTime> SetDate { get; set; }

    [Parameter] public EventCallback Save { get; set; }

    private HxModal _modal = default!;

    private bool HasCategoryError => Validation.GetValidationItemIds(ValidationField.Category).Contains(EditTransaction.TransactionId);
    private bool HasAmountError => Validation.GetValidationItemIds(ValidationField.Amount).Contains(EditTransaction.TransactionId);
    private bool HasDateError => Validation.GetValidationItemIds(ValidationField.Date).Contains(EditTransaction.TransactionId);

    private decimal? MinAmount => EditTransaction.Record.Amount < 0 ? EditTransaction.Record.Amount : 0;
    private decimal? MaxAmount => EditTransaction.Record.Amount > 0 ? EditTransaction.Record.Amount : 0;

    public async Task ShowAsync() => await _modal.ShowAsync();
    public async Task HideAsync() => await _modal.HideAsync();
}

<div class="transaction-modal">
    <HxModal @ref="_modal" Title="Edit activity" Size="ModalSize.Large">
            <BodyTemplate>
        @if (EditTransaction is not null)
        {
                <div class="transaction-form">
                    <CategoryInput Value="EditTransaction.Category" ValueChanged="SetCategory" Label="Category" Data="Categories" HasError="HasCategoryError" />
                    <HxInputText Label="Hidden" @bind-Value="EditTransaction.Description" CssClass="invisible" />
                    <HxInputDate Label="Date" @bind-Value="EditTransaction.Date" MaxDate="EditTransaction.Record.Date" CalendarIcon="BootstrapIcon.Calendar" InputCssClass="@(HasDateError ? "is-invalid" : string.Empty)" />
                    <HxInputNumber Label="Amount" @bind-Value="EditTransaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" step="0.01" min="@MinAmount" max="@MaxAmount" InputCssClass="@(HasAmountError ? "is-invalid" : string.Empty)" Enabled="false" />
                    <HxInputTextArea Label="Description" @bind-Value="EditTransaction.Description" CssClass="full-width" />
                </div>
        }
            </BodyTemplate>
        <FooterTemplate>
            <HxButton Color="ThemeColor.Secondary" OnClick="HideAsync">Cancel</HxButton>
            <HxButton Color="ThemeColor.Info" OnClick="() => { }">Split & Reimburse</HxButton>
            <HxButton Color="ThemeColor.Primary" OnClick="Save">Save</HxButton>
        </FooterTemplate>
    </HxModal>
</div>
