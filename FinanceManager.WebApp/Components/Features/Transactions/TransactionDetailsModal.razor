@inherits ModalBase

@code {
    [Parameter] public TransactionDetails Details { get; set; } = default!;

    [Parameter] public EventCallback<TransactionSummary> OnEdit { get; set; }

    private DataGridModel<FilterQuery, TransactionSummary> Data = default!;

    protected override void OnParametersSet()
    {
        if (Details is null) return;
        var pagedResult = new PagedResult<TransactionSummary>
        {
            Items = Details.Reimbursements.ToList(),
            TotalItems = Details.Reimbursements.Count(),
        };
        Data = new()
        {
            GetDataFunc = (_) => Task.FromResult(pagedResult)
        };
    }
}

<div class="transaction-modal">
    <HxModal @ref="_modal" Title="Activity details" Size="ModalSize.Large">
        <BodyTemplate>
            <HxTabPanel>
                <HxTab Title="Activity details">
                    <Content>
                        <HxFormState Enabled="false">
                            <HxInputText Label="Category" Value="@CategoryUtilities.GetCategoryFullName(Details.TransactionSummary)" ValueExpression="@(() => Details.TransactionSummary.Description)" />
                            <HxInputText Label="Category" Value="@CategoryUtilities.GetCategoryFullName(Details.TransactionSummary)" ValueExpression="@(() => Details.TransactionSummary.Description)" CssClass="invisible" />
                            <HxInputDate Label="Date" Value="@Details.TransactionSummary.Date" ValueExpression="@(() => Details.TransactionSummary.Date)" CalendarIcon="BootstrapIcon.Calendar" />
                            <HxInputNumber Label="Amount" Value="@Details.TransactionSummary.Amount" ValueExpression="@(() => Details.TransactionSummary.Amount)" InputGroupStartText="$" Decimals="2" />
                            <HxInputTextArea Label="Description" Value="@Details.TransactionSummary.Description" ValueExpression="@(() => Details.TransactionSummary.Description)" CssClass="full-width" />
                        </HxFormState>
                    </Content>
                </HxTab>
                <HxTab Title="Reimbursements" ContentCssClass="reimbursements-tab">
                    <Content>
                        @if (Details.Reimbursements.Count() == 0)
                        {
                            <Alert Level="AlertLevel.Info">This activity has no associated reimbursements. Edit the activity to add reimbursements.</Alert>
                        }
                        else
                        {
                            <ListLayout TItem="TransactionSummary" Data="Data">
                                <FilterTemplate Context="query">
                                    <HxInputText Label="Search" @bind-Value="query.SearchTerm" />
                                </FilterTemplate>
                                <DataTemplate>
                                    <HxGrid @ref="Data.Grid" DataProvider="Data.GetGridData" TItem="TransactionSummary" PageSize="Data.Query.PageSize" PreserveSelection="false" Responsive="false">
                                        <Columns>
                                            <HxGridColumn HeaderText="Date" SortString="Date" SortKeySelector="@(t => t.Date)" ItemTextSelector="@(t => t.Date.ToShortDateString())" />
                                            <HxGridColumn HeaderText="Description" ItemCssClass="text-truncate fluid-truncate-col">
                                                <ItemTemplate Context="reimbursement"><span title="@reimbursement.Description">@reimbursement.Description</span></ItemTemplate>
                                            </HxGridColumn>
                                            <HxGridColumn HeaderText="Amount" SortString="Amount" SortKeySelector="@(t => t.Amount)" ItemTextSelector="@(t => t.Amount.ToString("C"))" HeaderCssClass="text-end" ItemCssClass="text-end" />
                                        </Columns>
                                    </HxGrid>
                                </DataTemplate>
                            </ListLayout>
                        }
                    </Content>
                </HxTab>
                <HxTab Title="Bank record">
                    <Content>
                        <HxFormState Enabled="false">
                            <HxInputText Label="Bank" Value="@Details.RecordSummary.Bank" ValueExpression="@(() => Details.RecordSummary.Bank)" />
                            <HxInputText Label="Account" Value="@Details.RecordSummary.AccountNumber" ValueExpression="@(() => Details.RecordSummary.AccountNumber)" />

                            <HxInputDate Label="Date" Value="@Details.RecordSummary.Date" ValueExpression="@(() => Details.RecordSummary.Date)" CalendarIcon="BootstrapIcon.Calendar" />
                            <HxInputNumber Label="Amount" Value="@Details.RecordSummary.Amount" ValueExpression="@(() => Details.RecordSummary.Amount)" InputGroupStartText="$" Decimals="2" />

                            <HxInputText Label="Type" Value="@Details.RecordSummary.Type" ValueExpression="@(() => Details.RecordSummary.Type)" />
                            <HxInputText Label="Reference" Value="@Details.RecordSummary.Reference" ValueExpression="@(() => Details.RecordSummary.Reference)" />
                            <HxInputTextArea Label="Narrative" Value="@Details.RecordSummary.Description" ValueExpression="@(() => Details.RecordSummary.Description)" CssClass="full-width" />

                            @if (Details.Siblings.Count() > 0)
                            {
                                <div class="siblings-details">
                                    <p>
                                        This record is also the base for @Details.Siblings.Count() other @LanguageUtilities.Pluralise("activities", Details.Siblings.Count()).
                                        You can manage this by editing the activity.
                                    </p>
                                </div>
                            }
                        </HxFormState>
                    </Content>
                </HxTab>
            </HxTabPanel>
        </BodyTemplate>
        <FooterTemplate>
            <HxButton Color="ThemeColor.Secondary" OnClick="HideAsync">Return</HxButton>
            <HxButton Color="ThemeColor.Primary" OnClick="() => OnEdit.InvokeAsync(Details.TransactionSummary)">Edit</HxButton>
        </FooterTemplate>
    </HxModal>
</div>
