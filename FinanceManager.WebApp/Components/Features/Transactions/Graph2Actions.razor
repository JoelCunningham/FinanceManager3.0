@code
{
    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public ScopedPeriod Period { get; set; } = default!;
    [Parameter] public EventCallback<ScopedPeriod> PeriodChanged { get; set; }

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income
    ];

    private static readonly BudgetScope[] SupportedScopes =
    [
        BudgetScope.Weekly,
        BudgetScope.Fortnightly,
        BudgetScope.Monthly
    ];

    private async Task OnPeriodChangedAsync(ScopedPeriod period)
    {
        await PeriodChanged.InvokeAsync(period);
        await Chart.RefreshAsync();
    }

    private async Task OnScopeChangedAsync(BudgetScope scope)
    {
        var newPeriod = new ScopedPeriod(scope, Chart.Period.StartDate, Chart.Period.Length);

        Chart.Period = newPeriod;
        await PeriodChanged.InvokeAsync(newPeriod);

        await Chart.RefreshAsync();
    }
}

<GraphActions Modes="SupportedModes" Chart="Chart">
    <Actions>
        <HxSelect Label="Scope"
                  Value="Chart.Period.Scope"
                  ValueChanged="OnScopeChangedAsync"
                  ValueExpression="() => Chart.Period.Scope"
                  Data="SupportedScopes"
                  TItem="BudgetScope"
                  TValue="BudgetScope"
                  Nullable="false"
                  AutoSort="false"
                  Enabled="!Chart.IsCategoryLevel"
                  TextSelector="s => s.ToString()"
                  ValueSelector="s => s" />

        @if (Chart.Period.Scope == BudgetScope.Monthly)
        {
            <MonthSelect Value="Chart.Period" ValueChanged="OnPeriodChangedAsync" />
        }
        else if (Chart.Period.Scope == BudgetScope.Weekly)
        {
            <WeekSelect Value="Chart.Period" ValueChanged="OnPeriodChangedAsync" />
        }
        else if (Chart.Period.Scope == BudgetScope.Fortnightly)
        {
            <FortnightSelect Value="Chart.Period" ValueChanged="OnPeriodChangedAsync" />
        }
    </Actions>
</GraphActions>