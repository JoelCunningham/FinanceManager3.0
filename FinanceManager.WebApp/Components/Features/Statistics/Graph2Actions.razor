@code
{
    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);

    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public ScopedRange Range { get; set; } = default!;
    [Parameter] public EventCallback<ScopedRange> RangeChanged { get; set; }

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income
    ];

    private async Task OnRangeChangedAsync(ScopedRange range)
    {
        Chart.Range = range;
        await RangeChanged.InvokeAsync(range);
        await Chart.RefreshAsync();
    }

    private async Task OnPreviousAsync()
    {
        var previousStart = ScopeHelper.GetPeriodStart(Chart.Range.Scope, Chart.Range.StartDate, -Chart.Range.Length);
        await OnRangeChangedAsync(new ScopedRange(Chart.Range.Scope, previousStart, Chart.Range.Length));
    }

    private async Task OnTodayAsync()
    {
        await OnRangeChangedAsync(new ScopedRange(Chart.Range.Scope, Today, Chart.Range.Length));
    }

    private async Task OnNextAsync()
    {
        var nextStart = ScopeHelper.GetPeriodStart(Chart.Range.Scope, Chart.Range.StartDate, Chart.Range.Length);
        await OnRangeChangedAsync(new ScopedRange(Chart.Range.Scope, nextStart, Chart.Range.Length));
    }

    private async Task OnResetAsync()
    {
        await OnRangeChangedAsync(Chart.InitialRange);
    }
}

<GraphActions Modes="SupportedModes" Chart="Chart" OnPreviousRange="OnPreviousAsync" OnToday="OnTodayAsync" OnNextRange="OnNextAsync" OnReset="OnResetAsync">
    <Dropdowns>
        @if (Chart.Range.Scope == BudgetScope.Monthly)
        {
            <MonthSelect Value="Chart.Range" ValueChanged="OnRangeChangedAsync" />
        }
        else if (Chart.Range.Scope == BudgetScope.Weekly)
        {
            <WeekSelect Value="Chart.Range" ValueChanged="OnRangeChangedAsync" />
        }
        else if (Chart.Range.Scope == BudgetScope.Fortnightly)
        {
            <FortnightSelect Value="Chart.Range" ValueChanged="OnRangeChangedAsync" />
        }
    </Dropdowns>
</GraphActions>