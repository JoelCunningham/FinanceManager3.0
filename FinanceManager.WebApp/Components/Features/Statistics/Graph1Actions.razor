@code
{
    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public ScopedRange Range { get; set; } = default!;
    [Parameter] public EventCallback<ScopedRange> RangeChanged { get; set; }

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income,
        TransactionsGraphMode.Net
    ];

    private async Task OnRangeChangedAsync(ScopedRange from)
    {
        await RangeChanged.InvokeAsync(from);
        await Chart.RefreshAsync();
    }
}

<GraphActions Modes="SupportedModes" Chart="Chart">
    <Actions>
        <MonthSelect Value="Range" ValueChanged="OnRangeChangedAsync" MonthLabel="From month" YearLabel="From year" ChangeLength />
        <MonthSelect Value="Range" ValueChanged="OnRangeChangedAsync" MonthLabel="To month" YearLabel="To year" ChangeEndDate ChangeLength />
    </Actions>
</GraphActions>