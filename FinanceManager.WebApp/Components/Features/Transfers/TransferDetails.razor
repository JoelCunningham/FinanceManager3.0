@code {
    [Parameter] public TransferSummary Transfer { get; set; } = default!;

    private string? Source;

    protected override void OnInitialized()
    {
        Source = Transfer.IsUserCreated ? "User created" : "Automatically created";
    }
}

<div class="row">
    <HxFormState Enabled="false">
        <div class="col-md-6">
            <HxInputText Label="From Bank" @bind-Value="Transfer.From.Bank" />
        </div>
        <div class="col-md-6">
            <HxInputText Label="To Bank" @bind-Value="Transfer.To.Bank" />
        </div>
        <div class="col-md-6">
            <HxInputText Label="From Account" @bind-Value="Transfer.From.Account" />
        </div>
        <div class="col-md-6">
            <HxInputText Label="To Account" @bind-Value="Transfer.To.Account" />
        </div>
        <div class="col-md-6">
            <HxInputDate Label="Date" @bind-Value="@Transfer.Date" CalendarIcon="BootstrapIcon.Calendar" />
        </div>
        <div class="col-md-6">
            <HxInputNumber Label="Amount" @bind-Value="@Transfer.Amount" InputGroupStartText="$" Decimals="2" />
        </div>
        <div class="col-md-6">
            <HxInputText Label="Source" @bind-Value="Source" />
        </div>
        <div class="col-12">
            <HxInputTextArea Label="Description" @bind-Value="@Transfer.Description"/>
        </div>
    </HxFormState>
</div>