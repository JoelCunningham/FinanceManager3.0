@code {
    [Parameter, EditorRequired]
    public required TransactionFilters Filters { get; set; }

    [Parameter]
    public List<string> Accounts { get; set; } = [];

    [Parameter]
    public decimal MaxAmount { get; set; }

    [Parameter]
    public EventCallback OnFilterChanged { get; set; }

    private List<TransactionSort> AvailableSorts = new List<TransactionSort>
    {
        TransactionSort.Date,
        TransactionSort.Amount,
        TransactionSort.FromAccount,
        TransactionSort.ToAccount
    };

    private async Task OnChange()
    {
        await OnFilterChanged.InvokeAsync();
    }
}

<FilterPanel Filters="Filters" OnChange="OnChange">
    <OuterContent>
        <SearchInput @bind-SearchTerm="Filters.SearchTerm" Placeholder="Search transfers..." @bind-SearchTerm:after="OnChange" />
        <SortControls @bind-SortBy="Filters.SortBy" @bind-SortDescending="Filters.SortDescending" AvailableSorts="AvailableSorts" @bind-SortBy:after="OnChange" @bind-SortDescending:after="OnChange" />
    </OuterContent>
    <InnerContent>
        <AccountSelect @bind-AccountFrom="Filters.FilterAccountFrom" @bind-AccountTo="Filters.FilterAccountTo" Accounts="Accounts" @bind-AccountFrom:after="OnChange" @bind-AccountTo:after="OnChange" />
        <DateRangeInput @bind-DateFrom="Filters.FilterDateFrom" @bind-DateTo="Filters.FilterDateTo" @bind-DateFrom:after="OnChange" @bind-DateTo:after="OnChange" />
        <AmountRangeInput @bind-AmountMin="Filters.FilterAmountMin" @bind-AmountMax="Filters.FilterAmountMax" @bind-AmountMin:after="OnChange" @bind-AmountMax:after="OnChange" />
        <SourceSelect @bind-SelectedSource="Filters.FilterBySource" @bind-SelectedSource:after="OnChange" />
    </InnerContent>
</FilterPanel>