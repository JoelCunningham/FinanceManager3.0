@code {
    [Parameter, EditorRequired]
    public required TransactionFilters Filters { get; set; }

    [Parameter]
    public List<string> Accounts { get; set; } = [];

    [Parameter]
    public decimal MaxAmount { get; set; }

    [Parameter]
    public EventCallback OnFilterChanged { get; set; }

    private List<TransactionSort> AvailableSorts = new List<TransactionSort>
    {
        TransactionSort.Date,
        TransactionSort.Amount,
        TransactionSort.FromAccount,
        TransactionSort.ToAccount
    };

    private async Task OnChange()
    {
        await OnFilterChanged.InvokeAsync();
    }
}

<FilterPanel Filters="Filters" OnChange="OnChange">
    <OuterContent>
        <SearchInput Placeholder="Search transfers..."
                     @bind-SearchTerm="Filters.SearchTerm"
                     @bind-SearchTerm:after="OnChange" />
        <SortControls InculdeAccountSorts="true"
                      @bind-SortBy="Filters.SortBy"
                      @bind-SortBy:after="OnChange"
                      @bind-SortDescending="Filters.SortDescending"
                      @bind-SortDescending:after="OnChange" />
    </OuterContent>
    <InnerContent>
        <AccountSelect Accounts="Accounts"
                       @bind-AccountFrom="Filters.FilterAccountFrom"
                       @bind-AccountTo="Filters.FilterAccountTo"
                       @bind-AccountFrom:after="OnChange"
                       @bind-AccountTo:after="OnChange" />
        <DateRangeInput MaxDate="DateTime.Today"
                        @bind-DateFrom="Filters.FilterDateFrom"
                        @bind-DateFrom:after="OnChange"
                        @bind-DateTo="Filters.FilterDateTo"
                        @bind-DateTo:after="OnChange" />
        <AmountRangeInput @bind-AmountMin="Filters.FilterAmountMin"
                          @bind-AmountMax="Filters.FilterAmountMax"
                          @bind-AmountMin:after="OnChange"
                          @bind-AmountMax:after="OnChange" />
        <SourceSelect @bind-SelectedSource="Filters.FilterBySource"
                      @bind-SelectedSource:after="OnChange" />
    </InnerContent>
</FilterPanel>