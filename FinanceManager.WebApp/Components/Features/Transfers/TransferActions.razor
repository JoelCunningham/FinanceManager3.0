@using FinanceManager.Application.DTOs

@code {
    [Parameter] public FilterQuery Query { get; set; } = new();

    [Parameter] public List<string> Accounts { get; set; } = [];

    [Parameter] public EventCallback OnFilterCleared { get; set; }

    [Parameter] public EventCallback<FilterQuery> OnFilterChanged { get; set; }

    private List<TransactionSortBy> AvailableSorts = new List<TransactionSortBy>
    {
        TransactionSortBy.Date,
        TransactionSortBy.Amount,
        TransactionSortBy.FromAccount,
        TransactionSortBy.ToAccount
    };

    private async Task OnChange()
    {
        await OnFilterChanged.InvokeAsync();
    }
}

<NewFilterPanel Filters="Query" OnClear="OnFilterCleared">
    <OuterContent>
        <SearchInput Placeholder="Search transfers..."
                     @bind-SearchTerm="Query.SearchTerm"
                     @bind-SearchTerm:after="OnChange" />
        <SortControls InculdeAccountSorts="true"
                      @bind-SortBy="Query.SortBy"
                      @bind-SortBy:after="OnChange"
                      @bind-SortDescending="Query.SortDescending"
                      @bind-SortDescending:after="OnChange" />
    </OuterContent>
    <InnerContent>
        <AccountSelect Accounts="Accounts"
                       @bind-AccountFrom="Query.FilterAccountFrom"
                       @bind-AccountTo="Query.FilterAccountTo"
                       @bind-AccountFrom:after="OnChange"
                       @bind-AccountTo:after="OnChange" />
        <DateRangeInput MaxDate="DateTime.Today"
                        @bind-DateFrom="Query.FilterDateFrom"
                        @bind-DateFrom:after="OnChange"
                        @bind-DateTo="Query.FilterDateTo"
                        @bind-DateTo:after="OnChange" />
        <AmountRangeInput @bind-AmountMin="Query.FilterAmountMin"
                          @bind-AmountMax="Query.FilterAmountMax"
                          @bind-AmountMin:after="OnChange"
                          @bind-AmountMax:after="OnChange" />
        <SourceSelect @bind-SelectedSource="Query.FilterBySource"
                      @bind-SelectedSource:after="OnChange" />
    </InnerContent>
</NewFilterPanel>