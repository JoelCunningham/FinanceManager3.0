@code {
    [Parameter, EditorRequired]
    public required TransferSummary Transfer { get; set; }

    [Parameter]
    public EventCallback<TransferSummary> OnRemove { get; set; }

    private bool IsDetailsOpen = false;

    private void Remove()
    {
        OnRemove.InvokeAsync(Transfer);
        IsDetailsOpen = false;
    }

    private string GetBankLogoPath(string bankName)
    {
        return $"/images/banks/{bankName.ToLowerInvariant().Replace(" ", "-")}.svg";
    }
}

<div class="transfer-row" @onclick="() => IsDetailsOpen = true">
    @if (Transfer.IsUserCreated)
    {
        <Icon Name="hand-index" AriaLabel="user created" title="User created transfer" />
    }
    else
    {
        <Icon Name="gear" AriaLabel="automatically created" title="Automatically created transfer" />
    }

    <div class="accounts">
        <img class="bank-logo" src="@GetBankLogoPath(Transfer.From.Bank)" alt="@Transfer.From.Bank logo" title="@Transfer.From.Account" />
        <Icon Name="arrow-right" AriaLabel="transferd to" />
        <img class="bank-logo" src="@GetBankLogoPath(Transfer.To.Bank)" alt="@Transfer.To.Bank logo" title="@Transfer.To.Account" />
    </div>

    <div>@Transfer.Date.ToShortDateString()</div>

    <div class="description">@Transfer.Description</div>

    <div class="amount">@Transfer.Amount.ToString("C")</div>

    <button type="button" class="btn btn-primary btn-sm" @onclick="Remove" @onclick:stopPropagation="true">Seperate</button>
</div>

@if (IsDetailsOpen)
{
    <Modal Title="Transaction details" OnClose="() => IsDetailsOpen = false">
        <BodyContent>
            <TransferDetails Transfer="Transfer" />
        </BodyContent>
        <FooterContent>
            <button type="button" class="btn btn-primary" @onclick="Remove">Seperate</button>
            <button type="button" class="btn btn-secondary" @onclick="() => IsDetailsOpen = false">Return</button>
        </FooterContent>
    </Modal>
}