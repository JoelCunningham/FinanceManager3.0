@code {
    [Parameter] public CategoryGroupDetails Group { get; set; } = default!;

    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback OnCategoryCreate { get; set; }
    [Parameter] public EventCallback<CategoryPeriodDetails> OnCategoryEdit { get; set; }

    [Parameter] public EventCallback<CategoryPeriodDetails> OnShowTransactions { get; set; }

    [Parameter] public EventCallback<int> AdjustOffset { get; set; }

    private HxGrid<CategoryPeriodDetails>? Grid;
    private HashSet<CategoryPeriodDetails> SelectedCategories = [];

    private CategoryChart? Chart;

    private string PeriodText => LanguageUtilities.Capitalise(ScopeHelper.GetScopeDescription(Group.PeriodScope ?? BudgetScope.Monthly));
    private string PeriodDescription => Group.PeriodName;

    protected override async Task OnParametersSetAsync()
    {
        if (Grid is not null) await Grid.RefreshDataAsync();
        SelectedCategories = Group.Categories.ToHashSet();
    }

    private Task<GridDataProviderResult<CategoryPeriodDetails>> GetGridData(GridDataProviderRequest<CategoryPeriodDetails> request)
    {
        return Task.FromResult(request.ApplyTo(Group.Categories));
    }

    private Dictionary<string, object> GetRowAttributes(CategoryPeriodDetails item)
    {
        return new Dictionary<string, object>
        {
            { "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => ToggleSelectedCategory(item)) },
            { "style", "cursor: pointer;" }
        };
    }

    private void ToggleSelectedCategory(CategoryPeriodDetails category)
    {
        if (SelectedCategories.Contains(category)) SelectedCategories.Remove(category); else SelectedCategories.Add(category);
    }

    private string GetAmountColour(CategoryPeriodDetails category)
    {
        var amount = category.SignedPeriodTotal;
        var budget = category.PeriodBudget;
        if (budget == 0 && amount == 0) return "inherit";
        return ColourUtilities.GetAmountColour(Group.IsIncome ? amount - budget : budget - amount);
    }

    private async Task OnPrevious()
    {
        await AdjustOffset.InvokeAsync(-1);
        if (Chart is not null) await Chart.SetScope(Group.PeriodScope ?? BudgetScope.Monthly);
    }

    private async Task OnNext()
    {
        await AdjustOffset.InvokeAsync(1);
        if (Chart is not null) await Chart.SetScope(Group.PeriodScope ?? BudgetScope.Monthly);
    }

    private async Task OnToday()
    {
        await AdjustOffset.InvokeAsync(0);
        if (Chart is not null) await Chart.SetScope(Group.PeriodScope ?? BudgetScope.Monthly);
    }
}

<div class="category-group-panel">
    <CategoryActions OnEdit="OnEdit" OnClose="OnClose" OnCategoryCreate="OnCategoryCreate" />

    <CategoryHeader GroupName="@Group.Name" IsIncome="Group.IsIncome" Colour="@Group.Colour" Amount="@Group.Categories.Sum(c => c.SignedPeriodTotal)" Budget="Group.Categories.Sum(c => c.PeriodBudget)" PeriodText="@PeriodDescription" />

    <div class="header">
        <h4>Categories</h4>
        <RangeNav FixedText="@PeriodDescription" OnFixed="OnToday" OnNextRange="OnNext" OnPreviousRange="OnPrevious" />
    </div>

    <HxGrid @ref="Grid" TItem="CategoryPeriodDetails" DataProvider="GetGridData" @bind-SelectedDataItems="SelectedCategories" MultiSelectionEnabled="true" SelectionEnabled="false" Responsive="false" Hover="true" PreserveSelection="true" PageSize="20" ItemRowAdditionalAttributesSelector="GetRowAttributes">
        <Columns>
            <HxGridColumn HeaderCssClass="category-col" ItemCssClass="category-col">
                <ItemTemplate Context="category">
                    <span class="rounded-circle d-inline-block" style="background-color: @category.Colour" />
                </ItemTemplate>
            </HxGridColumn>
            <HxGridColumn HeaderText="Name" SortString="Name" SortKeySelector="@(c => c.Name)" ItemTextSelector="@(c => c.Name)" />
            <HxGridColumn HeaderText="Budget" SortString="PeriodBudget" SortKeySelector="@(c => c.PeriodBudget)" HeaderCssClass="text-end" ItemCssClass="text-end">
                <ItemTemplate Context="category">
                    <span>@category.PeriodBudget.ToString("C")</span>
                </ItemTemplate>
            </HxGridColumn>
            <HxGridColumn HeaderText="Actual" SortString="PeriodTotal" SortKeySelector="@(c => c.SignedPeriodTotal)" ItemCssClass="text-end" HeaderCssClass="text-end" IsDefaultSortColumn="true" SortDirection="SortDirection.Descending">
                <ItemTemplate Context="category">
                        <span style="@($"color: {GetAmountColour(category)};")">
                        @if (category.PeriodBudget != 0 || category.SignedPeriodTotal != 0)
                        {
                            <b>@category.SignedPeriodTotal.ToString("C")</b>
                        }
                        else
                        {
                            @category.SignedPeriodTotal.ToString("C")
                        }
                        </span>
                </ItemTemplate>
            </HxGridColumn>
            <HxContextMenuGridColumn Context="category" ItemCssClass="category-action-col">
                <HxContextMenu>
                    <HxContextMenuItem Text="View activities" OnClick="() => OnShowTransactions.InvokeAsync(category)" Icon="BootstrapIcon.List" />
                    <HxContextMenuItem Text="Edit" OnClick="() => OnCategoryEdit.InvokeAsync(category)" Icon="BootstrapIcon.PencilSquare" />
                </HxContextMenu>
            </HxContextMenuGridColumn>
        </Columns>
    </HxGrid>

    <h4 class="graph-title">Categories Graph</h4>
    <CategoryChart @ref="Chart" Group="Group" Categories="SelectedCategories" Length="6" Scope="Group.PeriodScope ?? BudgetScope.Monthly" />
</div>