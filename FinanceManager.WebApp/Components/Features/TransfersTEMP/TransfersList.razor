@using FinanceManager.WebApp.Models

@code {
    [Parameter, EditorRequired]
    public required TransfersPageModel Model { get; set; }

    private bool HasPendingTransfers => Model.DetectedTransfers.Count > 0;
    private bool HasResolvedTransfers => Model.AcceptedTransfers.Count > 0 || Model.RejectedTransfers.Count > 0;
}

<TransferListActions HasPendingTransfers="@HasPendingTransfers"
                     HasResolvedTransfers="@HasResolvedTransfers"
                     OnReset="@Model.Reset"
                     OnRejectAll="@Model.RejectRemainingTransfers"
                     OnAcceptAll="@Model.AcceptRemainingTransfers" />

@if (HasPendingTransfers)
{
    <TransfersHeader>
        @foreach (var transfer in Model.GroupedTransfers)
        {
            <TransferPairRow Transfer="transfer" AcceptTransfer="Model.AcceptTransfer" RejectTransfer="Model.RejectTransfer" />
        }
    </TransfersHeader>
}
else if (HasResolvedTransfers)
{
    <div class="alert alert-success" role="alert">
        All detected transfers have been resolved
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        No transfers were detcted in your upload
    </div>
}
