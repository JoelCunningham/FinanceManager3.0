@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public ReviewGroup TransactionGroup { get; set; } = default!;

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }

    [Parameter] public bool ShowActions { get; set; } = true;
}

<div class="transaction-group @(ShowActions ? "" : "actionless")">
    <div class="transaction-rows">
        @ChildContent
    </div>
    @if (ShowActions)
    {
        <div class="action-buttons">
            <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.ArrowCounterclockwise" OnClick="() => OnReset.InvokeAsync()" />
            <HxSubmit Color="ThemeColor.None" Icon="BootstrapIcon.CheckLg" OnClick="() => OnSave.InvokeAsync()" />
        </div>
    }
</div>