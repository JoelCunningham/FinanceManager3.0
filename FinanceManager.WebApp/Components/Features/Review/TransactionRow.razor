@code {
    [Parameter] public ReviewGroup TransactionGroup { get; set; } = default!;

    [Parameter] public IEnumerable<Category> Categories { get; set; } = [];

    [Parameter] public IEnumerable<Guid> ErrorCategoryIds { get; set; } = [];

    [Parameter] public IEnumerable<Guid> ErrorAmountIds { get; set; } = [];

    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public EventCallback<ReviewTransaction> OnFindReimbursement { get; set; }

    [Parameter] public EventCallback OnFindTransfer { get; set; }

    private ReviewTransaction? CurrentTransaction { get; set; }

    private void SetAmount(decimal value, ReviewTransaction transaction)
    {
        try
        {
            TransactionGroup.SetAmount(transaction, value);
        }
        catch
        {
            // TODO Maybe a warning?
        }
    }

    private void CategoryChanged(ReviewTransaction transaction)
    {
        transaction.AutoCategorised = false;
    }
}

<div class="transaction-group">
    @if (TransactionGroup.Transfers is not null)
    {
        <div class="transaction-rows">
            <div class="transactions-row">
                <span class="transaction-label">Transfers from</span>
                <HxInputDate @bind-Value="TransactionGroup.InitalTransaction.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false" />
                <HxInputText @bind-Value="TransactionGroup.InitalTransaction.Description" title="@TransactionGroup.InitalTransaction.Description" Enabled="false" />
                <HxInputNumber @bind-Value="TransactionGroup.InitalTransaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
            </div>

            <div class="transactions-row">
                <span class="transaction-label">To</span>
                <HxInputDate @bind-Value="TransactionGroup.Transfers.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false" />
                <HxInputText @bind-Value="TransactionGroup.Transfers.Description" title="@TransactionGroup.Transfers.Description" Enabled="false" />
                <HxInputNumber @bind-Value="TransactionGroup.Transfers.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
            </div>
        </div>
        <div class="action-buttons">
            <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.ArrowCounterclockwise" OnClick="TransactionGroup.Reset" />
            <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.CheckLg" OnClick="() => OnSave.InvokeAsync()" />
        </div>
    }
    else
    {
        <div class="transaction-rows">
            @foreach (var (transaction, index) in TransactionGroup.Transactions.Select((t, i) => (t, i)))
            {
                <div class="transactions-row">
                    <HxSelect @bind-Value="transaction.Category"
                              CssClass="@(transaction.AutoCategorised ? "auto-categorised" : "")"
                              Data="Categories"
                              NullText="Select category"
                              TextSelector="@(c => $"{c.Group.Name} - {c.Name}")"
                              ValueSelector="@(c => c)" />
                    <HxInputDate @bind-Value="transaction.Date" CalendarIcon="BootstrapIcon.Calendar" MaxDate="@TransactionGroup.InitalTransaction.Date" />
                    <HxInputText @bind-Value="transaction.Description" @bind-Value:event="oninput" title="@transaction.Description" />
                    @if (index == 0)
                    {
                        <HxInputNumber @bind-Value:get="transaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" step="0.01" Enabled="false" />
                    }
                    else
                    {
                        <HxInputNumber @bind-Value:get="transaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" step="0.01"
                                       min="@(TransactionGroup.InitalTransaction.Amount < 0 ? TransactionGroup.InitalTransaction.Amount : null)"
                                       max="@(TransactionGroup.InitalTransaction.Amount > 0 ? TransactionGroup.InitalTransaction.Amount : null)"
                                       @bind-Value:set="v => SetAmount(v, transaction)" />
                    }
                    <HxContextMenu>
                        <HxContextMenuItem OnClick="TransactionGroup.Split">Split</HxContextMenuItem>
                        @if (index != 0)
                        {
                            <HxContextMenuItem OnClick="() => TransactionGroup.Unsplit(transaction)">Unsplit</HxContextMenuItem>
                        }
                        <HxContextMenuItem OnClick="() => OnFindReimbursement.InvokeAsync(transaction)">Reimburse existing</HxContextMenuItem>
                        @if (TransactionGroup.Transactions.Count == 1)
                        {
                            <HxContextMenuItem OnClick="OnFindTransfer">Change to transfer</HxContextMenuItem>
                        }
                    </HxContextMenu>
                </div>
                @if (transaction.Reimburses is not null)
                {
                    <div class="transactions-row reimbursement-row">
                        <span class="transaction-label">Reimburses</span>
                        <HxInputDate @bind-Value="transaction.Reimburses.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false"/>
                        <HxInputText @bind-Value="transaction.Reimburses.Description" title="@transaction.Reimburses.Description" Enabled="false" />
                        <HxInputNumber @bind-Value="transaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
                        <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.XLg" OnClick="() => transaction.Reimburses = null" />
                    </div>
                }
            }
        </div>
        <div class="action-buttons">
            <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.ArrowCounterclockwise" OnClick="TransactionGroup.Reset" />
            <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.CheckLg" OnClick="() => OnSave.InvokeAsync()" />
        </div>
    }
</div>