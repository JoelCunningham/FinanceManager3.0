@code {
    [Parameter, EditorRequired]
    public required ReviewGroup TransactionGroup { get; set; }

    [Parameter]
    public IEnumerable<Category> Categories { get; set; } = [];

    [Parameter]
    public IEnumerable<Guid> ErrorCategoryIds { get; set; } = [];

    [Parameter]
    public IEnumerable<Guid> ErrorAmountIds { get; set; } = [];

    [Parameter]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public EventCallback<ReviewTransaction> OnFindReimbursement { get; set; }

    [Parameter]
    public EventCallback OnFindTransfer { get; set; }

    private ReviewTransaction? CurrentTransaction { get; set; }

    private void SetAmount(decimal value, ReviewTransaction transaction)
    {
        try
        {
            TransactionGroup.SetAmount(transaction, value);
        }
        catch
        {
            // TODO Maybe a warning?
        }
    }

    private void CategoryChanged(ReviewTransaction transaction)
    {
        transaction.AutoCategorised = false;
    }
}

<div class="transaction-group">
    @if (TransactionGroup.Transfers is not null)
    {
        <div class="transaction-rows">
            <div class="transactions-row">
                <span class="transaction-label">Transfers From</span>
                <input type="date" class="form-control disabled" @bind="TransactionGroup.InitalTransaction.Date" disabled />
                <input type="text" class="form-control disabled" @bind="TransactionGroup.InitalTransaction.Description" disabled />
                <input type="number" class="form-control disabled" @bind="TransactionGroup.InitalTransaction.Amount" disabled />
            </div>

            <div class="transactions-row">
                <span class="transaction-label">To</span>
                <input type="date" class="form-control disabled" @bind="TransactionGroup.Transfers.Date" disabled />
                <input type="text" class="form-control disabled" @bind="TransactionGroup.Transfers.Description" disabled />
                <input type="number" class="form-control disabled" @bind="TransactionGroup.Transfers.Amount" disabled />
            </div>
        </div>
        <div class="action-buttons">
            <button class="btn reset-button" type="button" @onclick="TransactionGroup.Reset" title="Reset">
                <Icon Name="arrow-counterclockwise" AriaLabel="Reset" />
            </button>
            <button class="btn save-button" type="button" @onclick="() => OnSave.InvokeAsync()" title="Save">
                <Icon Name="check-lg" AriaLabel="Reset" />
            </button>
        </div>
    }
    else
    {
        <div class="transaction-rows">
            @foreach (var (transaction, index) in TransactionGroup.Transactions.Select((t, i) => (t, i)))
            {
                <div class="transactions-row">
                    <CategoryInput Categories="Categories"
                                   HasError="ErrorCategoryIds.Contains(transaction.Id)"
                                   IsAutoCategorised="transaction.AutoCategorised"
                                   @bind-SelectedCategory="transaction.Category"
                                   @bind-SelectedCategory:after="() => CategoryChanged(transaction)" />
                    <input class="form-control"
                           type="date"
                           max="@TransactionGroup.InitalTransaction.Date.ToString("yyyy-MM-dd")"
                           @bind="transaction.Date"
                           @bind:format="yyyy-MM-dd" />
                    <input class="form-control"
                           type="text"
                           @bind="transaction.Description"
                           @bind:event="oninput" />
                    @if (index == 0)
                    {
                        <input class="form-control disabled"
                               type="number"
                               step="0.01"
                               @bind="transaction.Amount"
                               disabled />
                    }
                    else
                    {
                        <input class="@(ErrorAmountIds.Contains(transaction.Id) ? "form-control is-invalid" : "form-control")"
                               type="number"
                               step="0.01"
                               min="@(TransactionGroup.InitalTransaction.Amount < 0 ? TransactionGroup.InitalTransaction.Amount : null)"
                               max="@(TransactionGroup.InitalTransaction.Amount > 0 ? TransactionGroup.InitalTransaction.Amount : null)"
                               @bind:get="transaction.Amount"
                               @bind:set="v => SetAmount(v, transaction)" />
                    }
                    <TransactionActions IsInitial="index == 0"
                                        IsTransferable="TransactionGroup.Transactions.Count == 1"
                                        OnSplit="() => TransactionGroup.Split()"
                                        OnUnsplit="() => TransactionGroup.Unsplit(transaction)"
                                        OnReimburse="() => OnFindReimbursement.InvokeAsync(transaction)"
                                        OnTransfer="() => OnFindTransfer.InvokeAsync()" />
                </div>
                @if (transaction.Reimburses is not null)
                {
                    <div class="transactions-row reimbursement-row">
                        <span class="transaction-label">Reimburses</span>
                        <input type="date" class="form-control disabled" @bind="transaction.Reimburses.Date" disabled />
                        <input type="text" class="form-control disabled" @bind="transaction.Reimburses.Description" disabled />
                        <input type="number" class="form-control disabled" @bind="transaction.Reimburses.Amount" disabled />
                        <button class="btn btn-secondary" @onclick="() => transaction.Reimburses = null">Remove</button>
                    </div>
                }
            }
        </div>
        <div class="action-buttons">
            <button class="btn reset-button" type="button" @onclick="TransactionGroup.Reset" title="Reset">
                <Icon Name="arrow-counterclockwise" AriaLabel="Reset" />
            </button>
            <button class="btn save-button" type="button" @onclick="() => OnSave.InvokeAsync()" title="Save">
                <Icon Name="check-lg" AriaLabel="Reset" />
            </button>
        </div>
    }
</div>