@code {
    [Parameter]
    public bool IsInitial { get; set; }

    [Parameter]
    public bool IsTransferable { get; set; }

    [Parameter]
    public EventCallback OnSplit { get; set; }

    [Parameter]
    public EventCallback OnUnsplit { get; set; }

    [Parameter]
    public EventCallback OnReimburse { get; set; }

    [Parameter]
    public EventCallback OnTransfer { get; set; }
}

<div class="dropdown">
    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        Actions
    </button>
    <ul class="dropdown-menu">
        @if (IsInitial)
        {
            <li><button type="button" class="dropdown-item" @onclick="OnSplit">Split</button></li>
        }
        else
        {
            <li><button type="button" class="dropdown-item" @onclick="OnUnsplit">Unsplit</button></li>
        }
        <li><button type="button" class="dropdown-item" @onclick="OnReimburse">Reimburse existing</button></li>
        @if (IsTransferable)
        {
            <li><button type="button" class="dropdown-item" @onclick="OnTransfer">Change to transfer</button></li>
        }
    </ul>
</div>