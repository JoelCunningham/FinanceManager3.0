@code {
    [Parameter] public ReviewGroup TransactionGroup { get; set; } = default!;
    [Parameter] public IEnumerable<CategorySummary> Categories { get; set; } = [];

    [Parameter] public IEnumerable<Guid> ErrorCategoryIds { get; set; } = [];
    [Parameter] public IEnumerable<Guid> ErrorAmountIds { get; set; } = [];

    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public EventCallback<(ReviewTransaction, CategorySummary?)> OnCategoryChange { get; set; }
    [Parameter] public EventCallback<(ReviewTransaction, decimal)> OnAmountChange { get; set; }
    [Parameter] public EventCallback<(ReviewTransaction, DateTime)> OnDateChange { get; set; }

    [Parameter] public EventCallback<ReviewTransaction> OnFindReimbursement { get; set; }
    [Parameter] public EventCallback OnFindTransfer { get; set; }

    [Parameter] public bool IsReviewed { get; set; } = false;

    private ReviewTransaction? CurrentTransaction { get; set; }
}

@if (TransactionGroup.Transfers is not null)
{
    <ReviewRow TransactionGroup="TransactionGroup" OnSave="OnSave">
        <ReviewRowEntry Label="Transfers from">
            <HxInputDate @bind-Value="TransactionGroup.InitialTransaction.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false" />
            <HxInputText @bind-Value="TransactionGroup.InitialTransaction.Description" title="@TransactionGroup.InitialTransaction.Description" Enabled="false" />
            <HxInputNumber @bind-Value="TransactionGroup.InitialTransaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
        </ReviewRowEntry>
        <ReviewRowEntry Label="To">
            <HxInputDate @bind-Value="TransactionGroup.Transfers.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false" />
            <HxInputText @bind-Value="TransactionGroup.Transfers.Description" title="@TransactionGroup.Transfers.Description" Enabled="false" />
            <HxInputNumber @bind-Value="TransactionGroup.Transfers.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
        </ReviewRowEntry>
    </ReviewRow>
}
else
{
    <ReviewRow TransactionGroup="TransactionGroup" OnSave="OnSave" ShowActions="!IsReviewed">
        @foreach (var transaction in TransactionGroup.Transactions)
        {
            <ReviewRowEntry>
                @if (transaction.Reimburses is null)
                {
                    <CategoryInput @bind-Value:get="transaction.Category" @bind-Value:set="v => OnCategoryChange.InvokeAsync((transaction, v))" Data="Categories" IsAutoCategorised="transaction.IsAutoCategorised" HasError="ErrorCategoryIds.Contains(transaction.EntityId)" />
                } else {
                    <CategoryInput Value="transaction.Reimburses.Category" Enabled="false" Data="[transaction.Reimburses.Category]" />
                }
                <HxInputDate @bind-Value:get="transaction.Date" 
                             CalendarIcon="BootstrapIcon.Calendar" 
                             MaxDate="@TransactionGroup.InitialTransaction.Date"
                             @bind-Value:set="v => OnDateChange.InvokeAsync((transaction, v))" />
                <HxInputText @bind-Value="transaction.Description" @bind-Value:event="oninput" title="@transaction.Description" />
                @if (transaction.EntityId == TransactionGroup.InitialTransaction.Id)
                {
                    <HxInputNumber @bind-Value:get="transaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" step="0.01" Enabled="false" />
                }
                else
                {
                    <HxInputNumber @bind-Value:get="transaction.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" step="0.01"
                                   min="@(TransactionGroup.InitialTransaction.Amount < 0 ? TransactionGroup.InitialTransaction.Amount : null)"
                                   max="@(TransactionGroup.InitialTransaction.Amount > 0 ? TransactionGroup.InitialTransaction.Amount : null)"
                                   @bind-Value:set="v => OnAmountChange.InvokeAsync((transaction, v))" />
                }
                <HxContextMenu>
                    <HxContextMenuItem OnClick="TransactionGroup.Split">Split</HxContextMenuItem>
                    @if (transaction.EntityId != TransactionGroup.InitialTransaction.Id)
                    {
                        <HxContextMenuItem OnClick="() => TransactionGroup.Unsplit(transaction)">Unsplit</HxContextMenuItem>
                    }
                    @if (transaction.Amount > 0)
                    {
                        <HxContextMenuItem OnClick="() => OnFindReimbursement.InvokeAsync(transaction)">Reimburse existing</HxContextMenuItem>
                    }
                    @if (TransactionGroup.Transactions.Count == 1 && transaction.Reimbursements is null)
                    {
                        <HxContextMenuItem OnClick="OnFindTransfer">Change to transfer</HxContextMenuItem>
                    }
                </HxContextMenu>
            </ReviewRowEntry>
            @if (transaction.Reimburses is not null)
            {
                <ReviewRowEntry Label=" ↳ Reimburses">
                    <HxInputDate @bind-Value="transaction.Reimburses.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false" />
                    <HxInputText @bind-Value="transaction.Reimburses.Description" title="@transaction.Reimburses.Description" Enabled="false" />
                    <HxInputNumber @bind-Value="transaction.Reimburses.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
                    <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.XLg" OnClick="() => transaction.Reimburses = null" />
                </ReviewRowEntry>
            }
            @if (transaction.Reimbursements is not null)
            {
                foreach (var reimbursement in transaction.Reimbursements)
                {
                    <ReviewRowEntry Label=" ↳ Reimbursed by">
                        <HxInputDate @bind-Value="reimbursement.Date" CalendarIcon="BootstrapIcon.Calendar" Enabled="false" />
                        <HxInputText @bind-Value="reimbursement.Description" title="@reimbursement.Description" Enabled="false" />
                        <HxInputNumber @bind-Value="reimbursement.Amount" Type="InputType.Number" InputGroupStartText="$" Decimals="2" Enabled="false" />
                        <HxButton Color="ThemeColor.None" Icon="BootstrapIcon.XLg" OnClick="() => transaction.Reimbursements = transaction.Reimbursements.Where(r => r != reimbursement)" />
                    </ReviewRowEntry>
                }
            }
        }
    </ReviewRow>
}