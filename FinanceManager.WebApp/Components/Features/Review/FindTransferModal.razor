@inherits ModalBase

@code {
    [Parameter] public DataGridModel<FilterQuery, TransactionSummary> TransferData { get; set; } = new();
    [Parameter] public IEnumerable<CategorySummary> Categories { get; set; } = [];

    [Parameter] public EventCallback<TransactionSummary> SetTransfer { get; set; }
}

<HxModal @ref="_modal" Title="Find transfer" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionsSearchGrid Data="TransferData" Categories="Categories" OnSelect="SetTransfer" IsTransferMode />
    </BodyTemplate>
</HxModal>