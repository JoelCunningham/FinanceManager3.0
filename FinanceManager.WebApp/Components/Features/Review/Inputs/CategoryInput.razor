@code {
    [Parameter] public CategorySummary? Value { get; set; }
    [Parameter] public EventCallback<CategorySummary?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<CategorySummary?>>? ValueExpression { get; set; }

    [Parameter] public IEnumerable<CategorySummary> Data { get; set; } = [];

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Nullable { get; set; } = false;
    [Parameter] public bool IsAutoCategorised { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public bool Enabled { get; set; } = true;

    private Expression<Func<CategorySummary?>> CurrentValueExpression => ValueExpression ?? (() => Value);

    private static readonly CategorySummary UncategorisedCategory = new() { Id = Guid.Empty, Name = "- Uncategorised -", Colour = "", GroupId = Guid.Empty, GroupName = string.Empty, GroupColour = "", IsIncome = true };

    private IEnumerable<CategorySummary> GroupedData()
    {
        var grouped = Data.GroupBy(c => c.GroupName).OrderBy(g => g.Key).SelectMany(g =>
        {
            var header = new CategorySummary { Id = Guid.Empty, Name = $"- {g.Key} -", Colour = "", GroupId = Guid.Empty, GroupName = string.Empty, GroupColour = "", IsIncome = true };
            return new[] { header }.Concat(g.OrderBy(c => c.Name));
        });

        return Nullable ? new[] { UncategorisedCategory }.Concat(grouped) : grouped;
    }
}

<div>
    @if (IsAutoCategorised)
    {
        <HxIcon Icon="BootstrapIcon.Stars" />
    }
    <HxSelect Value="Value"
        ValueChanged="(v) => ValueChanged.InvokeAsync(v)"
        ValueExpression="CurrentValueExpression"
        Label="@Label"
        CssClass="@(IsAutoCategorised ? "auto-categorised" : "")"
        InputCssClass="@(HasError ? "is-invalid" : "")"
        Data="GroupedData()"
        TItem="CategorySummary"
        TValue="CategorySummary"
        Nullable="Nullable"
        AutoSort="false"
        Enabled="Enabled"
        NullText="@(Nullable ? "- Any -" : "Select category")"
        TextSelector="@(c => c.Name)"
        ValueSelector="@(c => c)"
        ItemDisabledSelector="@(c => c.Id == Guid.Empty && c.Name != "- Uncategorised -")">
    </HxSelect>
</div>