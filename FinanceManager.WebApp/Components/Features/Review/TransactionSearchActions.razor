@using FinanceManager.Application.DTOs
@using FinanceManager.Domain.Entities

@code {
    [Parameter] public FilterQuery Filters { get; set; } = new();

    [Parameter] public List<Category> Categories { get; set; } = [];

    [Parameter] public EventCallback OnFilterCleared { get; set; }

    [Parameter] public EventCallback<FilterQuery> OnFilterChanged { get; set; }

    [Parameter] public bool IsTransferSearch { get; set; } = true;

    private List<TransactionSortBy> AvailableSorts = new List<TransactionSortBy>
    {
        TransactionSortBy.Date,
        TransactionSortBy.Amount,
    };

    private async Task OnChange()
    {
        await OnFilterChanged.InvokeAsync();
    }
}

<FilterPanel Filters="Filters">
    <OuterContent>
        <SearchInput Placeholder="Search transactions..."
                     @bind-SearchTerm="Filters.SearchTerm"
                     @bind-SearchTerm:after="OnChange" />
        <SortControls InculdeAccountSorts="false"
                      @bind-SortBy="Filters.SortBy"
                      @bind-SortBy:after="OnChange"
                      @bind-SortDescending="Filters.SortDescending"
                      @bind-SortDescending:after="OnChange" />
    </OuterContent>
    <InnerContent>
        <DateRangeInput MaxDate="DateTime.Today"
                        @bind-DateFrom="Filters.FilterDateFrom"
                        @bind-DateFrom:after="OnChange"
                        @bind-DateTo="Filters.FilterDateTo"
                        @bind-DateTo:after="OnChange" />
        @if (IsTransferSearch)
        {
            <AmountRangeInput @bind-AmountMin="Filters.FilterAmountMin"
                              @bind-AmountMax="Filters.FilterAmountMax"
                              @bind-AmountMin:after="OnChange"
                              @bind-AmountMax:after="OnChange" />
            <CategorySelect Categories="Categories"
                            HasError="false"
                            @bind-SelectedCategory="Filters.FilterCategory"
                            @bind-SelectedCategory:after="OnChange" />
        }
    </InnerContent>
</FilterPanel>