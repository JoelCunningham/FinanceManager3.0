@code {
    [Parameter] public string SupportedExtensions { get; set; } = string.Empty;

    [Parameter] public string? ErrorMessage { get; set; }

    [Parameter] public bool HasSuccess { get; set; } = false;

    [Parameter] public EventCallback<IBrowserFile> OnFileUploaded { get; set; }

    private async Task OnFileSelected(IBrowserFile file)
    {
        await OnFileUploaded.InvokeAsync(file);
    }
}

<FileUploadInput Heading="Upload your transactions:"
                 AcceptedExtensions="@SupportedExtensions"
                 ErrorMessage="@ErrorMessage"
                 HasSuccess="HasSuccess"
                 OnFileSelected="@OnFileSelected" />