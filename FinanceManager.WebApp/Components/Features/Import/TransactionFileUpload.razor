@code {
    [Parameter] public string SupportedExtensions { get; set; } = string.Empty;
    [Parameter] public ValidationModel ValidationModel { get; set; } = new();

    [Parameter] public EventCallback<IBrowserFile> OnFileUploaded { get; set; }

    private async Task OnChange(InputFileChangeEventArgs args)
    {
        if (args.File is not null) await OnFileUploaded.InvokeAsync(args.File);
    }
}

<div class="file-input">
    <HxInputFile Label="Upload your transactions:" Accept="@SupportedExtensions" OnChange="OnChange" InputCssClass="@ValidationModel.GetControlClass()" />
</div>