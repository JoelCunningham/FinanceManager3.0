@code {
    [Parameter, EditorRequired]
    public required string BankName { get; set; }

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private string LogoPath => $"/images/banks/{BankName.ToLowerInvariant().Replace(" ", "-")}.svg";

    private Task HandleClick() => OnSelect.InvokeAsync(BankName);

    private string CardCss => IsSelected ? "is-selected" : string.Empty;
}

<div class="bank-select-card">
    <Card Class="@CardCss">
        <BodyTemplate>
            <img class="bank-logo" src="@LogoPath" alt="@BankName logo" />
        </BodyTemplate>
    </Card>
</div>