@code {
    [Parameter] public IReadOnlyList<ParserSummary> AvailableParsers { get; set; } = [];

    [Parameter] public ParserSummary? SelectedBank { get; set; }

    [Parameter] public EventCallback<ParserSummary?> SelectedBankChanged { get; set; }

    private string GetBankLogoPath(string name) => $"/images/banks/{name.ToLower().Replace(" ", "-")}.svg";
}

<HxRadioButtonList Label="Select your bank:"
                   TItem="ParserSummary"
                   TValue="ParserSummary"
                   Data="AvailableParsers"
                   Value="SelectedBank"
                   ValueChanged="SelectedBankChanged"
                   ValueExpression="() => SelectedBank"
                   Color="ThemeColor.Primary"
                   Outline="true"
                   Inline="true"
                   RenderMode="RadioButtonListRenderMode.ToggleButtons"
                   ItemTextCssClass="me-2">
    <ItemTemplate Context="p">
        <div class="bank-select-content">
            <img class="bank-logo" src="@GetBankLogoPath(p.BankName)" />
            <span>@p.BankName</span>
        </div>
    </ItemTemplate>
</HxRadioButtonList>