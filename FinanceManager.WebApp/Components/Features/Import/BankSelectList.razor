@inject IJSRuntime JsRuntime
@inject TransactionParserService ParserService

@code {
    [Parameter]
    public ParserInfo? SelectedBank { get; set; }

    [Parameter]
    public bool HasProgress { get; set; }

    [Parameter]
    public EventCallback<ParserInfo> OnBankChange { get; set; }

    private IReadOnlyList<ParserInfo> availableParsers = [];

    protected override void OnInitialized()
    {
        availableParsers = ParserService.GetAvailableParsers();
    }

    private async Task OnBankSelected(string bankName)
    {
        bool confirmed = !HasProgress || await JsRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to change the selected bank? This will reset any progress made in the import process.");
        if (confirmed)
        {
            await OnBankChange.InvokeAsync(availableParsers?.FirstOrDefault(p => p.BankName == bankName));
        }
    }
}

@if (availableParsers.Count > 0)
{
    <h2 class="section-heading">Select your bank:</h2>
    <div class="bank-cards-container">
        @foreach (var bank in availableParsers)
        {
            var isSelected = SelectedBank?.BankName == bank.BankName;
            <BankSelectCard BankName="@bank.BankName" IsSelected="@isSelected" OnSelect="OnBankSelected" />
        }
    </div>
}
else
{
    <div class="alert alert-info" role="alert">No parsers are currently available.</div>
}