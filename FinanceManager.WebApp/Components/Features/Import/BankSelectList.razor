@inject ParserService ParserService

@code {
    [Parameter] public ParserSummary? SelectedBank { get; set; }

    [Parameter] public EventCallback<ParserSummary> OnBankChange { get; set; }

    private IReadOnlyList<ParserSummary> AvailableParsers = [];

    private string LogoPath(string bankName) => $"/images/banks/{bankName.ToLowerInvariant().Replace(" ", "-")}.svg";

    protected override void OnInitialized()
    {
        AvailableParsers = ParserService.GetAvailableParsers();
    }
}

@if (AvailableParsers.Count > 0)
{
    <h2 class="section-heading">Select your bank:</h2>
    <div class="bank-cards">
        @foreach (var bank in AvailableParsers)
        {
            var isSelected = SelectedBank?.BankName == bank.BankName;
            <Card Class="@(isSelected ? "selected" : "")" @onclick="() => OnBankChange.InvokeAsync(bank)">
                <BodyTemplate>
                    <img class="bank-logo" src="@LogoPath(bank.BankName)" alt="@bank.BankName logo" />
                </BodyTemplate>
            </Card>
        }
    </div>
}
else
{
    <div class="alert alert-info" role="alert">No parsers are currently available.</div>
}