@code {
    [Parameter] public IReadOnlyList<ParsedTransaction> Transactions { get; set; } = [];

    private int TransfersCount => Transactions.Count(t => t.IsInternalTransfer);
}

<div class="import-success">
    <HxIcon Icon="@BootstrapIcon.CheckCircle" CssClass="import-success-icon" />
    <span class="import-success-message">
        Successfully imported @Transactions.Count transaction@(Transactions.Count == 1 ? "" : "s");
        including @TransfersCount transfer@(TransfersCount == 1 ? "" : "s").
    </span>
</div>