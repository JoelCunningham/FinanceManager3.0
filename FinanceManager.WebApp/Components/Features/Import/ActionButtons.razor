@code {
    [Parameter] public EventCallback Reset { get; set; }

    [Parameter] public EventCallback ShowPreview { get; set; }

    [Parameter] public EventCallback ImportTransactions { get; set; }
}

<div class="ms-auto">
    <HxButton Color="ThemeColor.Secondary" OnClick="Reset">Cancel</HxButton>
    <HxButton Color="ThemeColor.Info" OnClick="ShowPreview">Preview</HxButton>
    <HxSubmit Color="ThemeColor.Primary" OnClick="ImportTransactions">Import</HxSubmit>
</div>