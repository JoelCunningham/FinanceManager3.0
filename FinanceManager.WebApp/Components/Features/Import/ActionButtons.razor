@code {
    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public EventCallback ShowPreview { get; set; }
    [Parameter] public EventCallback ImportTransactions { get; set; }
}

<div class="action-buttons">
    <HxButton CssClass="reset" OnClick="Reset">Cancel</HxButton>
    <HxButton CssClass="preview" OnClick="ShowPreview" Enabled="Active" Tooltip="@(Active ? "Preview transactions" : "Upload a file first")">Preview</HxButton>
    <HxSubmit CssClass="import" OnClick="ImportTransactions" Enabled="Active" Tooltip="@(Active ? "Import transactions" : "Upload a file first")">Import</HxSubmit>
</div>