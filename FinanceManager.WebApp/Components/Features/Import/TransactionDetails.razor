@using FinanceManager.WebApp.Models

@code {
    [Parameter, EditorRequired]
    public required BankRecord Transaction { get; set; }
}

<div class="transaction-details">
    <div class="details-grid">
        <div class="details-field">
            <label>Bank</label>
            <span>@Transaction.Bank</span>
        </div>
        
        <div class="details-field">
            <label>Account Number</label>
            <span>@Transaction.AccountNumber</span>
        </div>
        
        <div class="details-field">
            <label>Date</label>
            <span>@Transaction.Date.ToString("dd/MM/yyyy")</span>
        </div>

        <div class="details-field">
            <label>Amount</label>
            <span>@Transaction.Amount.ToString("C")</span>
        </div>
        
        <div class="details-field">
            <label>Type</label>
            <span>@Transaction.Type</span>
        </div>
        
        <div class="details-field">
            <label>Reference</label>
            <span>@Transaction.Reference</span>
        </div>
    </div>
    
    <div class="details-field full-width">
        <label>Description</label>
        <span>@Transaction.Description</span>
    </div>
</div>