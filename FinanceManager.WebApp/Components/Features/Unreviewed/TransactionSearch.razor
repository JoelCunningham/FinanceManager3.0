@inject CategoryService CategoryService;
@inject TransactionService TransactionService;

@code {
    [Parameter]
    public List<TransactionSummary> FilteredTransactions { get; set; } = [];

    [Parameter]
    public EventCallback<TransactionSummary> OnSelect { get; set; }
}

@if (FilteredTransactions.Count > 0)
{
    <div class="transaction-list">
        <div class="transaction-header">
            <div>Category</div>
            <div>Date</div>
            <div>Description</div>
            <div>Amount</div>
            <div>Account</div>
            <div></div>
        </div>
        @foreach (var transaction in FilteredTransactions)
        {
            <div class="transaction-item">
                <div>@(transaction.Category is not null ? transaction.Category : "Uncategorised")</div>
                <div>@transaction.Date.ToString("dd/MM/yyyy")</div>
                <div>@transaction.Description</div>
                <div>@transaction.Amount.ToString("C")</div>
                <div>
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => OnSelect.InvokeAsync(transaction)">
                        Select
                    </button>
                </div> @* //TODO change to on row click *@
            </div>
        }
    </div>
}
else
{
    <div class="text-muted text-center p-4">
        <text>No transactions found.</text>
    </div>
}