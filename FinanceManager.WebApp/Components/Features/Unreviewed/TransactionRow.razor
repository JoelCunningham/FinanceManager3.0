@code {
    [Parameter, EditorRequired]
    public required UnreviewedTransaction TransactionGroup { get; set; }

    [Parameter]
    public IEnumerable<Category> Categories { get; set; } = [];

    [Parameter]
    public EventCallback<InnerTransaction> OnFindReimbusement { get; set; }

    [Parameter]
    public EventCallback OnFindTransfer { get; set; }

    private InnerTransaction? CurrentTransaction { get; set; }

    private void SetAmount(decimal value, InnerTransaction transaction)
    {
        try
        {
            TransactionGroup.SetAmount(transaction, value);
        }
        catch
        {
            // TODO Maybe a warning?
        }
    }

    private void SetCategory(Guid? categoryId, InnerTransaction transaction)
    {
        if (categoryId is null) return;
        transaction.Category = Categories.FirstOrDefault(c => c.Id == categoryId);
    }
}

<div class="transaction-group">
    @if (TransactionGroup.Transfer is not null)
    {
        <div class="transaction-rows">
            <div class="transactions-row">
                <br />
                <input type="date" class="form-control disabled" @bind="TransactionGroup.DefaultTransaction.Date" disabled />
                <input type="text" class="form-control disabled" @bind="TransactionGroup.DefaultTransaction.Description" disabled />
                <input type="number" step="0.01" class="form-control disabled" @bind="TransactionGroup.DefaultTransaction.Amount" disabled />
            </div>
            <div class="transactions-row transfer-row">
                <span class="transaction-label">Transfers</span>
                <input type="date" class="form-control disabled" @bind="TransactionGroup.Transfer.Date" disabled />
                <input type="text" class="form-control disabled" @bind="TransactionGroup.Transfer.Description" disabled />
                <input type="number" step="0.01" class="form-control disabled" @bind="TransactionGroup.Transfer.Amount" disabled />
            </div>
        </div>
        <button class="btn btn-secondary" @onclick="TransactionGroup.Reset">Reset</button>
    }
    else
    {
        <div class="transaction-rows">
            @foreach (var (transaction, index) in TransactionGroup.InnerTransactions.Select((t, i) => (t, i)))
            {
                <div class="transactions-row">
                    <CategorySelect Categories="Categories" SelectedCategory="transaction.Category" OnChange="StateHasChanged" />
                    <input type="date" class="form-control" @bind="transaction.Date" @bind:format="yyyy-MM-dd" max="@TransactionGroup.Record.Date.ToString("yyyy-MM-dd")" />
                    <input type="text" class="form-control" @bind="transaction.Description" @bind:event="oninput" />
                    @if (index == 0)
                    {
                        <input type="number" step="0.01" class="form-control disabled" @bind="transaction.Amount" disabled />
                    }
                    else
                    {
                        <input type="number" step="0.01" class="form-control" @bind:get="transaction.Amount" @bind:set="v => SetAmount(v, transaction)" min="0" max="@TransactionGroup.Record.Amount" />
                    }
                    @if (index == 0)
                    {
                        <button class="btn btn-secondary" @onclick="() => TransactionGroup.Split()">Split</button>
                    }
                    else
                    {
                        <button class="btn btn-secondary" @onclick="() => TransactionGroup.Unsplit(transaction)">Unsplit</button>
                    }
                    <button class="btn btn-secondary" @onclick="() => OnFindReimbusement.InvokeAsync(transaction)">Reimburse</button>
                </div>
                @if (transaction.Reimbursement is not null)
                {
                    <div class="transactions-row reimbursement-row">
                        <span class="transaction-label">Reimburses</span>
                        <input type="date" class="form-control disabled" @bind="transaction.Reimbursement.Date" disabled />
                        <input type="text" class="form-control disabled" @bind="transaction.Reimbursement.Description" disabled />
                        <input type="number" class="form-control disabled" @bind="transaction.Reimbursement.Amount" disabled />
                        <button class="btn btn-secondary" @onclick="() => transaction.Reimbursement = null">Remove</button>
                    </div>
                }
            }
        </div>
        <div class="action-buttons">
            @if (TransactionGroup.InnerTransactions.Count() == 1)
            {
                <button class="btn btn-secondary" @onclick="() => OnFindTransfer.InvokeAsync()">Change to transfer</button>
            }
            else
            {
                <button class="btn btn-secondary disabled" disabled>Change to transfer</button>
            }
            <button class="btn btn-secondary" @onclick="TransactionGroup.Reset">Reset</button>
            <button class="btn btn-primary">Save</button>
        </div>
    }
</div>