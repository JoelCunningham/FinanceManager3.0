@code {
    [Parameter] public BudgetPeriod? CurrentPeriod { get; set; } = default!;

    [Parameter] public EventCallback OnPrev { get; set; }
    [Parameter] public EventCallback OnToday { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
}

<div class="graph-actions mb-2">
    <h1>@(CurrentPeriod?.Year.ToString() ?? "TODO get year")</h1>

    <HxButton Color="ThemeColor.Secondary" OnClick="OnPrev">Prev</HxButton>
    <HxButton Color="ThemeColor.Secondary" OnClick="OnToday">Today</HxButton>
    <HxButton Color="ThemeColor.Secondary" OnClick="OnNext">Next</HxButton>
</div>