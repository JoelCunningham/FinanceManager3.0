@code {
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public BudgetCellEntry? Entry { get; set; }
    [Parameter] public IReadOnlyList<CategorySummary> Categories { get; set; } = [];
    [Parameter] public BudgetYear? CurrentBudgetYear { get; set; }

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    
    public Task ShowAsync() => _modal?.ShowAsync() ?? Task.CompletedTask;
    public Task HideAsync() => _modal?.HideAsync() ?? Task.CompletedTask;

    private Havit.Blazor.Components.Web.Bootstrap.HxModal? _modal;

    private int _startScopePosition = 0;
    private int _endScopePosition = 0;

    private int StartScopePosition
    {
        get => _startScopePosition;
        set => SetRange(value, _endScopePosition);
    }

    private int EndScopePosition
    {
        get => _endScopePosition;
        set => SetRange(_startScopePosition, value);
    }

    protected override void OnParametersSet()
    {
        if (Entry is not null)
        {
            SetRange(Entry.OverallScopePosition, Entry.OverallScopePosition + Entry.OverallLength - 1);
        }
    }

    private void SetRange(int startScopePosition, int endScopePosition)
    {
        if (Entry is null || CurrentBudgetYear is null) return;

        var maxScopePosition = ScopeHelper.GetPeriodCount(CurrentBudgetYear.Scope, CurrentBudgetYear.Year) - 1;

        _startScopePosition = Math.Clamp(Math.Min(startScopePosition, endScopePosition), 0, maxScopePosition);
        _endScopePosition = Math.Clamp(Math.Max(startScopePosition, endScopePosition), _startScopePosition, maxScopePosition);
      
        Entry.OverallScopePosition = _startScopePosition;
        Entry.OverallLength = _endScopePosition - _startScopePosition + 1;
    }

    private IEnumerable<KeyValuePair<string, int>> GetScopePositionOptions()
    {
        if (CurrentBudgetYear is null) return [];

        return CurrentBudgetYear.Scope switch
        {
            BudgetScope.Monthly => GetMonthScopePositionOptions(),
            BudgetScope.Fortnightly => GetSequentialOptions("F", ScopeHelper.GetPeriodCount(BudgetScope.Fortnightly, CurrentBudgetYear.Year)),
            BudgetScope.Weekly => GetSequentialOptions("W", ScopeHelper.GetPeriodCount(BudgetScope.Weekly, CurrentBudgetYear.Year)),
            _ => []
        };
    }

    private static IEnumerable<KeyValuePair<string, int>> GetMonthScopePositionOptions()
    {
        var monthNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames
            .Where(monthName => !string.IsNullOrWhiteSpace(monthName))
            .Take(12)
            .ToArray();

        return monthNames
            .Select((monthName, index) => new KeyValuePair<string, int>(monthName, index));
    }

    private static IEnumerable<KeyValuePair<string, int>> GetSequentialOptions(string prefix, int periodsCount)
    {
        return Enumerable.Range(0, periodsCount)
            .Select(index => new KeyValuePair<string, int>($"{prefix}{index + 1:00}", index));
    }
}

<HxModal @ref="_modal" Title="@(IsEditing ? "Edit budget entry" : "Create budget entry")">
    <BodyTemplate>
        <div class="d-flex flex-column gap-2">
            @if (Entry is not null && CurrentBudgetYear is not null)
            {
                <CategoryInput @bind-Value="Entry.Category" Data="Categories" Label="Category" Nullable="false" />
                <HxInputNumber @bind-Value="Entry.Amount" Label="Amount" />

                <div class="d-flex gap-3">
                        <HxSelect @bind-Value="StartScopePosition"
                                  Label="Start"
                                  Data="GetScopePositionOptions()"
                                  TItem="KeyValuePair<string, int>"
                                  TValue="int"
                                  Nullable="false"
                                  AutoSort="false"
                                  TextSelector="option => option.Key"
                                  ValueSelector="option => option.Value" />
                        <HxSelect @bind-Value="EndScopePosition"
                                  Label="End"
                                  Data="GetScopePositionOptions()"
                                  TItem="KeyValuePair<string, int>"
                                  TValue="int"
                                  Nullable="false"
                                  AutoSort="false"
                                  TextSelector="option => option.Key"
                                  ValueSelector="option => option.Value" />
                </div>

                <HxInputTextArea @bind-Value="Entry.Notes" Label="Notes" />
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" OnClick="OnCancel">Cancel</HxButton>
        @if (IsEditing)
        {
            <HxButton Color="ThemeColor.Danger" OnClick="OnDelete">Delete</HxButton>
        }
        <HxButton Color="ThemeColor.Primary" OnClick="OnSave">Save</HxButton>
    </FooterTemplate>
</HxModal>
