@code {
    [Parameter] public BudgetCell Cell { get; set; } = default!;

    [Parameter] public EventCallback<BudgetCell> OnCellClicked { get; set; }
    [Parameter] public EventCallback<BudgetCellEntry> OnEntryClicked { get; set; }

    private Task HandleCellClick() => OnCellClicked.InvokeAsync(Cell);
    private Task HandleEntryClick(BudgetCellEntry entry) => OnEntryClicked.InvokeAsync(entry);

    private string EntryCssClass(BudgetCellEntry entry)
    {
        var classes = new List<string> { "budget-entry" };
        if (entry.Category is not null)
        {
            classes.Add($"category-{entry.Category.Id}");
        }
        return string.Join(" ", classes);
    }
}

<div class="budget-cell" @onclick="HandleCellClick">
    <div class="budget-cell-header">@Cell.Label</div>

    @foreach (var entry in Cell.Entries)
    {
        if (entry.IsFirst || entry.IsStartOfRow)
        {
            <div class="budget-entry" @onclick:stopPropagation="true" @onclick="() => HandleEntryClick(entry)">
                <div class="budget-entry-title">@entry.Category?.Name</div>
                <div class="budget-entry-amount">@entry.Amount.ToString("C")</div>
            </div>
        }
    }
</div>
