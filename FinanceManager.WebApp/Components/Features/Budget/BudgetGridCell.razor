@code {
    [Parameter] public BudgetCell Cell { get; set; } = default!;
    [Parameter] public Guid? HoveredEntryId { get; set; }

    [Parameter] public EventCallback<BudgetCell> OnCellClicked { get; set; }
    [Parameter] public EventCallback<BudgetCellEntry> OnEntryClicked { get; set; }
    [Parameter] public EventCallback<Guid?> OnEntryHoverChanged { get; set; }

    private Task HandleCellClick() => OnCellClicked.InvokeAsync(Cell);

}

<div class="budget-cell" @onclick="HandleCellClick">
    <div class="budget-cell-header">@Cell.Label</div>

    @foreach (var entry in Cell.Entries)
    {
        <div class="budget-entry-slot">
            <BudgetGridCellEntry Entry="entry" HoveredEntryId="HoveredEntryId" OnEntryClicked="OnEntryClicked" OnEntryHoverChanged="OnEntryHoverChanged" />
        </div>
    }
</div>
