@code {
    [Parameter] public BudgetCell Cell { get; set; } = default!;
    [Parameter] public Guid? HoveredEntryId { get; set; }

    [Parameter] public IReadOnlyDictionary<int, decimal> RowHeights { get; set; } = new Dictionary<int, decimal>();
    [Parameter] public IReadOnlyDictionary<int, decimal> RowTopOffsets { get; set; } = new Dictionary<int, decimal>();

    [Parameter] public EventCallback<BudgetCell> OnCellClicked { get; set; }
    [Parameter] public EventCallback<BudgetCellEntry> OnEntryClicked { get; set; }
    [Parameter] public EventCallback<Guid?> OnEntryHoverChanged { get; set; }

    private Task HandleCellClick() => OnCellClicked.InvokeAsync(Cell);

    private decimal CellTotal => Cell.Entries.Sum(e => e.Category!.IsIncome ? e.Amount : -e.Amount);

    private int LastRowIndex => Cell.Entries.Max(entry => entry.YIndex);
}

<div class="budget-cell" @onclick="HandleCellClick">
    <div class="budget-cell-header">@Cell.Label</div>
    <div class="budget-cell-content" style="height: @(RowHeights[LastRowIndex] + RowTopOffsets[LastRowIndex])rem">
        @foreach (var entry in Cell.Entries)
        {
            <BudgetGridCellEntry Entry="entry" RowHeights="RowHeights" RowTopOffsets="RowTopOffsets" HoveredEntryId="HoveredEntryId" OnEntryClicked="OnEntryClicked" OnEntryHoverChanged="OnEntryHoverChanged" />
        }
    </div>
    <div class="budget-cell-footer">@CellTotal.ToString("C")</div>
</div>
