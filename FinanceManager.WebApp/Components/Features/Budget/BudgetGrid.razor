@code {
    [Parameter] public BudgetScope? Scope { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public IReadOnlyList<BudgetCell> Cells { get; set; } = [];
    [Parameter] public IReadOnlyList<CategorySummary> Categories { get; set; } = [];
    [Parameter] public bool HideEmptyCategories { get; set; }

    [Parameter] public EventCallback<(BudgetCell, CategorySummary)> OnCellClicked { get; set; }
    [Parameter] public EventCallback<BudgetCellEntry> OnEntryClicked { get; set; }
    [Parameter] public EventCallback OnBudgetCreateClicked { get; set; }

    private Guid? HoveredEntryId { get; set; }

    private IReadOnlyList<CategoryGroupRow> GroupRows => GetGroupRows();

    private string GridCssClass => Scope switch
    {
        BudgetScope.Monthly => "budget-grid budget-grid-month",
        BudgetScope.Fortnightly => "budget-grid budget-grid-fortnight",
        BudgetScope.Weekly => "budget-grid budget-grid-week",
        _ => "budget-grid"
    };

    private Task HandleEntryHoverChanged(Guid? entryId)
    {
        HoveredEntryId = entryId;
        return Task.CompletedTask;
    }

    private decimal GetColumnTotal(BudgetCell cell)
    {
        return cell.Entries
            .Where(entry => entry.EntityId.HasValue)
            .GroupBy(entry => entry.EntityId!.Value)
            .Select(group => group.First())
            .Sum(entry => entry.Category?.IsIncome == true ? entry.Amount : -entry.Amount);
    }

    private decimal GetRowTotal(CategorySummary category)
    {
        return Cells
            .SelectMany(cell => cell.Entries)
            .Where(entry => entry.Category?.Id == category.Id && entry.EntityId.HasValue)
            .GroupBy(entry => entry.EntityId!.Value)
            .Select(group => group.First())
            .Sum(entry => (entry.Category?.IsIncome == true ? entry.Amount : -entry.Amount) * entry.OverallLength);
    }

    private decimal GetGroupTotal(CategoryGroupRow group)
    {
        return group.Categories.Sum(GetRowTotal);
    }

    private decimal GetGrandTotal()
    {
        return Cells.Sum(GetColumnTotal);
    }


    private IReadOnlyList<CategoryGroupRow> GetGroupRows()
    {
        var sortedCategories = Categories
            .OrderByDescending(category => category.IsIncome)
            .ThenBy(category => category.GroupName)
            .ThenBy(category => category.Name)
            .ToList();

        var rows = sortedCategories
            .GroupBy(category => category.GroupName)
            .OrderByDescending(group => group.First().IsIncome)
            .ThenBy(group => group.Key)
            .Select(group => new CategoryGroupRow(group.Key, group.First().GroupColour, group
                .OrderBy(category => category.Name)
                .ToList()))
            .ToList();

        if (!HideEmptyCategories) return rows;

        var populatedCategoryIds = Cells
            .SelectMany(cell => cell.Entries)
            .Where(entry => entry.IsFirst)
            .Select(entry => entry.Category?.Id)
            .Where(id => id.HasValue)
            .Select(id => id!.Value)
            .ToHashSet();

        if (populatedCategoryIds.Count == 0) return rows;

        return rows
            .Select(group => group with
            {
                Categories = group.Categories
                    .Where(category => populatedCategoryIds.Contains(category.Id))
                    .ToList()
            })
            .Where(group => group.Categories.Count > 0)
            .ToList();
    }

    private sealed record CategoryGroupRow(string Name, string Colour, IReadOnlyList<CategorySummary> Categories);
}

@if (Scope is not null)
{
    <div class="budget-grid-wrapper">
        <div class="budget-grid" style="grid-template-columns: auto repeat(@Cells.Count, 1fr) auto;">
            <div class="budget-grid-cell budget-grid-label-header" />
            @foreach (var cell in Cells)
            {
                <div class="budget-grid-cell budget-grid-period-header">
                    <p>@cell.Label</p>
                    @if (cell.SubLabel is not null)
                    {
                        <p>@cell.SubLabel</p>
                    }
                </div>
            }
            <div class="budget-grid-cell budget-grid-label-header" />

            @foreach (var group in GroupRows)
            {
                <div class="budget-grid-cell budget-grid-group-cell">
                    <span style="@CategoryUtilities.GetElementStyle(group.Colour)" title="@group.Name">
                        @group.Name
                    </span>
                </div>
                @for (int i = 0; i < Cells.Count; i++)
                {
                    <div class="budget-grid-cell group" style="@CategoryUtilities.GetElementStyle(group.Colour)" />
                }

                <div class="budget-grid-cell group total" style="@CategoryUtilities.GetElementStyle(group.Colour)">
                    @GetGroupTotal(group).ToString("C")
                </div>

                @foreach (var category in group.Categories)
                {
                    <div class="budget-grid-cell budget-grid-label-cell" title="@category.Name">
                        @category.Name
                    </div>

                    @for (var periodIndex = 0; periodIndex < Cells.Count; periodIndex++)
                    {
                        var cell = Cells[periodIndex];
                        var entry = cell.Entries.FirstOrDefault(e => e.Category?.Id == category.Id && e.ScopePosition == cell.Index);

                        if (entry is null)
                        {
                            <div class="budget-grid-cell budget-grid-entry-cell">
                                <div class="budget-grid-cell-contents empty" @onclick="() => OnCellClicked.InvokeAsync((cell, category))" />
                            </div>
                        }
                        else
                        {
                            <div class="budget-grid-cell budget-grid-entry-cell budget-grid-entry-filled" style="grid-column: span @entry.OverallLength; @(entry.OverallLength == 1 ? "text-align: center" : "")">
                                <div class="budget-grid-cell-contents" style="@CategoryUtilities.GetElementStyle(entry.Category?.Colour);" @onclick="() => OnEntryClicked.InvokeAsync(entry)">
                                    <span class="budget-grid-entry-amount">
                                        @entry.Amount.ToString("C")
                                    </span>
                                </div>
                            </div>
                            periodIndex += entry.OverallLength - 1;
                        }
                    }

                    <div class="budget-grid-cell budget-grid-entry-cell total" style="@CategoryUtilities.GetElementStyle(category.Colour)">
                        <div class="budget-grid-cell-contents" >
                            @GetRowTotal(category).ToString("C")
                        </div>
                    </div>
                }

            }

            <div class="budget-grid-cell budget-grid-label-header" />
            @for (int i = 0; i < Cells.Count; i++)
            {
                <div class="budget-grid-cell end">
                    @GetColumnTotal(Cells[i]).ToString("C")
                </div>
            }

            <div class="budget-grid-cell budget-grid-entry-cell total end">
                @GetGrandTotal().ToString("C")
            </div>
        </div>
    </div>
}
else
{
    <NotificationScreen Text="It looks like you haven't created a budget for this year yet - let's get started!">
        <HxButton Color="ThemeColor.Primary" @onclick="OnBudgetCreateClicked">Create now</HxButton>
    </NotificationScreen>
}