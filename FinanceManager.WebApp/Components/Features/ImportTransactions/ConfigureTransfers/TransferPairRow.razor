@code {
    [Parameter, EditorRequired]
    public required ImportedTransaction Transfer { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<ImportedTransaction> AcceptTransfer { get; set; }

    [Parameter, EditorRequired]
    public required EventCallback<ImportedTransaction> RejectTransfer { get; set; }

    private string? _animationClass;
    private bool _isAnimating => _animationClass is not null;

    private async Task Accept()
    {
        _animationClass = "accepting";
        await Task.Delay(700);
        await AcceptTransfer.InvokeAsync(Transfer);
        _animationClass = null;
    }

    private async Task Reject()
    {
        _animationClass = "rejecting";
        await Task.Delay(700);
        await RejectTransfer.InvokeAsync(Transfer);
        _animationClass = null;
    }
}

<div class="transaction-group @_animationClass">
    <TransferRow Transfer="Transfer" ShowActions="false" />
    @if (Transfer.Transfers is not null)
    {
        <TransferRow Transfer="Transfer.Transfers"
                     ShowActions="true"
                     DisableActions="_isAnimating"
                     OnAccept="Accept"
                     OnReject="Reject" />
    }
</div>