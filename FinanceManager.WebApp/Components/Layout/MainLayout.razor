@inherits LayoutComponentBase

@code {
    private bool IsDrawerOpen { get; set; } = true;

    private string? SearchText { get; set; }

    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">FinanceManager</MudText>
        <MudSpacer />
        <MudTextField Class="mx-4" Value="SearchText" Placeholder="Search Finance Manager..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit" />
    </MudAppBar>

    <MudDrawer @bind-Open="@IsDrawerOpen">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
            <MudNavLink Href="Transactions" Icon="@Icons.Material.Filled.List">Transactions</MudNavLink>
            <MudNavLink Href="Transactions/Review" Icon="@Icons.Material.Filled.Rule">Review</MudNavLink>
            <MudNavLink Href="Transactions/Transfers" Icon="@Icons.Material.Filled.CompareArrows">Transfers</MudNavLink>
            <MudNavLink Href="Import" Icon="@Icons.Material.Filled.FileUpload">Import</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
