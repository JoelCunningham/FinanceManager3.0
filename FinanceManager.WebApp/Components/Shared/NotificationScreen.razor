@code {
    [Parameter] public string Text { get; set; } = default!;

    [Parameter] public RenderFragment? ChildContent { get; set; }
}

<div class="notification-screen">
    <p>@Text</p>

    @if (ChildContent is not null)
    {
        <div class="notification-screen-actions">
            @ChildContent
        </div>
    }
</div>