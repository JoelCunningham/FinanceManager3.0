@code {
    [Parameter] public IReadOnlyList<DateOnly> AvailableMonths { get; set; } = [];

    [Parameter] public DateOnly Value { get; set; }
    [Parameter] public EventCallback<DateOnly> ValueChanged { get; set; }

    [Parameter] public string MonthLabel { get; set; } = "Month";
    [Parameter] public string YearLabel { get; set; } = "Year";

    private const int YearsBackFallback = 10;
    private static readonly IReadOnlyList<int> AllMonths = [.. Enumerable.Range(1, 12)];

    private DateOnly _valueInternal;

    private IReadOnlyList<DateOnly>? _availableMonthsRef;
    private List<int> _availableYears = [];
    private Dictionary<int, List<int>> _monthsByYear = [];

    private static DateOnly Normalize(DateOnly value) => new(value.Year, value.Month, 1);
    private static string FormatMonthNumber(int month) => new DateOnly(2000, month, 1).ToString("MMM");

    private IReadOnlyList<int> AvailableYears =>
        _availableYears.Count > 0
            ? _availableYears
            : [.. Enumerable.Range(DateTime.Today.Year - YearsBackFallback, YearsBackFallback + 1)];

    private IReadOnlyList<int> AvailableMonthsForYear => GetMonthsForYear(_valueInternal.Year);

    protected override void OnParametersSet()
    {
        _valueInternal = Normalize(Value);

        if (!ReferenceEquals(_availableMonthsRef, AvailableMonths))
        {
            _availableMonthsRef = AvailableMonths;
            RebuildLookups(AvailableMonths);
        }

        NormalizeInternal();
    }

    private void RebuildLookups(IReadOnlyList<DateOnly> availableMonths)
    {
        _availableYears = [];
        _monthsByYear = [];

        if (availableMonths.Count == 0) return;

        foreach (var m in availableMonths.Select(Normalize))
        {
            if (!_monthsByYear.TryGetValue(m.Year, out var months))
            {
                months = [];
                _monthsByYear[m.Year] = months;
            }

            if (!months.Contains(m.Month))
            {
                months.Add(m.Month);
            }
        }

        foreach (var months in _monthsByYear.Values)
        {
            months.Sort();
        }

        _availableYears = [.. _monthsByYear.Keys.Order()];
    }

    private IReadOnlyList<int> GetMonthsForYear(int year)
    {
        if (_monthsByYear.TryGetValue(year, out var months) && months.Count > 0)
        {
            return months;
        }

        return AllMonths;
    }

    private void NormalizeInternal()
    {
        var years = AvailableYears;
        if (years.Count == 0) return;

        if (!years.Contains(_valueInternal.Year))
        {
            _valueInternal = new DateOnly(years.Last(), _valueInternal.Month, 1);
        }

        var months = GetMonthsForYear(_valueInternal.Year);
        if (!months.Contains(_valueInternal.Month))
        {
            _valueInternal = new DateOnly(_valueInternal.Year, months.Last(), 1);
        }
    }

    private int SelectedYear
    {
        get => _valueInternal.Year;
        set => _ = UpdateAsync(value, _valueInternal.Month);
    }

    private int SelectedMonth
    {
        get => _valueInternal.Month;
        set => _ = UpdateAsync(_valueInternal.Year, value);
    }

    private async Task UpdateAsync(int year, int month)
    {
        var years = AvailableYears;
        if (years.Count > 0 && !years.Contains(year))
        {
            year = years.Last();
        }

        var months = GetMonthsForYear(year);
        if (!months.Contains(month))
        {
            month = months.Last();
        }

        _valueInternal = new DateOnly(year, month, 1);

        await ValueChanged.InvokeAsync(_valueInternal);
    }
}

<HxButtonGroup>
    <HxSelect Label="@MonthLabel"
              @bind-Value="SelectedMonth"
              Data="AvailableMonthsForYear"
              TItem="int"
              TValue="int"
              Nullable="false"
              AutoSort="false"
              TextSelector="FormatMonthNumber"
              ValueSelector="m => m" />

    <HxSelect Label="@YearLabel"
              @bind-Value="SelectedYear"
              Data="AvailableYears"
              TItem="int"
              TValue="int"
              Nullable="false"
              AutoSort="false"
              TextSelector="y => y.ToString()"
              ValueSelector="y => y" />
</HxButtonGroup>