@code {
    [Parameter] public string? Heading { get; set; }

    [Parameter] public string AcceptedExtensions { get; set; } = string.Empty;

    [Parameter] public string? ErrorMessage { get; set; }

    [Parameter] public bool HasSuccess { get; set; }

    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        await OnFileSelected.InvokeAsync(e.File);
    }

    private string InputValidationClass => !string.IsNullOrEmpty(ErrorMessage) ? "is-invalid" : HasSuccess ? "is-valid" : string.Empty;

    private string MessageValidationClass => !string.IsNullOrEmpty(ErrorMessage) ? "invalid-feedback" : HasSuccess ? "valid-feedback" : string.Empty;
}

@if (!string.IsNullOrEmpty(Heading))
{
    <h2 class="section-heading">@Heading</h2>
}

<InputFile OnChange="HandleFileSelected" accept="@AcceptedExtensions" class="@($"form-control {InputValidationClass}")" />

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="@MessageValidationClass">@ErrorMessage</div>
}