@code {
    [Parameter] public Category? Value { get; set; }

    [Parameter] public EventCallback<Category?> ValueChanged { get; set; }

    [Parameter] public IEnumerable<Category> Data { get; set; } = [];

    [Parameter] public bool IsAutoCategorised { get; set; } = false;

    [Parameter] public bool HasError { get; set; } = false;

    private HxSelect<Category, Category> Select = new();

    private IEnumerable<Category> GroupedData()
    {
        return Data.GroupBy(c => c.Group).OrderBy(g => g.Key.Name).SelectMany(g =>
        {
            var header = new Category { Id = new Guid(), Name = $"- {g.Key.Name} -", Group = g.Key };
            var categories = g.OrderBy(c => c.Name);
            return new[] { header }.Concat(categories);
        });
    }
}

<div>
    @if (IsAutoCategorised)
    {
        <HxIcon Icon="BootstrapIcon.Stars" />
    }
    <HxSelect @bind-Value="Value"
              @bind-Value:after="() => ValueChanged.InvokeAsync(Value)"
              CssClass="@(IsAutoCategorised ? "auto-categorised" : "")"
              InputCssClass="@(HasError ? "is-invalid" : "")"
              Data="GroupedData()"
              TItem="Category"
              TValue="Category"
              Nullable="false"
              AutoSort="false"
              NullText="Select category"
              TextSelector="@(c => c.Name)"
              ValueSelector="@(c => c)"
              ItemDisabledSelector="@(c => c.Id == Guid.Empty)">
    </HxSelect>
</div>