@code {
    [Parameter] public CategorySummary? Value { get; set; }
    [Parameter] public EventCallback<CategorySummary?> ValueChanged { get; set; }

    [Parameter] public IEnumerable<CategorySummary> Data { get; set; } = [];

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Nullable { get; set; } = false;
    [Parameter] public bool IsAutoCategorised { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public bool Enabled { get; set; } = true;

    private bool isOpen = false;
    private string searchText = string.Empty;
    private string? selectedGroup = null;
    private int navigatedIndex = -1;

    private Guid? lastValueId;

    private bool IsSearching => !string.IsNullOrWhiteSpace(searchText);

    private IEnumerable<string> Groups => Data
        .Select(c => c.GroupName)
        .Distinct()
        .OrderBy(g => g);

    private IEnumerable<CategorySummary> CategoriesInSelectedGroup => Data
        .Where(c => c.GroupName == selectedGroup)
        .OrderBy(c => c.Name);

    private IEnumerable<IGrouping<string, CategorySummary>> FilteredGroups => Data
        .Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) || c.GroupName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .GroupBy(c => c.GroupName)
        .OrderBy(g => g.Key);

    private IList<object> NavigableItems
    {
        get
        {
            var items = new List<object>();

            if (IsSearching)
            {
                foreach (var group in FilteredGroups) foreach (var item in group.OrderBy(c => c.Name)) items.Add(item);
            }
            else if (selectedGroup is null)
            {
                foreach (var group in Groups) items.Add(group);
            }
            else
            {
                foreach (var item in CategoriesInSelectedGroup) items.Add(item);
            }

            return items;
        }
    }

    private bool IsNavigated(object item)
    {
        var items = NavigableItems;
        return navigatedIndex >= 0 && navigatedIndex < items.Count && items[navigatedIndex] == item;
    }

    protected override void OnParametersSet()
    {
        if (Value?.Id != lastValueId)
        {
            searchText = Value?.Name ?? string.Empty;
            lastValueId = Value?.Id;
            selectedGroup = null;
            navigatedIndex = -1;
            isOpen = false;
            return;
        }

        if (Value != null && string.IsNullOrWhiteSpace(searchText))
        {
            searchText = Value.Name;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!isOpen)
        {
            if (e.Key is "ArrowDown" or "ArrowUp")
            {
                isOpen = true;
                navigatedIndex = -1;
            }
            return;
        }

        var items = NavigableItems;

        switch (e.Key)
        {
            case "ArrowDown":
                navigatedIndex = items.Count == 0
                    ? -1
                    : (navigatedIndex + 1) % items.Count;
                break;

            case "ArrowUp":
                navigatedIndex = items.Count == 0
                    ? -1
                    : (navigatedIndex - 1 + items.Count) % items.Count;
                break;

            case "ArrowRight":
            case "Enter":
                if (navigatedIndex >= 0 && navigatedIndex < items.Count)
                {
                    var target = items[navigatedIndex];
                    if (target is string groupName && selectedGroup is null && !IsSearching)
                    {
                        SelectGroup(groupName);
                    }
                    else if (target is CategorySummary category)
                    {
                        await Select(category);
                    }
                }
                else if (e.Key == "Enter")
                {
                    var enter_first = items.OfType<CategorySummary>().FirstOrDefault();
                    if (enter_first is not null) await Select(enter_first);
                }
                break;

            case "Tab":
                var tab_first = items.OfType<CategorySummary>().FirstOrDefault();
                if (tab_first is not null) await Select(tab_first);
                break;

            case "ArrowLeft":
            case "Backspace":
                if (selectedGroup is not null)
                {
                    selectedGroup = null;
                    navigatedIndex = -1;
                }
                break;

            case "Escape":
                isOpen = false;
                searchText = string.Empty;
                selectedGroup = null;
                navigatedIndex = -1;
                Value = null;
                await ValueChanged.InvokeAsync(null);
                break;
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        navigatedIndex = -1;
        isOpen = true;

        if (IsSearching)
        {
            selectedGroup = null;
        }
    }

    private void SelectGroup(string group)
    {
        selectedGroup = group;
        navigatedIndex = -1;
    }

    private async Task Select(CategorySummary? item)
    {
        Value = item;
        searchText = item?.Name ?? string.Empty;
        isOpen = false;
        selectedGroup = null;
        navigatedIndex = -1;

        await ValueChanged.InvokeAsync(item);
    }

    private Task OnBlur(FocusEventArgs _)
    {
        isOpen = false;
        navigatedIndex = -1;

        if (Value != null)
        {
            searchText = Value.Name;
        }

        selectedGroup = null;

        return Task.CompletedTask;
    }

    private async Task Clear()
    {
        searchText = string.Empty;
        selectedGroup = null;
        navigatedIndex = -1;
        Value = null;

        isOpen = true;

        await ValueChanged.InvokeAsync(null);
    }
}

<div class="category-combobox">
    <div class="input-wrapper">
        @if (IsAutoCategorised)
        {
            <HxIcon Icon="BootstrapIcon.Stars" />
        }
        @if (Label is not null)
        {
            <label class="form-label">@Label</label>
        }
        <input class="form-control @(HasError ? "is-invalid" : "") @(IsAutoCategorised ? "auto-categorised" : "")"
               value="@searchText"
               @oninput="OnInput"
               @onfocus="() => isOpen = true"
               @onblur="OnBlur"
               @onkeydown="OnKeyDown"
               disabled="@(!Enabled)" />

        @if (!string.IsNullOrWhiteSpace(searchText) && Enabled)
        {
            <button class="clear-btn" @onmousedown:preventDefault @onclick="Clear">
                <HxIcon Icon="BootstrapIcon.X" />
            </button>
        }
    </div>

    @if (isOpen)
    {
        <div class="dropdown" @onmousedown:preventDefault>
            @if (IsSearching)
            {
                @if (FilteredGroups.Any())
                {
                    @foreach (var group in FilteredGroups)
                    {
                        <div class="dropdown-header">@group.Key</div>

                        @foreach (var item in group.OrderBy(c => c.Name))
                        {
                            <div class="dropdown-item @(IsNavigated(item) ? "navigated" : "")" @onmousedown="() => Select(item)">
                                @item.Name
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="dropdown-item disabled">No results</div>
                }
            }
            else
            {
                @if (selectedGroup is null)
                {
                    @foreach (var group in Groups)
                    {
                        <div class="dropdown-item @(IsNavigated(group) ? "navigated" : "")" @onmousedown="() => SelectGroup(group)">
                            @group
                        </div>
                    }
                }
                else
                {
                    <div class="dropdown-header back" @onmousedown="() => { selectedGroup = null; navigatedIndex = -1; }">
                        <HxIcon Icon="BootstrapIcon.ArrowLeft" /> Back
                    </div>
                    @foreach (var item in CategoriesInSelectedGroup)
                    {
                        <div class="dropdown-item @(IsNavigated(item) ? "navigated" : "")" @onmousedown="() => Select(item)">
                            @item.Name
                        </div>
                    }
                }
            }
            @if (Nullable)
            {
                <div class="dropdown-divider"></div>
                <div class="dropdown-item" @onmousedown="() => Select(null)">
                    Uncategorised
                </div>
            }
        </div>
    }
</div>