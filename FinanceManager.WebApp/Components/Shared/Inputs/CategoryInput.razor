@inject IJSRuntime JSRuntime

@code {
    [Parameter] public Category? SelectedCategory { get; set; }

    [Parameter] public EventCallback<Category?> SelectedCategoryChanged { get; set; }

    [Parameter] public IEnumerable<Category> Categories { get; set; } = [];

    [Parameter] public bool HasError { get; set; } = true;

    [Parameter] public bool IsAutoCategorised { get; set; } = false;

    private string? SelectedCategoryId;
    private ElementReference selectElement;

    private string GetSelectClass()
    {
        var builder = new StringBuilder("form-select");
        if (HasError) builder.Append(" is-invalid");
        if (IsAutoCategorised) builder.Append(" auto-categorised");
        return builder.ToString();
    }

    protected override void OnParametersSet()
    {
        SelectedCategoryId = SelectedCategory?.Id.ToString();
    }

    private async Task HandleCategoryChange()
    {
        SelectedCategory = SelectedCategoryId != "" && SelectedCategoryId != "None"
            ? Categories.FirstOrDefault(c => c.Id.ToString() == SelectedCategoryId)
            : null;

        await SelectedCategoryChanged.InvokeAsync(SelectedCategory);
    }

    private async Task OpenSelect()
    {
        await JSRuntime.InvokeVoidAsync("eval", "arguments[0].focus(); arguments[0].click();", selectElement);
    }
}
<div>
    @if (IsAutoCategorised)
    {
        <Icon Name="stars" @onclick="OpenSelect" />
    }
    <select @ref="selectElement" class="@GetSelectClass()" @bind="SelectedCategoryId" @bind:after="HandleCategoryChange">
        <option disabled selected value="">Select category</option>
        @foreach (var category in Categories)
        {
            <option value="@category.Id">@category.Group.Name - @category.Name</option>
        }
    </select>
</div>