@code {
    [Parameter] public CategorySummary? Value { get; set; }
    [Parameter] public EventCallback<CategorySummary?> ValueChanged { get; set; }

    [Parameter] public IEnumerable<CategorySummary> Data { get; set; } = [];

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Nullable { get; set; } = false;
    [Parameter] public bool IsAutoCategorised { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public bool Enabled { get; set; } = true;

    private bool isOpen = false;
    private string searchText = string.Empty;
    private string? selectedGroup = null;
    private int navigatedIndex = -1;

    private Guid? lastValueId;

    private bool IsSearching => !string.IsNullOrWhiteSpace(searchText);

    private List<string> groups = new();
    private List<CategorySummary> categoriesInSelectedGroup = new();
    private List<IGrouping<string, CategorySummary>> filteredGroups = new();
    private List<object> navigableItems = new();

    protected override void OnParametersSet()
    {
        if (Value?.Id != lastValueId)
        {
            searchText = Value?.Name ?? string.Empty;
            lastValueId = Value?.Id;
            selectedGroup = null;
            navigatedIndex = -1;
            isOpen = false;
            RebuildCachedState();
            return;
        }

        if (Value != null && string.IsNullOrWhiteSpace(searchText))
        {
            searchText = Value.Name;
            RebuildCachedState();
        }
    }

    private void RebuildCachedState()
    {
        groups = Data
            .Select(c => c.GroupName)
            .Distinct()
            .OrderBy(g => g)
            .ToList();

        if (selectedGroup is not null)
        {
            categoriesInSelectedGroup = Data
                .Where(c => c.GroupName == selectedGroup)
                .OrderBy(c => c.Name)
                .ToList();
        }
        else
        {
            categoriesInSelectedGroup.Clear();
        }

        if (IsSearching)
        {
            filteredGroups = Data
                .Where(c => c.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                            c.GroupName.Contains(searchText, StringComparison.OrdinalIgnoreCase))
                .GroupBy(c => c.GroupName)
                .OrderBy(g => g.Key)
                .ToList();
        }
        else
        {
            filteredGroups.Clear();
        }

        navigableItems.Clear();
        if (IsSearching)
        {
            foreach (var group in filteredGroups)
            {
                foreach (var item in group.OrderBy(c => c.Name))
                {
                    navigableItems.Add(item);
                }
            }
        }
        else if (selectedGroup is null)
        {
            foreach (var group in groups)
            {
                navigableItems.Add(group);
            }
        }
        else
        {
            foreach (var item in categoriesInSelectedGroup)
            {
                navigableItems.Add(item);
            }
        }
    }

    private bool IsNavigated(object item)
    {
        return navigatedIndex >= 0 && navigatedIndex < navigableItems.Count && navigableItems[navigatedIndex] == item;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!isOpen)
        {
            if (e.Key is "ArrowDown" or "ArrowUp")
            {
                isOpen = true;
                navigatedIndex = -1;
            }
            return;
        }

        var count = navigableItems.Count;

        switch (e.Key)
        {
            case "ArrowDown":
                navigatedIndex = count == 0 ? -1 : (navigatedIndex + 1) % count;
                break;

            case "ArrowUp":
                navigatedIndex = count == 0 ? -1 : (navigatedIndex - 1 + count) % count;
                break;

            case "ArrowRight":
            case "Enter":
                if (navigatedIndex >= 0 && navigatedIndex < count)
                {
                    var target = navigableItems[navigatedIndex];
                    if (target is string groupName && selectedGroup is null && !IsSearching)
                    {
                        SelectGroup(groupName);
                    }
                    else if (target is CategorySummary category)
                    {
                        await Select(category);
                    }
                }
                else if (e.Key == "Enter")
                {
                    var enter_first = navigableItems.OfType<CategorySummary>().FirstOrDefault();
                    if (enter_first is not null) await Select(enter_first);
                }
                break;

            case "Tab":
                var tab_first = navigableItems.OfType<CategorySummary>().FirstOrDefault();
                if (tab_first is not null) await Select(tab_first);
                break;

            case "ArrowLeft":
            case "Backspace":
                if (selectedGroup is not null)
                {
                    selectedGroup = null;
                    navigatedIndex = -1;
                    RebuildCachedState();
                }
                break;

            case "Escape":
                isOpen = false;
                searchText = string.Empty;
                selectedGroup = null;
                navigatedIndex = -1;
                Value = null;
                RebuildCachedState();
                await ValueChanged.InvokeAsync(null);
                break;
        }
    }

    private void OnInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        navigatedIndex = -1;
        isOpen = true;

        if (IsSearching)
        {
            selectedGroup = null;
        }

        RebuildCachedState();
    }

    private void SelectGroup(string group)
    {
        selectedGroup = group;
        navigatedIndex = -1;
        RebuildCachedState();
    }

    private async Task Select(CategorySummary? item)
    {
        Value = item;
        searchText = item?.Name ?? string.Empty;
        isOpen = false;
        selectedGroup = null;
        navigatedIndex = -1;

        RebuildCachedState();
        await ValueChanged.InvokeAsync(item);
    }

    private Task OnBlur(FocusEventArgs _)
    {
        isOpen = false;
        navigatedIndex = -1;

        if (Value != null)
        {
            searchText = Value.Name;
        }

        selectedGroup = null;
        RebuildCachedState();

        return Task.CompletedTask;
    }

    private async Task Clear()
    {
        searchText = string.Empty;
        selectedGroup = null;
        navigatedIndex = -1;
        Value = null;

        isOpen = true;
        RebuildCachedState();

        await ValueChanged.InvokeAsync(null);
    }
}

<div class="category-combobox">
    <div class="input-wrapper">
        @if (IsAutoCategorised)
        {
            <HxIcon Icon="BootstrapIcon.Stars" />
        }
        @if (Label is not null)
        {
            <label class="form-label">@Label</label>
        }
        <input class="form-control @(HasError ? "is-invalid" : "") @(IsAutoCategorised ? "auto-categorised" : "")"
               value="@searchText"
               @oninput="OnInput"
               @onfocus="() => isOpen = true"
               @onblur="OnBlur"
               @onkeydown="OnKeyDown"
               disabled="@(!Enabled)" />

        @if (!string.IsNullOrWhiteSpace(searchText) && Enabled)
        {
            <button class="@("clear-btn " + (Label is null ? "" : "labelled"))" @onmousedown:preventDefault @onclick="Clear">
                <HxIcon Icon="BootstrapIcon.X" />
            </button>
        }
    </div>

    @if (isOpen)
    {
        <div class="dropdown" @onmousedown:preventDefault>
            @if (IsSearching)
            {
                @if (filteredGroups.Count > 0)
                {
                    @foreach (var group in filteredGroups)
                    {
                        <div class="dropdown-header">@group.Key</div>

                        @foreach (var item in group.OrderBy(c => c.Name))
                        {
                            <div class="dropdown-item @(IsNavigated(item) ? "navigated" : "")" @onmousedown="() => Select(item)">
                                @item.Name
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="dropdown-item disabled">No results</div>
                }
            }
            else
            {
                @if (selectedGroup is null)
                {
                    @foreach (var group in groups)
                    {
                        <div class="dropdown-item @(IsNavigated(group) ? "navigated" : "")" @onmousedown="() => SelectGroup(group)">
                            @group
                        </div>
                    }
                }
                else
                {
                    <div class="dropdown-header back" @onmousedown="() => { selectedGroup = null; navigatedIndex = -1; RebuildCachedState(); }">
                        <HxIcon Icon="BootstrapIcon.ArrowLeft" /> Back
                    </div>
                    @foreach (var item in categoriesInSelectedGroup)
                    {
                        <div class="dropdown-item @(IsNavigated(item) ? "navigated" : "")" @onmousedown="() => Select(item)">
                            @item.Name
                        </div>
                    }
                }
            }
            @if (Nullable)
            {
                <div class="dropdown-divider"></div>
                <div class="dropdown-item" @onmousedown="() => Select(null)">
                    Uncategorised
                </div>
            }
        </div>
    }
</div>