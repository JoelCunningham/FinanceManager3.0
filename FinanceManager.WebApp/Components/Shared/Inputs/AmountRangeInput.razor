@code {
    [Parameter]
    public decimal? AmountMin { get; set; }

    [Parameter]
    public EventCallback<decimal?> AmountMinChanged { get; set; }

    [Parameter]
    public decimal? AmountMax { get; set; }

    [Parameter]
    public EventCallback<decimal?> AmountMaxChanged { get; set; }
}

<div class="input-group">
    <span class="input-group-text" id="amount-min-addon">$</span>
    <div class="form-floating">
        <input class="form-control"
               type="number"
               id="amount-min"
               aria-describedby="amount-min-addon"
               max="@AmountMax"
               @bind="AmountMin"
               @bind:event="oninput"
               @bind:after="() => AmountMinChanged.InvokeAsync(AmountMin)">
        <label for="amount-min">Amount min</label>
    </div>
</div>
<div class="input-group">
    <span class="input-group-text" id="amount-max-addon">$</span>
    <div class="form-floating">
        <input class="form-control"
               type="number"
               id="amount-max"
               aria-describedby="amount-max-addon"
               min="@AmountMin"
               @bind="AmountMax"
               @bind:event="oninput"
               @bind:after="() => AmountMaxChanged.InvokeAsync(AmountMax)">
        <label for="amount-max">Amount max</label>
    </div>
</div>