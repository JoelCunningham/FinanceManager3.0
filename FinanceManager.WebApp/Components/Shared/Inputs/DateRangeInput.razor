@code {
    [Parameter, EditorRequired]
    public DateTime? DateFrom { get; set; }

    [Parameter]
    public EventCallback<DateTime?> DateFromChanged { get; set; }

    [Parameter, EditorRequired]
    public DateTime? DateTo { get; set; }

    [Parameter]
    public EventCallback<DateTime?> DateToChanged { get; set; }

    [Parameter]
    public DateTime? MinDate { get; set; }

    [Parameter]
    public DateTime? MaxDate { get; set; }
}

<div class="input-group">
    <div class="form-floating">
        <input class="form-control"
               type="date"
               id="date-min"
               min="@MinDate"
               max="@MaxDate"
               @bind="DateFrom"
               @bind:event="oninput"
               @bind:after="() => DateFromChanged.InvokeAsync(DateFrom)" />
        <label for="date-min">Date from</label>
    </div>
</div>
<div class="input-group">
    <div class="form-floating">
        <input class="form-control"
               type="date"
               id="date-max"
               min="@MinDate"
               max="@MaxDate"
               @bind="DateTo"
               @bind:event="oninput"
               @bind:after="() => DateToChanged.InvokeAsync(DateTo)" />
        <label for="date-max">Date to</label>
    </div>
</div>