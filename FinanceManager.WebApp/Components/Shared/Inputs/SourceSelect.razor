@code {
    [Parameter, EditorRequired]
    public TransferSource SelectedSource { get; set; }

    [Parameter]
    public EventCallback<TransferSource> SelectedSourceChanged { get; set; }
}

<div class="form-floating">
    <select class="form-select" id="source" @bind="SelectedSource" @bind:after="() => SelectedSourceChanged.InvokeAsync(SelectedSource)">
        <option value="@TransferSource.All">Any</option>
        <option value="@TransferSource.User">Me</option>
        <option value="@TransferSource.Auto">System</option>
    </select>
    <label for="source">Created by</label>
</div>