@code {
    [Parameter] public required string Value { get; set; } = default!;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool HasError { get; set; }

    private IEnumerable<(string Value, string DisplayName)> ColourOptions =>
    [
        ("#C96A58", "Terracotta"),
        ("#C6537C", "Raspberry"),
        ("#9A5B91", "Plum"),
        ("#765FB3", "Violet"),
        ("#5364B5", "Indigo"),
        ("#4A849F", "Cobalt"),
        ("#4B927E", "Pine"),
        ("#679B4E", "Moss"),
        ("#8D994B", "Olive"),
        ("#B5744B", "Sienna"),
        ("#A8585D", "Crimson"),
        ("#B09A4B", "Gold"),    
    ];
}

<PickerInput @bind-Value="Value" Label="@Label" Options="ColourOptions">
    <SelectedPreview Context="colour">
        <span class="colour-button" style="background-color: @colour;" />
    </SelectedPreview>
    <OptionTemplate Context="colour">
        <span class="colour-button" style="background-color: @colour;" title="@ColourOptions.FirstOrDefault(c => c.Value == colour).DisplayName" />
    </OptionTemplate>
</PickerInput>
