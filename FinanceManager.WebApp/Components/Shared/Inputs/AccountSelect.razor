@code {
    [Parameter]
    public string? AccountFrom { get; set; }

    [Parameter]
    public EventCallback<string?> AccountFromChanged { get; set; }

    [Parameter]
    public string? AccountTo { get; set; }

    [Parameter]
    public EventCallback<string?> AccountToChanged { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<string> Accounts { get; set; } = [];

    private string accountTo = "";
    private string accountFrom = "";

    protected override void OnParametersSet()
    {
        accountTo = AccountTo is not null ? AccountTo : "";
        accountFrom = AccountFrom is not null ? AccountFrom : "";
    }

    private async Task FromAccountChange()
    {
        AccountFrom = accountFrom is not null ? accountFrom : null;
        await AccountFromChanged.InvokeAsync(AccountFrom);
    }

    private async Task ToAccountChange()
    {
        AccountTo = accountTo is not null ? accountTo : null;
        await AccountToChanged.InvokeAsync(AccountTo);
    }
}

<div class="form-floating">
    <select class="form-select" id="from-account" @bind="accountFrom" @bind:after="FromAccountChange">
        <option value="">Any</option>
        @foreach (var account in Accounts)
        {
            <option value="@account">@account</option>
        }
    </select>
    <label for="from-account">Account from</label>
</div>

<div class="form-floating">
    <select class="form-select" id="to-account" @bind="accountTo" @bind:after="ToAccountChange">
        <option value="">Any</option>
        @foreach (var account in Accounts)
        {
            <option value="@account">@account</option>
        }
    </select>
    <label for="from-account">Account to</label>
</div>