@code {
    [Parameter]
    public Category? SelectedCategory { get; set; }

    [Parameter]
    public EventCallback<Category?> SelectedCategoryChanged { get; set; }

    [Parameter, EditorRequired]
    public IEnumerable<Category> Categories { get; set; } = [];

    [Parameter]
    public bool AllowAll { get; set; } = true;

    [Parameter]
    public bool HasError { get; set; } = true;

    private string? SelectedCategoryId;

    private string SelectClass => HasError ? "form-select is-invalid" : "form-select";

    protected override void OnParametersSet()
    {
        SelectedCategoryId = SelectedCategory?.Id.ToString();
    }

    private async Task HandleCategoryChange()
    {
        SelectedCategory = SelectedCategoryId != "" && SelectedCategoryId != "None"
            ? Categories.FirstOrDefault(c => c.Id.ToString() == SelectedCategoryId)
            : null;

        await SelectedCategoryChanged.InvokeAsync(SelectedCategory);
    }
}

<div class="filter">
    @if (AllowAll)
    {
        <label class="form-label">Category</label>
    }
    <select class="@SelectClass" @bind="SelectedCategoryId" @bind:after="HandleCategoryChange">
        @if (AllowAll)
        {
            <option value="">All categories</option>
            <option value="None">Uncategorised</option>
            @* //TODO support uncategorised filtering *@
        }
        else
        {
            <option disabled selected value="">Select category</option>
        }
        @foreach (var category in Categories)
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
</div>