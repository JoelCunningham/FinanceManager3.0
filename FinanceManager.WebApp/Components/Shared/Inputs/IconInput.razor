@code {
    [Parameter] public required string Value { get; set; } = default!;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool HasError { get; set; }

    private IEnumerable<(string Value, string DisplayName)> IconOptions =>
    [
        ("Airplane", "Airplane"),
        ("Backpack", "Backpack"),
        ("Balloon", "Balloon"),
        ("Bandaid", "Bandaid"),
        ("Bank", "Bank"),
        ("Basket", "Basket"),
        ("Beaker", "Beaker"),
        ("Book", "Book"),
        ("Boombox", "Boombox"),
        ("Briefcase", "Briefcase"),
        ("Brush", "Brush"),
        ("Building", "Building"),
        ("BusFront", "BusFront"),
        ("Cake", "Cake"),
        ("Camera", "Camera"),
        ("Capsule", "Capsule"),
        ("CarFront", "Car"),
        ("Cart", "Cart"),
        ("Cash", "Cash"),
        ("Coin", "Coin"),
        ("Controller", "Controller"),
        ("CreditCard", "Credit Card"),
        ("Cup", "Cup"),
        ("DoorClosed", "Door Closed"),
        ("Duffle", "Duffle"),
        ("Easel", "Easel"),
        ("ForkKnife", "Fork and Knife"),
        ("FuelPump", "Fuel Pump"),
        ("GraphUpArrow", "Chart"),
        ("Gift", "Gift"),
        ("Hammer", "Hammer"),
        ("Handbag", "Handbag"),
        ("House", "House"),
        ("Luggage", "Luggage"),
        ("Mortarboard", "Mortarboard"),
        ("Person", "Person"),
        ("PiggyBank", "Piggy Bank"),
        ("Shop", "Shop"),
        ("Telephone", "Telephone"),
        ("TrainFront", "Train"),
        ("Wallet", "Wallet"),
    ];
}

<PickerInput @bind-Value="Value" @bind-Value:after="() => ValueChanged.InvokeAsync(Value)" Label="@Label" Options="IconOptions">
    <SelectedPreview Context="icon">
        <HxIcon Icon="@CategoryUtilities.GetCategroyGroupIcon(icon)" />
    </SelectedPreview>
    <OptionTemplate Context="icon">
        <HxIcon Icon="@CategoryUtilities.GetCategroyGroupIcon(icon)" title="@IconOptions.FirstOrDefault(i => i.Value == icon).DisplayName" />
    </OptionTemplate>
</PickerInput>
