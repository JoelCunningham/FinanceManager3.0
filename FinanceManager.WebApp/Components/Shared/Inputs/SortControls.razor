@code {
    [Parameter, EditorRequired]
    public TransactionSortBy SortBy { get; set; }

    [Parameter]
    public EventCallback<TransactionSortBy> SortByChanged { get; set; }

    [Parameter, EditorRequired]
    public bool SortDescending { get; set; }

    [Parameter]
    public EventCallback<bool> SortDescendingChanged { get; set; }

    [Parameter]
    public bool InculdeAccountSorts { get; set; } = true;

    private async Task ToggleSortOrder()
    {
        SortDescending = !SortDescending;
        await SortDescendingChanged.InvokeAsync(SortDescending);
    }
}

<div class="input-group">
    <select class="form-select" @bind="SortBy" @bind:after="() => SortByChanged.InvokeAsync(SortBy)">
        <option value="@TransactionSortBy.Date">Date</option>
        <option value="@TransactionSortBy.Amount">Amount</option>
        @if (InculdeAccountSorts)
        {
            <option value="@TransactionSortBy.FromAccount">Account from</option>
            <option value="@TransactionSortBy.ToAccount">Account to</option>
        }
    </select>
    <button type="button" class="btn btn-outline-secondary" @onclick="ToggleSortOrder">
        <Icon Name="@(SortDescending ? "sort-down" : "sort-up")" />
    </button>
</div>