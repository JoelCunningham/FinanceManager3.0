@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }

    [Parameter] public bool Enabled { get; set; } = true;
    [Parameter] public bool HasError { get; set; } = false;

    private string InputCssClass => HasError ? "is-invalid" : string.Empty;

    private string ColorValue => IsValidHexColor(Value) ? Value : "#000000";

    private static bool IsValidHexColor(string value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        if (!value.StartsWith("#", StringComparison.Ordinal)) return false;
        if (value.Length != 7) return false;

        return int.TryParse(value[1..], System.Globalization.NumberStyles.HexNumber, System.Globalization.CultureInfo.InvariantCulture, out _);
    }

    private async Task OnColorInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task OnTextInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}

<div class="hx-form-group">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="form-label">@Label</label>
    }
    <div class="colour-input">
        <input type="color"
               class="form-control form-control-color colour-picker @InputCssClass"
               value="@ColorValue"
               @oninput="OnColorInput"
               disabled="@(!Enabled)" />
        <input type="text"
               class="form-control colour-value @InputCssClass"
               value="@(Value == "" ? "#000000" : Value)"
               @oninput="OnTextInput"
               disabled="@(!Enabled)" />
    </div>
</div>
