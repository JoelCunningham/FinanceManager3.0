@code {
    [Parameter] public ValidationType Type { get; set; }

    [Parameter] public string Message { get; set; } = "";

    [Parameter] public bool IsVisible { get; set; } = false;

    [Parameter] public EventCallback OnClose { get; set; }

    private bool IsRendered = false;

    private string GetClass()
    {
        var builder = new StringBuilder("popup ");
        if (!IsVisible) builder.Append("hiding ");
        if (Type != ValidationType.None) builder.Append(Type.ToString().ToLower());
        return builder.ToString();
    }

    protected override void OnParametersSet()
    {
        if (IsVisible) IsRendered = true;
    }

    private async Task OnAnimationEnd()
    {
        if (!IsVisible)
        {
            IsRendered = false;
            StateHasChanged();
        }
    }
}

@if (IsRendered)
{
    <div class="@GetClass()" @onanimationend="OnAnimationEnd">
        <p>@Message</p>
        <button class="btn-close btn-close-white" @onclick="() => OnClose.InvokeAsync()" />
    </div>
}