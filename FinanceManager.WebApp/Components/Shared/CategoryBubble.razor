@code {
    [Parameter] public CategorySummary? Category { get; set; }
    [Parameter] public bool ShowIcon { get; set; } = true;
}

@if (Category is null)
{
    <p class="text-body-tertiary m-0">
        <span>Uncategorised</span>
    </p>
}
else
{
    <a class="category-bubble" href="/Categories/@Category.GroupName" style="@CategoryUtilities.GetElementStyle(Category.Colour)">
        @if (ShowIcon)
        {
            <HxIcon Icon="@CategoryUtilities.GetCategroyGroupIcon(Category.GroupIcon)" />
        }
        <span>@Category.Name</span>
    </a>
}