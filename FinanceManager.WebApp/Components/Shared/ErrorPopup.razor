@code {
    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private bool IsRendered = false;

    protected override void OnParametersSet()
    {
        if (IsVisible) IsRendered = true;
    }

    private async Task OnAnimationEnd()
    {
        if (!IsVisible)
        {
            IsRendered = false;
            StateHasChanged();
        }
    }
}

@if (IsRendered)
{
    <div class="error-popup @(IsVisible ? "" : "hiding")" @onanimationend="OnAnimationEnd">
        <p>@Message</p>
        <button class="btn-close btn-close-white" @onclick="() => OnClose.InvokeAsync()" />
    </div>
}