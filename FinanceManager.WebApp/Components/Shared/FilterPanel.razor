@code {
    [Parameter] public FilterQuery Filters { get; set; } = new();

    [Parameter] public RenderFragment? OuterContent { get; set; }

    [Parameter] public RenderFragment? InnerContent { get; set; }

    [Parameter] public EventCallback OnClear { get; set; }
}

<div class="outer-content">
    @OuterContent
    <div class="dropdown">
        <button class="btn btn-secondary dropdown-toggle"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#filter-collapse"
                aria-expanded="false"
                aria-controls="filter-collapse">
            Filters
        </button>
    </div>
</div>

<div class="collapse" id="filter-collapse">
    @InnerContent
    <button type="button" class="btn btn-outline-primary" @onclick="OnClear">
        Reset
    </button>
</div>