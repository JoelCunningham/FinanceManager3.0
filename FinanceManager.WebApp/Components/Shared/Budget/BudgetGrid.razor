@code {
    [Parameter] public BudgetScope? Scope { get; set; }
    [Parameter] public int Year { get; set; }

    [Parameter] public BudgetGridMode GridMode { get; set; }
    [Parameter] public bool HideEmptyCategories { get; set; }
    [Parameter] public bool BudgetMode { get; set; } = true;

    [Parameter] public IReadOnlyList<BudgetColumn> Columns { get; set; } = [];
    [Parameter] public IReadOnlyList<CategorySummary> Categories { get; set; } = [];

    [Parameter] public EventCallback<(BudgetCell, BudgetColumn)> OnCellClicked { get; set; }
    [Parameter] public EventCallback OnBudgetCreateClicked { get; set; }

    private IReadOnlyList<CategoryGroupRow> GroupRows => GetGroupRows();

    private decimal GetColumnBudgetTotal(BudgetColumn column)
    {
        return GetTotal(column.Cells, true);
    }

    private decimal GetColumnRealTotal(BudgetColumn column)
    {
        return GetTotal(column.Cells, false);
    }

    private decimal GetRowBudgetTotal(CategorySummary category)
    {
        return GetTotal(Columns.SelectMany(column => column.Cells).Where(cell => cell.Category?.Id == category.Id), true);
    }

    private decimal GetRowRealTotal(CategorySummary category)
    {
        return GetTotal(Columns.SelectMany(column => column.Cells).Where(cell => cell.Category?.Id == category.Id), false);
    }

    private decimal GetGroupBudgetTotal(CategoryGroupRow group)
    {
        return GetTotal(Columns.SelectMany(column => column.Cells).Where(cell => group.Categories.Any(category => category.Id == cell.Category?.Id)), true);
    }

    private decimal GetGroupRealTotal(CategoryGroupRow group)
    {
        return GetTotal(Columns.SelectMany(column => column.Cells).Where(cell => group.Categories.Any(category => category.Id == cell.Category?.Id)), false);
    }

    private decimal GetGrandBudgetTotal()
    {
        return GetTotal(Columns.SelectMany(column => column.Cells), true);
    }

    private decimal GetGrandRealTotal()
    {
        return GetTotal(Columns.SelectMany(column => column.Cells), false);
    }

    private decimal GetTotal(IEnumerable<BudgetCell> cells, bool isBudget)
    {
        return cells.Sum(cell => isBudget
                ? cell.Category?.IsIncome == true ? cell.BudgetAmount : -cell.BudgetAmount
                : cell.RealAmount);
    }

    private IReadOnlyList<CategoryGroupRow> GetGroupRows()
    {
        var filteredCategories = Categories
            .Where(GridMode switch
            {
                BudgetGridMode.Expense => category => !category.IsIncome,
                BudgetGridMode.Income => category => category.IsIncome,
                _ => category => true
            });

        var sortedCategories = filteredCategories
            .OrderByDescending(category => category.IsIncome)
            .ThenBy(category => category.GroupName)
            .ThenBy(category => category.Name)
            .ToList();

        var rows = sortedCategories
            .GroupBy(category => category.GroupName)
            .OrderByDescending(group => group.First().IsIncome)
            .ThenBy(group => group.Key)
            .Select(group => new CategoryGroupRow(
                group.Key,
                group.First().GroupColour,
                group.First().GroupIcon,
                group.OrderBy(category => category.Name).ToList()))
            .ToList();

        if (!HideEmptyCategories)
            return rows;

        var populatedCategoryIds = Columns
            .SelectMany(column => column.Cells)
            .SelectMany(cell => cell.BudgetEntries
                .Select(entry => entry.Category?.Id)
                .Concat(cell.Transactions
                    .Select(transaction => transaction.Category?.Id)))
            .ToHashSet();

        if (populatedCategoryIds.Count == 0)
            return rows;

        return rows
            .Select(group => group with
            {
                Categories = group.Categories
                    .Where(category => populatedCategoryIds.Contains(category.Id))
                    .ToList()
            })
            .Where(group => group.Categories.Count > 0)
            .ToList();
    }

    private string? GetEntryCssClass(BudgetColumn column)
    {
        if (Columns.ToList().IndexOf(column) == 0) return "start";
        if (Columns.ToList().IndexOf(column) == Columns.Count - 1) return "end";
        return "middle";
    }

    private string GetAmountStatusCss(bool isFuturePeriod, bool isIncome, decimal realAmount, decimal budgetAmount)
    {
        if (isFuturePeriod) return "future";
        var overBudget = isIncome ? realAmount < budgetAmount : -realAmount > budgetAmount;
        return overBudget ? "negative" : "positive";
    }

    private sealed record CategoryGroupRow(string Name, string Colour, string Icon, IReadOnlyList<CategorySummary> Categories);
}

@if (Scope is not null)
{
    <div class="budget-grid-wrapper">
        <div class="budget-grid" style="grid-template-columns: auto repeat(@Columns.Count, 1fr) auto;">
            <div class="budget-grid-cell budget-grid-category-header">
                <p>Category</p>
            </div>
            @foreach (var column in Columns)
            {
                <div class="@("budget-grid-cell budget-grid-period-header ")">
                    <p>@column.Label</p>
                    @if (column.SubLabel is not null)
                    {
                        <p>@column.SubLabel</p>
                    }
                </div>
            }
            <div class="budget-grid-cell budget-grid-total-header">
                <p>Total</p>
            </div>

            @foreach (var group in GroupRows)
            {
                <div class="budget-grid-cell budget-grid-group-cell">
                    <span title="@group.Name">
                        <HxIcon Icon="CategoryUtilities.GetCategroyGroupIcon(group.Icon)" />
                        @group.Name
                    </span>
                </div>
                foreach (var column in Columns)
                {
                    <div class="@("budget-grid-cell group ")" />
                }
                <div class="@("budget-grid-cell group total " + GetAmountStatusCss(DateTime.Now.Year >= Year, true, GetGroupRealTotal(group), GetGroupBudgetTotal(group)))">
                    @if (BudgetMode)
                    {
                        <HxTooltip Text="@("Actual: " + GetGroupRealTotal(group).ToString("C"))">
                            @GetGroupBudgetTotal(group).ToString("C")
                        </HxTooltip>
                    }
                    else
                    {
                        <HxTooltip Text="@("Budget: " + GetGroupBudgetTotal(group).ToString("C"))">
                            @GetGroupRealTotal(group).ToString("C")
                        </HxTooltip>
                    }
                </div>

                @foreach (var category in group.Categories)
                {
                    <div class="budget-grid-cell budget-grid-label-cell" title="@category.Name">
                        <CategoryBubble Category="@category" ShowIcon="false" />
                    </div>

                    @for (var periodIndex = 0; periodIndex < Columns.Count; periodIndex++)
                    {
                        var column = Columns[periodIndex];
                        var cell = column.Cells.FirstOrDefault(c => c.Category.Id == category.Id);

                        if (cell is null) continue;

                        <div class="@("budget-grid-cell budget-grid-entry-cell budget-grid-entry-filled grouped " + GetAmountStatusCss(column.IsFuturePeriod(), category.IsIncome, cell.RealAmount, cell.BudgetAmount))" @onclick="() => OnCellClicked.InvokeAsync((cell, column))">
                            <span class="@("budget-grid-entry-amount " + GetEntryCssClass(column))">
                                @if (BudgetMode)
                                {
                                    <HxTooltip Text="@("Actual: " + Math.Abs(cell.RealAmount).ToString("C"))">
                                        @cell.BudgetAmount.ToString("C")
                                    </HxTooltip>
                                }
                                else
                                {
                                    <HxTooltip Text="@("Budget: " + Math.Abs(cell.BudgetAmount).ToString("C"))">
                                        @cell.RealAmount.ToString("C")
                                    </HxTooltip>
                                }
                            </span>

                        </div>
                    }
                    <div class="@("budget-grid-cell budget-grid-entry-cell total " + GetAmountStatusCss(DateTime.Now.Year >= Year, category.IsIncome, GetRowRealTotal(category), GetRowBudgetTotal(category)))">
                        @if (BudgetMode)
                        {
                            <HxTooltip Text="@("Actual: " + GetRowRealTotal(category).ToString("C"))">
                                @GetRowBudgetTotal(category).ToString("C")
                            </HxTooltip>
                        }
                        else
                        {
                            <HxTooltip Text="@("Budget: " + GetRowBudgetTotal(category).ToString("C"))">
                                @GetRowRealTotal(category).ToString("C")
                            </HxTooltip>
                        }
                    </div>
                }
            }

            <div class="budget-grid-cell budget-grid-total-footer">
                Total
            </div>
            @foreach (var column in Columns)
            {
                <div class="@("budget-grid-cell budget-grid-entry-cell end " + GetAmountStatusCss(column.IsFuturePeriod(), true, GetColumnRealTotal(column), GetColumnBudgetTotal(column)))">
                    @if (BudgetMode)
                    {
                        <HxTooltip Text="@("Actual: " + GetColumnRealTotal(column).ToString("C"))">
                            @GetColumnBudgetTotal(column).ToString("C")
                        </HxTooltip>
                    }
                    else
                    {
                        <HxTooltip Text="@("Budget: " + GetColumnBudgetTotal(column).ToString("C"))">
                            @GetColumnRealTotal(column).ToString("C")
                        </HxTooltip>
                    }
                </div>
            }

            <div class="@("budget-grid-cell budget-grid-entry-cell total end " + GetAmountStatusCss(DateTime.Now.Year >= Year, true, GetGrandRealTotal(), GetGrandBudgetTotal()))">
                @if (BudgetMode)
                {
                    <HxTooltip Text="@("Actual: " + GetGrandRealTotal().ToString("C"))">
                        @GetGrandBudgetTotal().ToString("C")
                    </HxTooltip>
                }
                else
                {
                    <HxTooltip Text="@("Budget: " + GetGrandBudgetTotal().ToString("C"))">
                        @GetGrandRealTotal().ToString("C")
                    </HxTooltip>
                }
            </div>
        </div>
    </div>
}
else
{
    <NotificationScreen Text="It looks like you haven't created a budget for this year yet - let's get started!">
        <HxButton Color="ThemeColor.Primary" @onclick="OnBudgetCreateClicked">Create now</HxButton>
    </NotificationScreen>
}