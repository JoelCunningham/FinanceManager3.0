@using FinanceManager.Application.Common
@using FinanceManager.Application.Interfaces
@inject UserState UserState
@inject IIdentityService IndentityService

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = await IndentityService.GetCurrentUserSummaryAsync();
        UserState.UpdateUserName(user?.Name);
        UserState.OnNameChange += StateHasChanged;
    }
}

