@code
{
    [Parameter] public required BudgetPeriod Value { get; set; }
    [Parameter] public EventCallback<BudgetPeriod> ValueChanged { get; set; }

    private IEnumerable<int> YearOptions = [.. Enumerable.Range(DateTime.Today.Year - 3, DateTime.Today.Year + 1)];
    private IEnumerable<BudgetPeriod> WeekOptions = [];

    private int SelectedYear { get; set; }

    protected override void OnParametersSet()
    {
        SelectedYear = ISOWeek.GetYear(Value.StartDate.ToDateTime(TimeOnly.MinValue));
        WeekOptions = DateService.GetWeeks(SelectedYear);
    }

    private async Task WeekChangedAsync(BudgetPeriod period) => await ValueChanged.InvokeAsync(period);

    private async Task YearChanged(int isoYear)
    {
        SelectedYear = isoYear;
        WeekOptions = DateService.GetWeeks(isoYear);

        var currentIsoWeek = DateService.GetWeekIndex(Value.StartDate);
        var targetStartDt = ISOWeek.ToDateTime(isoYear, currentIsoWeek, DayOfWeek.Monday);
        var targetStartDate = DateOnly.FromDateTime(targetStartDt);

        Value = WeekOptions.FirstOrDefault(p => p.StartDate <= targetStartDate && p.EndDate >= targetStartDate) ?? WeekOptions.First();

        await ValueChanged.InvokeAsync(Value);
    }

    private static string FormatWeek(BudgetPeriod period)
    {
        var start = DateService.GetWeekIndex(period.StartDate);
        return $"W{start:00} ({period.StartDate:dd/MM} - {period.EndDate:dd/MM})";
    }
}

<HxButtonGroup>
    <HxSelect Label="Week"
              Value="Value"
              ValueChanged="WeekChangedAsync"
              ValueExpression="() => Value"
              Data="WeekOptions"
              TItem="BudgetPeriod"
              TValue="BudgetPeriod"
              Nullable="false"
              AutoSort="false"
              TextSelector="w => FormatWeek(w)"
              ValueSelector="w => w" />

    <HxSelect Label="Year"
              Value="SelectedYear"
              ValueChanged="YearChanged"
              ValueExpression="() => SelectedYear"
              Data="YearOptions"
              TItem="int"
              TValue="int"
              Nullable="false"
              AutoSort="false"
              TextSelector="y => y.ToString()"
              ValueSelector="y => y" />
</HxButtonGroup>