@code
{
    [Parameter] public required ScopedRange Value { get; set; }
    [Parameter] public EventCallback<ScopedRange> ValueChanged { get; set; }

    private IEnumerable<int> YearOptions = [.. Enumerable.Range(DateTime.Today.Year - 3, DateTime.Today.Year + 1)];
    private IEnumerable<ScopedRange> WeekOptions = [];

    private int SelectedYear { get; set; }

    protected override void OnParametersSet()
    {
        SelectedYear = ISOWeek.GetYear(Value.StartDate.ToDateTime(TimeOnly.MinValue));
        WeekOptions = GetWeekRanges.Execute(SelectedYear).Ranges.ToList();
        Value = WeekOptions.FirstOrDefault(p => p.StartDate <= Value.StartDate && p.EndDate >= Value.StartDate) ?? WeekOptions.First();
    }

    private async Task WeekChangedAsync(ScopedRange range) => await ValueChanged.InvokeAsync(range);

    private async Task YearChanged(int isoYear)
    {
        SelectedYear = isoYear;
        WeekOptions = GetWeekRanges.Execute(SelectedYear).Ranges.ToList();

        var currentIsoWeek = DateHelper.GetWeekIndex(Value.StartDate);
        var targetStartDt = ISOWeek.ToDateTime(isoYear, currentIsoWeek, DayOfWeek.Monday);
        var targetStartDate = DateOnly.FromDateTime(targetStartDt);

        Value = WeekOptions.FirstOrDefault(p => p.StartDate <= targetStartDate && p.EndDate >= targetStartDate) ?? WeekOptions.First();

        await ValueChanged.InvokeAsync(Value);
    }

    private static string FormatWeek(ScopedRange range)
    {
        var start = DateHelper.GetWeekIndex(range.StartDate);
        return $"W{start:00} ({range.StartDate:dd/MM} - {range.EndDate:dd/MM})";
    }
}

<HxButtonGroup>
    <HxSelect Label="Week"
              Value="Value"
              ValueChanged="WeekChangedAsync"
              ValueExpression="() => Value"
              Data="WeekOptions"
              TItem="ScopedRange"
              TValue="ScopedRange"
              Nullable="false"
              AutoSort="false"
              TextSelector="w => FormatWeek(w)"
              ValueSelector="w => w" />

    <HxSelect Label="Year"
              Value="SelectedYear"
              ValueChanged="YearChanged"
              ValueExpression="() => SelectedYear"
              Data="YearOptions"
              TItem="int"
              TValue="int"
              Nullable="false"
              AutoSort="false"
              TextSelector="y => y.ToString()"
              ValueSelector="y => y" />
</HxButtonGroup>