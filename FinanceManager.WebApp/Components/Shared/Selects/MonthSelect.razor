@code
{
    [Parameter] public required ScopedRange Value { get; set; }
    [Parameter] public EventCallback<ScopedRange> ValueChanged { get; set; }

    [Parameter] public bool ChangeLength { get; set; }
    [Parameter] public bool ChangeEndDate { get; set; }

    [Parameter] public string MonthLabel { get; set; } = "Month";
    [Parameter] public string YearLabel { get; set; } = "Year";

    private IEnumerable<int> YearOptions = [.. Enumerable.Range(DateTime.Today.Year - 3, DateTime.Today.Year + 1)];
    private IEnumerable<ScopedRange> MonthOptions = [];

    private int SelectedYear { get; set; }
    private ScopedRange SelectedMonth { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (ChangeEndDate)
        {
            if (YearOptions.Contains(Value.EndDate.Year))
            {
                SelectedYear = Value.EndDate.Year;
            }
            MonthOptions = GetMonthRanges.Execute(SelectedYear).Ranges.ToList();
            SelectedMonth = MonthOptions.FirstOrDefault(m => m.StartDate <= Value.EndDate && m.EndDate >= Value.EndDate) ?? MonthOptions.First();
        }
        else
        {
            if (YearOptions.Contains(Value.StartDate.Year))
            {
                SelectedYear = Value.StartDate.Year;
            }
            SelectedYear = Value.StartDate.Year;
            MonthOptions = GetMonthRanges.Execute(SelectedYear).Ranges.ToList();
            SelectedMonth = MonthOptions.FirstOrDefault(m => m.StartDate <= Value.StartDate && m.EndDate >= Value.StartDate) ?? MonthOptions.First();
        }
    }

    private async Task MonthChangedAsync(ScopedRange range)
    {
        SelectedMonth = range;

        if (ChangeEndDate)
        {
            if (!ChangeLength)
            {
                await ValueChanged.InvokeAsync(new ScopedRange(Value.Scope, range.EndDate, Value.Length));
                return;
            }

            var startDate = Value.StartDate;
            var targetEndDate = range.EndDate;

            if (targetEndDate < startDate)
            {
                await ValueChanged.InvokeAsync(Value);
                return;
            }

            await ValueChanged.InvokeAsync(CreateWithStartAndEnd(Value.Scope, startDate, targetEndDate));
            return;
        }

        if (!ChangeLength)
        {
            await ValueChanged.InvokeAsync(range);
        }
        else
        {
            await ValueChanged.InvokeAsync(CreateWithStartAndEnd(Value.Scope, range.StartDate, Value.EndDate));
        }
    }

    private async Task YearChanged(int year)
    {
        SelectedYear = year;
        MonthOptions = GetMonthRanges.Execute(year).Ranges.ToList();

        var containingDate = ChangeEndDate ? Value.EndDate : Value.StartDate;
        var currentMonthIndex = DateHelper.GetMonthIndex(containingDate);
        var targetStartDate = new DateOnly(year, currentMonthIndex, 1);

        var selectedMonth = MonthOptions.FirstOrDefault(p => p.StartDate <= targetStartDate && p.EndDate >= targetStartDate) ?? MonthOptions.First();
        await MonthChangedAsync(selectedMonth);
    }

    private ScopedRange CreateWithStartAndEnd(BudgetScope scope, DateOnly startDate, DateOnly targetEndDate)
    {
        if (targetEndDate < startDate) return new ScopedRange(scope, startDate, 1);

        int length = 1;
        DateOnly endDate;
        do
        {
            endDate = ScopeHelper.GetRangeEnd(scope, startDate, length);

            if (endDate >= targetEndDate)
            {
                break;
            }

            length++;
        }
        while (length < 10_000);

        return new ScopedRange(scope, startDate, length);
    }

    private static string FormatMonth(ScopedRange range) => range.StartDate.ToString("MMM");
}
                
<HxButtonGroup>
    <HxSelect Label="@MonthLabel"
              Value="SelectedMonth"
              ValueChanged="MonthChangedAsync"
              ValueExpression="() => SelectedMonth"
              Data="MonthOptions"
              TItem="ScopedRange"
              TValue="ScopedRange"
              Nullable="false"
              AutoSort="false"
              TextSelector="m => FormatMonth(m)"
              ValueSelector="m => m" />

    <HxSelect Label="@YearLabel"
              Value="SelectedYear"
              ValueChanged="YearChanged"
              ValueExpression="() => SelectedYear"
              Data="YearOptions"
              TItem="int"
              TValue="int"
              Nullable="false"
              AutoSort="false"
              TextSelector="y => y.ToString()"
              ValueSelector="y => y" />
</HxButtonGroup>