@code
{
    [Parameter] public required ScopedPeriod Value { get; set; }
    [Parameter] public EventCallback<ScopedPeriod> ValueChanged { get; set; }

    [Parameter] public bool ChangeLength { get; set; }
    [Parameter] public bool ChangeEndDate { get; set; }

    [Parameter] public string MonthLabel { get; set; } = "Month";
    [Parameter] public string YearLabel { get; set; } = "Year";

    private IEnumerable<int> YearOptions = [.. Enumerable.Range(DateTime.Today.Year - 3, DateTime.Today.Year + 1)];
    private IEnumerable<ScopedPeriod> MonthOptions = [];

    private int SelectedYear { get; set; }
    private ScopedPeriod SelectedMonth { get; set; } = default!;

    protected override void OnParametersSet()
    {
        if (ChangeEndDate)
        {
            SelectedYear = Value.EndDate.Year;
            MonthOptions = GetMonthPeriods.Execute(SelectedYear).Periods.ToList();
            SelectedMonth = MonthOptions.FirstOrDefault(m => m.StartDate <= Value.EndDate && m.EndDate >= Value.EndDate) ?? MonthOptions.First();
        }
        else
        {
            SelectedYear = Value.StartDate.Year;
            MonthOptions = GetMonthPeriods.Execute(SelectedYear).Periods.ToList();
            SelectedMonth = MonthOptions.FirstOrDefault(m => m.StartDate <= Value.StartDate && m.EndDate >= Value.StartDate) ?? MonthOptions.First();
        }
    }

    private async Task MonthChangedAsync(ScopedPeriod period)
    {
        SelectedMonth = period;

        if (ChangeEndDate)
        {
            if (!ChangeLength)
            {
                await ValueChanged.InvokeAsync(new ScopedPeriod(Value.Scope, period.EndDate, Value.Length));
                return;
            }

            var startDate = Value.StartDate;
            var targetEndDate = period.EndDate;

            if (targetEndDate < startDate)
            {
                await ValueChanged.InvokeAsync(Value);
                return;
            }

            await ValueChanged.InvokeAsync(CreateWithStartAndEnd(Value.Scope, startDate, targetEndDate));
            return;
        }

        if (!ChangeLength)
        {
            await ValueChanged.InvokeAsync(period);
        }
        else
        {
            await ValueChanged.InvokeAsync(CreateWithStartAndEnd(Value.Scope, period.StartDate, Value.EndDate));
        }
    }

    private async Task YearChanged(int year)
    {
        SelectedYear = year;
        MonthOptions = GetMonthPeriods.Execute(year).Periods.ToList();

        var containingDate = ChangeEndDate ? Value.EndDate : Value.StartDate;
        var currentMonthIndex = DateHelper.GetMonthIndex(containingDate);
        var targetStartDate = new DateOnly(year, currentMonthIndex, 1);

        var selectedMonth = MonthOptions.FirstOrDefault(p => p.StartDate <= targetStartDate && p.EndDate >= targetStartDate) ?? MonthOptions.First();
        await MonthChangedAsync(selectedMonth);
    }

    private ScopedPeriod CreateWithStartAndEnd(BudgetScope scope, DateOnly startDate, DateOnly targetEndDate)
    {
        if (targetEndDate < startDate) return new ScopedPeriod(scope, startDate, 1);

        int length = 1;
        DateOnly endDate;
        do
        {
            endDate = scope switch
            {
                BudgetScope.Weekly => startDate.AddDays(7 * length - 1),
                BudgetScope.Fortnightly => startDate.AddDays(14 * length - 1),
                BudgetScope.Monthly => startDate.AddMonths(length).AddDays(-1),
                _ => throw new ArgumentOutOfRangeException(nameof(scope), "Invalid budget scope.")
            };

            if (endDate >= targetEndDate)
            {
                break;
            }

            length++;
        }
        while (length < 10_000);

        return new ScopedPeriod(scope, startDate, length);
    }

    private static string FormatMonth(ScopedPeriod period) => period.StartDate.ToString("MMM");
}
                
<HxButtonGroup>
    <HxSelect Label="@MonthLabel"
              Value="SelectedMonth"
              ValueChanged="MonthChangedAsync"
              ValueExpression="() => SelectedMonth"
              Data="MonthOptions"
              TItem="ScopedPeriod"
              TValue="ScopedPeriod"
              Nullable="false"
              AutoSort="false"
              TextSelector="m => FormatMonth(m)"
              ValueSelector="m => m" />

    <HxSelect Label="@YearLabel"
              Value="SelectedYear"
              ValueChanged="YearChanged"
              ValueExpression="() => SelectedYear"
              Data="YearOptions"
              TItem="int"
              TValue="int"
              Nullable="false"
              AutoSort="false"
              TextSelector="y => y.ToString()"
              ValueSelector="y => y" />
</HxButtonGroup>