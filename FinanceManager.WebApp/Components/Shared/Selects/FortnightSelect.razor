@code
{
    [Parameter] public required ScopedRange Value { get; set; }
    [Parameter] public EventCallback<ScopedRange> ValueChanged { get; set; }

    private IEnumerable<int> YearOptions = [.. Enumerable.Range(DateTime.Today.Year - 3, DateTime.Today.Year + 1)];
    private IEnumerable<ScopedRange> FortnightOptions = [];

    private int SelectedYear { get; set; }

    protected override void OnParametersSet()
    {
        SelectedYear = ISOWeek.GetYear(Value.StartDate.ToDateTime(TimeOnly.MinValue));
        FortnightOptions = GetFortnightRanges.Execute(SelectedYear).Ranges.ToList();
        Value = FortnightOptions.FirstOrDefault(p => p.StartDate <= Value.StartDate && p.EndDate >= Value.StartDate) ?? FortnightOptions.First();
    }

    private async Task FortnightChangedAsync(ScopedRange range) => await ValueChanged.InvokeAsync(range);

    private async Task YearChanged(int year)
    {
        SelectedYear = year;
        FortnightOptions = GetFortnightRanges.Execute(SelectedYear).Ranges.ToList();

        var currentFortnightIndex = DateHelper.GetFortnightIndex(Value.StartDate);
        var targetDateTime = ISOWeek.ToDateTime(year, ((currentFortnightIndex - 1) * 2) + 1, DayOfWeek.Monday);
        var targetDate = DateOnly.FromDateTime(targetDateTime);

        Value = FortnightOptions.FirstOrDefault(p => p.StartDate <= targetDate && p.EndDate >= targetDate) ?? FortnightOptions.First();

        await ValueChanged.InvokeAsync(Value);
    }

    private static string FormatFortnight(ScopedRange range)
    {
        var start = DateHelper.GetFortnightIndex(range.StartDate);
        return $"F{start:00} ({range.StartDate:dd/MM} - {range.EndDate:dd/MM})";
    }
}

