@code {
    [Parameter] public bool IsCreating { get; set; } = false;

    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    [Parameter] public string? CustomActionName { get; set; }

    private string PrimaryActionName => CustomActionName ?? (IsCreating ? "Create" : "Save");
}

<HxButtonGroup CssClass="end">
    @if (OnCancel.HasDelegate)
    {
        <HxButton Color="ThemeColor.Secondary" Text="Cancel" OnClick="OnCancel" />
    }
    @if (OnDelete.HasDelegate && !IsCreating)
    {
        <HxButton Color="ThemeColor.Danger" Text="Delete" OnClick="OnDelete" />
    }
    @if (OnSave.HasDelegate) 
    {
        <HxButton Color="ThemeColor.Primary" Text="@PrimaryActionName" OnClick="OnSave" />
    }
</HxButtonGroup>