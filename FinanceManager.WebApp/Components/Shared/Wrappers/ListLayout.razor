@typeparam TItem where TItem : class

@code {
    [Parameter] public DataGridModel<FilterQuery, TItem> Data { get; set; } = new();

    [Parameter] public RenderFragment AdditionalCommands { get; set; } = default!;
    [Parameter] public RenderFragment<FilterQuery> FilterTemplate { get; set; } = default!;
    [Parameter] public RenderFragment DataTemplate { get; set; } = default!;

    [Parameter] public string SearchPlaceholder { get; set; } = "Search";

    private async Task OnSearchChanged(string value)
    {
        Data.Query.SearchTerm = value ?? string.Empty;
        await Data.UpdateAsync();
    }
}

<div class="list-layout">
    <HxListLayout TFilterModel="FilterQuery" FilterModel="Data.Query" FilterModelChanged="Data.HandleFilterChanged">
        <SearchTemplate>
            <HxSearchBox TItem="string" Placeholder="@SearchPlaceholder" TextQuery="@Data.Query.SearchTerm" TextQueryChanged="OnSearchChanged" MinimumLength="@int.MaxValue" />
        </SearchTemplate>

        <CommandsTemplate>
            <ResposiveDropdown DropdownText="Options">
                <HxButton CssClass="clear-button" Text="Clear filters" Color="ThemeColor.None" OnClick="Data.HandleFilterCleared" />
                @AdditionalCommands
            </ResposiveDropdown>
        </CommandsTemplate>

        <FilterTemplate Context="query">
            @FilterTemplate(query)
        </FilterTemplate>

        <DataTemplate>
            @DataTemplate
        </DataTemplate>
    </HxListLayout>
</div>