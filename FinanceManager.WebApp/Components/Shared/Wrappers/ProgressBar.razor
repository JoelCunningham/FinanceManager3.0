@code {
    [Parameter] public decimal? Proportion { get; set; }
    [Parameter] public bool IsIncome { get; set; }
    [Parameter] public bool ShowLabel { get; set; } = true;

    private string ProportionString => CurrencyUtilities.GetProportionString(Proportion);

    private float Percentage => (float)(Proportion ?? 0) * 100;

    private string UsageStyle => ColourUtilities.GetUsageStyle(Proportion, true, IsIncome);
}

<div class="@("progress-wrapper " + (ShowLabel ? "" : "no-label"))">
    <HxProgress>
        <HxProgressBar Value="Percentage" CssClass="@UsageStyle" />
    </HxProgress>
    @if (ShowLabel)
    {
        <span class="@("category-proportion " + UsageStyle)">
            @ProportionString
        </span>
    }
</div>