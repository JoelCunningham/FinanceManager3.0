@code {
    [Parameter] public decimal? Proportion { get; set; }
    [Parameter] public bool IsIncome { get; set; }

    private decimal ProportionValue => Proportion.HasValue ? Proportion.Value : 0;
    private string ProportionString => ProportionValue == decimal.MaxValue ? "∞ %" : ProportionValue.ToString("P0", CultureInfo.InvariantCulture);

    private float Percentage => (float)ProportionValue * 100;

    private string UsageStyle => ColourUtilities.GetUsageStyle(Proportion, true, IsIncome);
}

<div class="progress-wrapper">
    <HxProgress>
        <HxProgressBar Value="Percentage" CssClass="@UsageStyle" />
    </HxProgress>
    <span class="@("category-proportion " + UsageStyle)">
        @ProportionString
    </span>
</div>