@code {
    [Parameter] public AlertLevel Level { get; set; }
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;

    [Parameter] public string? ActionText { get; set; }
    [Parameter] public string? ActionUrl { get; set; }

    private ThemeColor GetThemeColor()
    {
        return Level switch
        {
            AlertLevel.Info => ThemeColor.Info,
            AlertLevel.Warning => ThemeColor.Warning,
            AlertLevel.Error => ThemeColor.Danger,
            AlertLevel.Success => ThemeColor.Success,
            _ => ThemeColor.Info
        };
    }

    private BootstrapIcon GetIcon()
    {
        return Level switch
        {
            AlertLevel.Info => BootstrapIcon.InfoCircle,
            AlertLevel.Warning => BootstrapIcon.ExclamationTriangle,
            AlertLevel.Error => BootstrapIcon.ExclamationCircle,
            AlertLevel.Success => BootstrapIcon.CheckCircle,
            _ => BootstrapIcon.InfoCircle
        };
    }
}

<HxAlert Color="GetThemeColor()">
    <HxIcon Icon="@GetIcon()" />
    <p>@ChildContent</p>
    @if (ActionUrl is not null && ActionText is not null)
    {
        <a href="@ActionUrl">@ActionText <HxIcon Icon="BootstrapIcon.ArrowRight" /></a>
    }
</HxAlert>