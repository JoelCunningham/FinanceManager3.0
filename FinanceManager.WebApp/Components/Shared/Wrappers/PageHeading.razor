@code {
    [Parameter] public string Heading { get; set; } = default!;
    [Parameter] public string? Subheading { get; set; } = default!;

    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? SubheadingParts { get; set; }

    [Parameter] public bool Centred { get; set; }
    [Parameter] public SubheadingPartsSeperator Seperator { get; set; } = SubheadingPartsSeperator.Dot;

    public enum SubheadingPartsSeperator
    {
        Dot,
        LineBreak
    }
}

<div class="heading-wrapper">
    <h1 class="@("page-heading " + (Centred ? "text-center" : ""))">@Heading</h1>
    <div class="page-subheading">
        @if (Subheading is not null)
        {
            <p>@Subheading</p>
        }
        @if (SubheadingParts is not null)
        {
            <p class="@("parts " + Seperator.ToString().ToLowerInvariant())">@SubheadingParts</p>
        }
    </div>
    <div class="actions">
        @if (Actions is not null)
        {
            <ResposiveDropdown Icon="BootstrapIcon.ThreeDotsVertical">
                @Actions
            </ResposiveDropdown>
        }
    </div>
</div>

