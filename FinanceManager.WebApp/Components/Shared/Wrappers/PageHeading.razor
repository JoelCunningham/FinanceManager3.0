@code {
    [Parameter] public string Heading { get; set; } = default!;
    [Parameter] public string? Subheading { get; set; } = default!;

    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? SubheadingParts { get; set; }
}

<h1 class="page-heading">@Heading</h1>
<div class="page-subheading">
    @if (Subheading is not null)
    {
        <p>@Subheading</p>
    }
    @if (SubheadingParts is not null)
    {
        <p class="parts">@SubheadingParts</p>
    }
    <div class="actions">
        @Actions
    </div>
</div>

