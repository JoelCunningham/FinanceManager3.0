@code {
    [Parameter] public RenderFragment ChildContent { get; set; } = default!;
    [Parameter] public string? DropdownText { get; set; }
    [Parameter] public BootstrapIcon? Icon { get; set; }
}

<div class="d-none d-md-flex content">
    @ChildContent
</div>

<div class="responsive-dropdown d-md-none">
    <HxDropdownButtonGroup class="dropdown-group">
        <HxDropdownToggleButton Icon="Icon" Color="ThemeColor.Primary">@DropdownText</HxDropdownToggleButton>
        <HxDropdownContent>
            @ChildContent
        </HxDropdownContent>
    </HxDropdownButtonGroup>
</div>
