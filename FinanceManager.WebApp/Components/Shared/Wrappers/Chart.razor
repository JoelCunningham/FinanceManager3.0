@implements IAsyncDisposable
@inject IJSRuntime JS

@code {
    [Parameter] public ChartModel ChartModel { get; set; } = default!;

    [JSInvokable] public Task NotifyChartClicked(string? key) => ChartModel.OnDrilldownClickAsync(key);

    private ElementReference _wrapper;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Chart>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>(JsCommands.Import, "./js/EChartsExtentions.js");
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync(JsCommands.AttachClickHandler, _wrapper, _dotNetRef);

        ChartModel.Options.SetTextColor(await ThemeUtilities.GetTextColour(JS));
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        _module = null;
    }
}

<div class="chart-wrapper">
    @if (ChartModel.Options is null)
    {
        <Alert Level="Alert.AlertLevel.Info">There are no transactions or budgets in the selected range.</Alert>
    }
    else
    {
        <h4 class="chart-title">@ChartModel.Title</h4>
        <div class="chart" @ref="_wrapper">
            <HxEChart Options="ChartModel.Options.ToEChartsOptions()" AutoResize="true" />
        </div>
    }
</div>