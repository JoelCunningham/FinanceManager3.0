@implements IAsyncDisposable
@inject IJSRuntime JS
@inject UserState UserState

@code {
    [Parameter] public object? Options { get; set; }
    [Parameter] public string? Title { get; set; }

    [Parameter] public EventCallback<string?> OnItemClick { get; set; }
    [JSInvokable] public Task NotifyChartClicked(string? key) => OnItemClick.InvokeAsync(key);

    private string? TextColour => ThemeUtilities.GetTextColour(UserState.Theme);
    private object? ColouredOptions => ReplaceColourPlaceholder(Options);

    private ElementReference _wrapper;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Chart>? _dotNetRef;

    protected override void OnInitialized()
    {
        UserState.OnThemeChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!OnItemClick.HasDelegate || ColouredOptions is null) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>(JsCommands.Import, "./js/EChartsExtentions.js");
        _dotNetRef ??= DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync(JsCommands.AttachClickHandler, _wrapper, _dotNetRef);
    }

    public async ValueTask DisposeAsync()
    {
        _dotNetRef?.Dispose();
        _dotNetRef = null;
        _module = null;
    }

    private object? ReplaceColourPlaceholder(object? options)
    {
        if (options is null || TextColour is null) return options;

        var json = JsonSerializer.Serialize(options);
        json = json.Replace("\"" + ThemeUtilities.ThemePlaceholder + "\"", JsonSerializer.Serialize(TextColour));
        return JsonSerializer.Deserialize<object>(json);
    }
}

<div class="chart-wrapper">
    @if (Options is null)
    {
        <Alert Level="Alert.AlertLevel.Info">There are no transactions or budgets in the selected range.</Alert>
    }
    else
    {
        <h4 class="chart-title">@Title</h4>
        <div class="chart" @ref="_wrapper">
            <HxEChart Options="ColouredOptions" AutoResize="true" />
        </div>
    }
</div>