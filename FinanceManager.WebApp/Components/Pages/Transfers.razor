@page "/Transactions/Transfers"

@rendermode InteractiveServer

@inject TransferService TransferService;

@code {
    private TransfersPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.Transfers = [.. await TransferService.GetAllAsync()];
    }

    private async Task RemoveTransfer(TransferViewData transfer)
    {
        var success = await TransferService.RemoveTransfer(transfer);

        if (success)
        {
            Model.Transfers.Remove(transfer);
        }
        else
        {
            Model.RemoveError(transfer);
        }
    }
}

<PageTitle>Transfers</PageTitle>

<h1 class="page-heading">Manage transfers</h1>

<TransferActions Filters="Model.Filters" Accounts="Model.UniqueAccounts" MaxAmount="Model.MaxAmount" />

@foreach (var transfer in Model.FilteredAndSortedTransfers)
{
    <TransferRow Transfer="transfer" OnRemove="RemoveTransfer" />
}