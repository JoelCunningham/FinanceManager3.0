@page "/Transactions/Transfers"
@rendermode InteractiveServer
@inject TransferService TransferService

@code {
    private List<string> UniqueAccounts = [];
    private ValidationModel Validation = new();
    private PaginationModel<FilterQuery, TransferSummary> Pagination = new();

    protected override async Task OnInitializedAsync()
    {
        Pagination.FetchPagedResult = TransferService.GetPagedAsync;
        UniqueAccounts = await TransferService.GetUniqueAccountsAsync();

        await Pagination.UpdateResults();
    }

    private async Task RemoveTransfer(TransferSummary transfer)
    {
        try
        {
            await TransferService.ConvertToTransactionAsync(transfer.Id);
            await Pagination.UpdateResults();
        }
        catch (Exception)
        {
            Validation.SetError(transfer.Id, "Could not remove transfer. Please try again.");
        }
    }
}

<PageTitle>Transfers</PageTitle>
<h1 class="page-heading">Manage transfers</h1>

<TransferActions Query="Pagination.Query" Accounts="UniqueAccounts" OnFilterChanged="Pagination.UpdateFilters" OnFilterCleared="Pagination.ClearFilters" />

@if (Pagination.Result.TotalItems > 0)
{
    <div class="mb-3 text-muted">
        Showing @Pagination.Result.StartItem - @Pagination.Result.EndItem of @Pagination.Result.TotalItems transfers
    </div>

    @foreach (var transfer in Pagination.Result.Items)
    {
        <TransferRow Transfer="transfer" OnRemove="RemoveTransfer" />
    }

    <Pagination PagedResult="Pagination.Result" OnPageChanged="Pagination.SetPage" />
}
else
{
    <div class="alert alert-info" role="alert">
        No transfers match your search. Try adjusting the filters.
    </div>
}