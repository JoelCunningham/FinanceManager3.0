@page "/Transactions/Transfers"

@inject TransferService TransferService;

@code {
    private TransfersPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.Transfers = [.. await TransferService.GetAllAsync()];
    }
}

<PageTitle>Transfers</PageTitle>

<h1 class="page-heading">Manage transfers</h1>

@foreach (var transfer in Model.Transfers)
{
    <div class="transfer-row">
        <div>@transfer.From.Bank</div>
        <div>@transfer.From.Account</div>
        <div>@transfer.To.Bank</div>
        <div>@transfer.To.Account</div>
        <div>@transfer.Date.ToShortDateString()</div>
        <div>@transfer.Amount.ToString("C")</div>
        <div>@transfer.Description</div>
        <InputCheckbox @bind-Value="transfer.IsUserCreated" />
    </div>
}