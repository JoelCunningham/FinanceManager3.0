@page "/Transfers"

@inject TransferService TransferService
@inject IHxMessengerService Messenger

@code {
    private TransfersPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.UniqueAccounts = await TransferService.GetUniqueAccountsAsync();
    }

    private async Task<GridDataProviderResult<TransferSummary>> GetGridData(GridDataProviderRequest<TransferSummary> request)
    {
        Model.Query.Page = (request.StartIndex / (request.Count ?? 20)) + 1;
        Model.Query.PageSize = request.Count ?? 20;

        if (request.Sorting is not null && request.Sorting.Any())
        {
            var sort = request.Sorting.First();
            Model.Query.SortDescending = sort.SortDirection == SortDirection.Descending;
            if (Enum.TryParse<TransactionSortBy>(sort.SortString, out var sortBy))
            {
                Model.Query.SortBy = sortBy;
            }
        }

        var result = await TransferService.GetPagedAsync(Model.Query);
        return new GridDataProviderResult<TransferSummary>
        {
            Data = result.Items,
            TotalCount = result.TotalItems
        };
    }

    private async Task SeparateTransfer(TransferSummary transfer)
    {
        try
        {
            await TransferService.ConvertToTransactionAsync(transfer.Id);
            Model.Validation.SetSuccess("Transfer separated successfully.");
            if (Model.Grid != null) await Model.Grid.RefreshDataAsync();
        }
        catch (Exception)
        {
            Model.Validation.SetError("Could not remove transfer. Please try again.");
        }
    }

    private async Task SeparateFromDetails()
    {
        if (Model.SelectedTransfer != null)
        {
            await SeparateTransfer(Model.SelectedTransfer);
            await Model.DetailsModal.HideAsync();
        }
    }
}

<PageTitle>Transfers</PageTitle>

<h1 class="page-heading">Transfers</h1>

<TransfersGrid @ref="Model.Grid" @bind-Query="Model.Query" Accounts="Model.UniqueAccounts" GetGridData="GetGridData" RemoveTransfer="SeparateTransfer" OpenDetails="Model.OpenDetailsModal" />

<HxModal @ref="Model.DetailsModal" Title="Transaction details" Size="ModalSize.Large">
    <BodyTemplate>
        @if (Model.SelectedTransfer is not null)
        {
            <TransferDetails Transfer="Model.SelectedTransfer" />
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Primary" OnClick="SeparateFromDetails">Separate</HxButton>
        <HxButton Color="ThemeColor.Secondary" OnClick="() => Model.DetailsModal.HideAsync()">Return</HxButton>
    </FooterTemplate>
</HxModal>