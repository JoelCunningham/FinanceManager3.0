@page "/Transactions/Transfers"

@rendermode InteractiveServer

@inject TransferService TransferService

@code {
    private TransfersPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTransfersAsync();
        Model.UniqueAccounts = await TransferService.GetUniqueAccountsAsync();
    }

    private async Task LoadTransfersAsync()
    {
        Model.PagedTransfers = await TransferService.GetPagedAsync(Model.Query);
    }

    private async Task RemoveTransfer(TransferSummary transfer)
    {
        try
        {
            await TransferService.ConvertToTransactionAsync(transfer.EntityId);
            await LoadTransfersAsync();
        }
        catch (Exception)
        {
            Model.SetError(transfer);
        }
    }

    private async Task HandlePageChanged(int page)
    {
        Model.SetPage(page);
        await LoadTransfersAsync();
    }

    private async Task HandleFilterChanged()
    {
        Model.UpdateFilters();
        await LoadTransfersAsync();
    }

    private async Task HandleFiltersCleared()
    {
        Model.ClearFilters();
        await LoadTransfersAsync();
    }
}

<PageTitle>Transfers</PageTitle>

<h1 class="page-heading">Manage transfers</h1>

<TransferActions Query="Model.Query"
                 Accounts="Model.UniqueAccounts"
                 OnFilterChanged="HandleFilterChanged"
                 OnFilterCleared="HandleFiltersCleared" />

@if (Model.PagedTransfers.TotalItems > 0)
{
    <div class="mb-3 text-muted">
        Showing @Model.PagedTransfers.StartItem - @Model.PagedTransfers.EndItem of @Model.PagedTransfers.TotalItems transfers
    </div>

    @foreach (var transfer in Model.PagedTransfers.Items)
    {
        <TransferRow Transfer="transfer" OnRemove="RemoveTransfer" />
    }

    <Pagination PagedResult="Model.PagedTransfers" OnPageChanged="HandlePageChanged" />
}
else
{
    <div class="alert alert-info" role="alert">
        No transfers match your search. Try adjusting the filters.
    </div>
}