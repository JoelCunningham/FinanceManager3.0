@page "/Import"

<PageTitle>Import Transactions</PageTitle>

<h1 class="page-heading">Import transactions</h1>

<div class="import-form">
    @if (ShowBankSelection)
    {
        <BankSelectList AvailableParsers="AvailableParsers" @bind-SelectedBank="SelectedParser" @bind-SelectedBank:after="BankChanged" />
    }
    @if (ShowFileUpload)
    {
        <TransactionFileUpload SupportedExtensions="@SupportedExtensions" ValidationModel="Validation" OnFileUploaded="ParseFile" />
    }
    @if (ShowActionButtons)
    {
        <div class="action-buttons">
            <HxButton Color="ThemeColor.Secondary" OnClick="Reset">Cancel</HxButton>
            <HxButton Color="ThemeColor.Info" OnClick="PreviewModal.ShowAsync">Preview</HxButton>
            <HxSubmit Color="ThemeColor.Primary" OnClick="ImportTransactions">Import</HxSubmit>
        </div>
    }
</div>

<PreviewModal @ref="PreviewModal" Transactions="ImportedTransactions" />

<SuccessModal @ref="SuccessModal" Transactions="ImportedTransactions" OnClose="Reset" />