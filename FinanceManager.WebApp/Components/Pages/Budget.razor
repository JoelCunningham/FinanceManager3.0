@page "/Budget"
@inherits PageBase

<PageTitle>Budget</PageTitle>

<h1 class="page-heading">Budget @CurrentYear</h1>

<BudgetActions EntryTypeFilter="EntryTypeFilter"
               EntryTypeFilterChanged="OnEntryTypeFilterChanged"
               EntryTypeFilters="EntryTypeFilters"
               OnPrev="Prev"
               OnToday="Today"
               OnNext="Next"
               OnEditYear="EditYear" />

<BudgetGrid Scope="CurrentBudgetYear?.Scope" Year="CurrentYear" Cells="Cells" OnCellClicked="CreateEntry" OnEntryClicked="EditEntry" OnBudgetCreateClicked="CreateYear" />

<BudgetEntryModal @ref="BudgetEntryModal"
                  Entry="CurrentEntry"
                  CurrentBudgetYear="CurrentBudgetYear"
                  IsEditing="IsEditing"
                  Categories="Categories"
                  OnCancel="CloseEditModal"
                  OnDelete="DeleteEntry"
                  OnSave="SaveEntry" />

<BudgetYearModal @ref="BudgetYearModal"
                 Year="CurrentYear"
                 AvailableScopes="BudgetScopes"
                 IsEditing="IsEditing"
                 OnCreate="(args) => SaveBudget(args.Year, args.Scope)"
                 OnCancel="CloseCreateModal" />