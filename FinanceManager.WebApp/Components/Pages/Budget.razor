@page "/Budget"

<BudgetActions EntryTypeFilter="EntryTypeFilter"
               EntryTypeFilterChanged="OnEntryTypeFilterChanged"
               CurrentPeriod="CurrentPeriod"
               EntryTypeFilters="EntryTypeFilters"
               OnPrev="Prev"
               OnToday="Today"
               OnNext="Next" />

<BudgetGrid Scope="CurrentPeriod?.Scope" Cells="Cells" OnCellClicked="CreateEntry" OnEntryClicked="EditEntry" />

<BudgetEntryModal @ref="_budgetEntryModal"
                  Entry="CurrentEntry"
                  CurrentPeriod="CurrentPeriod"
                  IsEditing="IsEditing"
                  Categories="Categories"
                  OnCancel="CloseEditModal"
                  OnDelete="Delete"
                  OnSave="Save" />
