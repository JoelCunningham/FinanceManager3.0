@page "/Budget"
@inherits PageBase

<PageTitle>Budget</PageTitle>

<h1 class="page-heading">
    Budget @CurrentYear
    <h4>
        @(CurrentBudgetYear is not null ? $"{TotalBudget.ToString("C")} (+ {TotalIncome.ToString("C")} - {TotalExpense.ToString("C")})" : "")
    </h4>
</h1>


<BudgetActions EntryTypeFilter="EntryTypeFilter"
               EntryTypeFilterChanged="OnEntryTypeFilterChanged"
               EntryTypeFilters="EntryTypeFilters"
               HideEmptyCategories="HideEmptyCategories"
               HideEmptyCategoriesChanged="value => HideEmptyCategories = value"
               OnPrev="Prev"
               OnToday="Today"
               OnNext="Next"
               OnEditYear="EditYear" />

<BudgetGrid Scope="CurrentBudgetYear?.Scope"
            Year="CurrentYear"
            Cells="Cells"
            Categories="Categories"
            HideEmptyCategories="HideEmptyCategories"
            OnCellClicked="args => CreateEntry(args.Item1, args.Item2)"
            OnEntryClicked="EditEntry"
            OnBudgetCreateClicked="CreateYear" />

<BudgetEntryModal @ref="BudgetEntryModal"
                  Entry="CurrentEntry"
                  CurrentBudgetYear="CurrentBudgetYear"
                  IsEditing="IsEditing"
                  Categories="Categories"
                  OnCancel="CloseEditModal"
                  OnDelete="DeleteEntry"
                  OnSave="SaveEntry" />

<BudgetYearModal @ref="BudgetYearModal"
                 Year="CurrentYear"
                 AvailableScopes="BudgetScopes"
                 IsEditing="IsEditing"
                 OnSave="args => SaveBudget(args.Year, args.Scope)"
                 OnCancel="CloseCreateModal" />