@page "/Budget"
@inherits PageBase

<PageTitle>Budget</PageTitle>

<h1 class="page-heading">Budget @CurrentYear</h1>

<BudgetActions EntryTypeFilter="EntryTypeFilter"
               EntryTypeFilterChanged="OnEntryTypeFilterChanged"
               EntryTypeFilters="EntryTypeFilters"
               OnPrev="Prev"
               OnToday="Today"
               OnNext="Next" />

<BudgetGrid Scope="CurrentBudgetYear?.Scope" Year="CurrentYear" Cells="Cells" OnCellClicked="CreateEntry" OnEntryClicked="EditEntry" />

<BudgetEntryModal @ref="_budgetEntryModal"
                  Entry="CurrentEntry"
                  CurrentBudgetYear="CurrentBudgetYear"
                  IsEditing="IsEditing"
                  Categories="Categories"
                  OnCancel="CloseEditModal"
                  OnDelete="Delete"
                  OnSave="Save" />
