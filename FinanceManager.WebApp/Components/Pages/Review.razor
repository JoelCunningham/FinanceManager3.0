@page "/Review"

@inject TransactionService TransactionService
@inject CategoryService CategoryService
@inject CategorisationService CategorisationService
@inject IHxMessengerService Messenger

@code {
    private ReviewPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.Validation.Messenger = Messenger;

        Model.Data.GetDataFunc = GetData;
        Model.Data.UpdateViewState = StateHasChanged;

        Model.TransferData.GetDataFunc = GetTransferData;
        Model.ReimburseData.GetDataFunc = GetReimburseData;

        Model.Categories = (await CategoryService.GetCategories()).ToList();
    }

    private async Task<PagedResult<ReviewGroup>> GetData(FilterQuery query)
    {
        query.FilterStatus = ReviewStatus.Unreviewed;
        var result = await TransactionService.GetPagedAsync<ReviewGroup>(query);
        if (Model.IsAutoAssignEnabled) await AutoAssign(result.Items);
        return result;
    }

    private async Task<PagedResult<TransactionSummary>> GetTransferData(FilterQuery query)
    {
        query.FilterAmountMax = -Model.CurrentGroup?.InitalTransaction.Amount;
        query.FilterAmountMin = -Model.CurrentGroup?.InitalTransaction.Amount;
        return await TransactionService.GetPagedAsync<TransactionSummary>(query);
    }

    private async Task<PagedResult<TransactionSummary>> GetReimburseData(FilterQuery query)
    {
        query.FilterStatus = ReviewStatus.Reviewed;
        return await TransactionService.GetPagedAsync<TransactionSummary>(query);
    }

    private async Task SaveGroup(ReviewGroup group, bool showMessage = true)
    {
        if (!Model.ValidateGroup(group)) return;
        try
        {
            await TransactionService.SaveTransactionGroupAsync(group);
            await Model.Data.UpdateAsync();
            if (showMessage)
            {
                Model.Validation.SetSuccess("Transaction saved successfully");
            }
        }
        catch (Exception)
        {
            Model.Validation.SetError("An unexpected error occurred. Please try again");
        }
    }

    private async Task AutoAssign(IEnumerable<ReviewGroup> groups)
    {
        var assignedCount = 0;

        foreach (var group in groups)
        {
            foreach (var transaction in group.Transactions)
            {
                var category = await CategorisationService.SuggestCategory(transaction);
                if (category is not null)
                {
                    transaction.Category = category;
                    transaction.IsAutoCategorised = true;
                    assignedCount++;
                }
            }
        }

        if (assignedCount > 0)
        {
            Model.Validation.SetSuccess($"Auto assigned {assignedCount} transactions");
        }
        else if (Model.IsFirstAutoAssign)
        {
            Model.Validation.SetInfo("Not enough information to assign categories");
            Model.IsFirstAutoAssign = false;
        }
    }
}

<PageTitle>Review Transaction</PageTitle>

<h1 class="page-heading">Review transactions</h1>

<HxAlert Color="ThemeColor.Info">
    <HxIcon Icon="@BootstrapIcon.InfoCircleFill" />
    Review and correct transactions to help the automatic categorisation get smarter and more accurate.
</HxAlert>

@if (Model.Data.Result is not null)
{
    <div class="text-muted d-flex">
        <span class="align-self-end">
            Showing @Model.Data.Result.StartItem - @Model.Data.Result.EndItem of @Model.Data.Result.TotalItems unreviewed transactions
        </span>
        <div class="ms-auto">
            <HxCheckbox @bind-Value="Model.IsAutoAssignEnabled" Text="Auto assign categories" @bind-Value:after="Model.Data.UpdateAsync" />
        </div>
    </div>
}

<HxGrid @ref="Model.Data.Grid" DataProvider="Model.Data.GetGridData" TItem="ReviewGroup" PageSize="Model.Data.Query.PageSize" SelectionEnabled="false" Responsive="false" TableContainerCssClass="grid-invisible">
    <Columns>
        <HxGridColumn>
            <ItemTemplate Context="g">
                <TransactionsReviewGrid TransactionGroup="g"
                                Categories="g.IsIncome ? Model.IncomeCategories : Model.ExpenseCategories"
                                ErrorCategoryIds="Model.Validation.GetValidationItemIds(Model.CategoryKey)"
                                ErrorAmountIds="Model.Validation.GetValidationItemIds(Model.AmountKey)"
                                OnCategoryChange="args => Model.SetCategory(args.Item1, args.Item2)"
                                OnAmountChange="args => Model.SetAmount(g, args.Item1, args.Item2)"
                                OnSave="() => SaveGroup(g)"
                                OnFindTransfer="() => Model.OnFindTransfer(g)"
                                OnFindReimbursement="(t) => Model.OnFindReimbursement(g, t)" />
            </ItemTemplate>
        </HxGridColumn>
    </Columns>
    <EmptyDataTemplate>
        <HxAlert Color="ThemeColor.Success">
            <HxIcon Icon="@BootstrapIcon.CheckCircleFill" />
            You are up to date! All transactions have been reviewed.
        </HxAlert>
    </EmptyDataTemplate>
</HxGrid>

<HxModal @ref="Model.TransferModal" Title="Find transfer" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionsSearchGrid Data="Model.TransferData" Categories="Model.Categories" OnSelect="Model.SetTransfer" IsTransferMode />
    </BodyTemplate>
</HxModal>

<HxModal @ref="Model.ReimburseModal" Title="Find reimbursement" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionsSearchGrid Data="Model.ReimburseData" Categories="Model.Categories" OnSelect="Model.SetReimburse" />
    </BodyTemplate>
</HxModal>