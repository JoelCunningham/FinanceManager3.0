@page "/Review"

<PageTitle>Review Transaction</PageTitle>

<h1 class="page-heading">Review transactions</h1>

<HxAlert Color="ThemeColor.Info">
    <HxIcon Icon="@BootstrapIcon.InfoCircleFill" />
    Review and correct transactions to help the automatic categorisation get smarter and more accurate.
</HxAlert>

@if (Data.HasResults && Data.Result is not null)
{
    <div class="text-muted d-flex">
        <span class="align-self-end">
            Showing @Data.Result.StartItem - @Data.Result.EndItem of @Data.Result.TotalItems unreviewed transactions
        </span>
        <div class="ms-auto">
            <HxCheckbox @bind-Value="IsAutoAssignEnabled" Text="Auto assign categories" @bind-Value:after="Data.UpdateAsync" />
        </div>
    </div>
}

<ListLayout TItem="ReviewGroup" Data="Data">
    <FilterTemplate Context="query">
        <HxInputDate Label="Date from" @bind-Value="query.FilterDateFrom" MaxDate="@((query.FilterDateTo < DateTime.Today) ? query.FilterDateTo.Value : DateTime.Today)" CalendarIcon="BootstrapIcon.Calendar" />
        <HxInputDate Label="Date to" @bind-Value="query.FilterDateTo" MinDate="query.FilterDateFrom" MaxDate="DateTime.Today" CalendarIcon="BootstrapIcon.Calendar" />
        <HxInputNumber Label="Min amount" @bind-Value="query.FilterAmountMin" Type="InputType.Number" Decimals="2" InputGroupStartText="$" step="0.01" max="@query.FilterAmountMax" />
        <HxInputNumber Label="Max amount" @bind-Value="query.FilterAmountMax" Type="InputType.Number" Decimals="2" InputGroupStartText="$" step="0.01" min="@query.FilterAmountMin" />
    </FilterTemplate>

    <DataTemplate>
        <HxGrid @ref="Data.Grid" DataProvider="Data.GetGridData" TItem="ReviewGroup" PageSize="Data.Query.PageSize" SelectionEnabled="false" Responsive="false" TableContainerCssClass="grid-invisible">
            <Columns>
                <HxGridColumn>
                    <ItemTemplate Context="group">
                        <TransactionsReviewRow TransactionGroup="group"
                                                Categories="group.IsIncome ? IncomeCategories : ExpenseCategories"
                                                ErrorCategoryIds="Validation.GetValidationItemIds(CategoryKey)"
                                                ErrorAmountIds="Validation.GetValidationItemIds(AmountKey)"
                                                OnCategoryChange="args => SetCategory(args.Item1, args.Item2)"
                                                OnAmountChange="args => SetAmount(group, args.Item1, args.Item2)"
                                                OnSave="() => SaveGroup(group)"
                                                OnFindTransfer="() => OnFindTransfer(group)"
                                                OnFindReimbursement="(t) => OnFindReimbursement(group, t)" />
                    </ItemTemplate>
                </HxGridColumn>
            </Columns>
            <EmptyDataTemplate>
                <HxAlert Color="ThemeColor.Success">
                    <HxIcon Icon="@BootstrapIcon.CheckCircleFill" />
                    You are up to date! All transactions have been reviewed.
                </HxAlert>
            </EmptyDataTemplate>
        </HxGrid>
    </DataTemplate>
</ListLayout>

<HxModal @ref="TransferModal" Title="Find transfer" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionsSearchGrid Data="TransferData" Categories="Categories" OnSelect="SetTransfer" IsTransferMode />
    </BodyTemplate>
</HxModal>

<HxModal @ref="ReimburseModal" Title="Find reimbursement" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionsSearchGrid Data="ReimburseData" Categories="Categories" OnSelect="SetReimburse" />
    </BodyTemplate>
</HxModal>