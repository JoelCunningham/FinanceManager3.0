@page "/Review"

@inject TransactionService TransactionService
@inject CategoryService CategoryService
@inject CategorisationService CategorisationService
@inject IHxMessengerService Messenger

@code {
    private ReviewPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.Pagination.FetchPagedResult = TransactionService.GetPagedAsync<ReviewGroup>;
        Model.Pagination.AfterFetchPagedResult = OnFetch;

        Model.TransferData.GetGridData = GetTransferData;
        Model.ReimburseData.GetGridData = GetReimburseData;

        Model.Categories = (await CategoryService.GetCategories()).ToList();
        Model.HasMemories = await CategorisationService.HasMemories();

        await Model.Pagination.UpdateResults();
    }

    private async Task<GridDataProviderResult<TransactionSummary>> GetTransferData(GridDataProviderRequest<TransactionSummary> request)
    {
        Model.TransferData.Query.Page = (request.StartIndex / (request.Count ?? 15)) + 1;
        Model.TransferData.Query.PageSize = request.Count ?? 20;
        Model.TransferData.Query.FilterAmountMax = -Model.CurrentGroup?.InitalTransaction.Amount;
        Model.TransferData.Query.FilterAmountMin = -Model.CurrentGroup?.InitalTransaction.Amount;

        if (request.Sorting is not null && request.Sorting.Any())
        {
            var sort = request.Sorting.First();
            Model.TransferData.Query.SortDescending = sort.SortDirection == SortDirection.Descending;
            if (Enum.TryParse<TransactionSortBy>(sort.SortString, out var sortBy))
            {
                Model.TransferData.Query.SortBy = sortBy;
            }
        }

        var result = await TransactionService.GetPagedAsync<TransactionSummary>(Model.TransferData.Query);
        return new GridDataProviderResult<TransactionSummary>
        {
            Data = result.Items.Where(t => t.Id != Model.CurrentGroup?.InitalTransaction.Id),
            TotalCount = result.TotalItems
        };
    }

    private async Task<GridDataProviderResult<TransactionSummary>> GetReimburseData(GridDataProviderRequest<TransactionSummary> request)
    {
        Model.ReimburseData.Query.Page = (request.StartIndex / (request.Count ?? 15)) + 1;
        Model.ReimburseData.Query.PageSize = request.Count ?? 20;
        Model.ReimburseData.Query.FilterStatus = ReviewStatus.Reviewed;

        if (request.Sorting is not null && request.Sorting.Any())
        {
            var sort = request.Sorting.First();
            Model.ReimburseData.Query.SortDescending = sort.SortDirection == SortDirection.Descending;
            if (Enum.TryParse<TransactionSortBy>(sort.SortString, out var sortBy))
            {
                Model.ReimburseData.Query.SortBy = sortBy;
            }
        }

        var result = await TransactionService.GetPagedAsync<TransactionSummary>(Model.ReimburseData.Query);
        return new GridDataProviderResult<TransactionSummary>
        {
            Data = result.Items,
            TotalCount = result.TotalItems
        };
    }

    private async Task OnFetch()
    {
        if (Model.IsAutoAssignmentEnabled)
        {
            await AutoAssign();
        }
    }

    private async Task OnAutoAssignChange()
    {
        if (Model.IsAutoAssignmentEnabled)
        {
            await AutoAssign();
        }
        else
        {
            Model.RevertAutoAssign();
        }
    }

    private async Task SaveGroup(ReviewGroup group, bool showMessage = true)
    {
        if (!Model.ValidateGroup(group)) return;

        try
        {
            await TransactionService.SaveTransactionGroupAsync(group);
            await Model.Pagination.UpdateResults();
            if (showMessage)
            {
                Messenger.AddInformation("Saved transaction successfully");
            }
        }
        catch (Exception)
        {
            Messenger.AddError("An unexpected error occurred. Please try again");
        }
        Model.Clean();
    }

    private async Task AutoAssign()
    {
        if (!Model.Pagination.Result.Items.Any()) return;

        var assignedCount = 0;

        foreach (var group in Model.Pagination.Result.Items)
        {
            foreach (var transaction in group.Transactions)
            {
                var category = await CategorisationService.SuggestCategory(transaction);
                if (category is not null)
                {
                    transaction.Category = category;
                    transaction.AutoCategorised = true;
                    assignedCount++;
                }
            }
        }

        if (assignedCount > 0)
        {
            Messenger.AddInformation($"Auto assigned {assignedCount} transactions");
        }
        else if (Model.IsFirstAutoAssign)
        {
            Messenger.AddInformation("Not enough information to assign categories");
            Model.IsFirstAutoAssign = false;
        }
    }
}

<PageTitle>Review Transaction</PageTitle>

<h1 class="page-heading">Review transactions</h1>

<HxAlert Color="ThemeColor.Info">
    <HxIcon Icon="@BootstrapIcon.InfoCircleFill" />
    Review and correct transactions to help the automatic categorisation get smarter and more accurate.
</HxAlert>

@if (Model.Pagination.Result.TotalItems > 0)
{
    <div class="mb-3 text-muted d-flex">
        <span class="align-self-end">
            Showing @Model.Pagination.Result.StartItem - @Model.Pagination.Result.EndItem of @Model.Pagination.Result.TotalItems unreviewed transactions
        </span>
        <div class="ms-auto">
            <HxCheckbox @bind-Value="Model.IsAutoAssignmentEnabled" Text="Auto assign categories" @bind-Value:after="OnAutoAssignChange" />
        </div>
    </div>

    @foreach (var transactionGroup in Model.Pagination.Result.Items)
    {
        <TransactionRow TransactionGroup="transactionGroup"
                        Categories="transactionGroup.IsIncome ? Model.IncomeCategories : Model.ExpenseCategories"
                        ErrorCategoryIds="Model.Validation.GetValidationItemIds(Model.CategoryKey)"
                        ErrorAmountIds="Model.Validation.GetValidationItemIds(Model.AmountKey)"
                        OnSave="() => SaveGroup(transactionGroup)"
                        OnFindTransfer="() => Model.OnFindTransfer(transactionGroup)"
                        OnFindReimbursement="(t) => Model.OnFindReimbursement(transactionGroup, t)" />
    }

    <HxPager CurrentPageIndex="Model.Pagination.Result.CurrentPage - 1" TotalPages="Model.Pagination.Result.TotalPages" CurrentPageIndexChanged="Model.Pagination.SetPageZeroIndex" />
}
else
{
    <HxAlert Color="ThemeColor.Success">
        <HxIcon Icon="@BootstrapIcon.CheckCircleFill" />
        You are up to date! All transactions have been reviewed.
    </HxAlert>
}

<HxModal @ref="Model.TransferModal" Title="Find transfer" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionSearch Data="Model.TransferData" Categories="Model.Categories" OnSelect="Model.SetTransfer" IsTransferMode />
    </BodyTemplate>
</HxModal>

<HxModal @ref="Model.ReimburseModal" Title="Find reimbursement" Size="ModalSize.ExtraLarge">
    <BodyTemplate>
        <TransactionSearch Data="Model.ReimburseData" Categories="Model.Categories" OnSelect="Model.SetReimburse" />
    </BodyTemplate>
</HxModal>