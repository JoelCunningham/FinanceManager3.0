@page "/Review"
@inherits PageBase

<PageTitle>Review Activities</PageTitle>

<h1 class="page-heading">Review activities</h1>

@if (Data.HasResults && Data.Result is not null && Data.Query?.HasFilters == false)
{
    <Alert Level="AlertLevel.Info">Review and correct activities to help the automatic categorisation get smarter and more accurate.</Alert>
}

@if (Data.HasResults && Data.Result is not null)
{
    <div class="text-muted d-flex mb-2">
        <span class="align-self-end">
            Showing @Data.Result.StartItem - @Data.Result.EndItem of @Data.Result.TotalItems unreviewed activities
        </span>
    </div>
}

<TransactionsReviewGrid Data="Data"
                        Categories="Categories"
                        Validation="Validation"
                        SetCategory="(args) => SetCategory(args.Item1, args.Item2)"
                        SetDate="(args) => SetDate(args.Item1, args.Item2, args.Item3)"
                        SetAmount="(args) => SetAmount(args.Item1, args.Item2, args.Item3)"
                        SaveGroup="(g) => SaveGroup(g)"
                        OnFindTransfer="OnFindTransfer"
                        OnFindReimbursement="(args) => OnFindReimbursement(args.Item1, args.Item2)"
                        @bind-IsAutoAssignEnabled="IsAutoAssignEnabled"
                        @bind-IsAutoAssignEnabled:after="OnIsAutoAssignEnabledChanged" />

<FindTransferModal @ref="TransferModal" TransferData="TransferData" Categories="Categories" SetTransfer="SetTransfer" />

<FindReimburseModal @ref="ReimburseModal" ReimburseData="ReimburseData" Categories="Categories" SetReimburse="SetReimburse" />

@if (!Data.HasResults || Data.Result is null)
{
    if (Data.Query?.HasFilters == true)
    {
        <Alert Level="AlertLevel.Info">No activities found matching the current filters.</Alert>
    }
    else
    {
        <Alert Level="AlertLevel.Success">You're up to date! All activities have been reviewed.</Alert>
    }
}