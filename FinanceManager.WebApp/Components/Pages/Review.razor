@page "/Transactions/Review"
@rendermode InteractiveServer

@inject TransactionService TransactionService
@inject CategoryService CategoryService
@inject CategorisationService CategorisationService

@code {
    private ReviewPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.ReviewPagination.FetchPagedResult = TransactionService.GetPagedAsync<ReviewGroup>;
        Model.ReviewPagination.AfterFetchPagedResult = OnFetch;

        Model.TransferPagination.FetchPagedResult = TransactionService.GetPagedAsync<TransactionSummary>;
        Model.ReimbursePagination.FetchPagedResult = TransactionService.GetPagedAsync<TransactionSummary>;

        Model.Categories = (await CategoryService.GetCategories()).ToList();
        Model.HasMemories = await CategorisationService.HasMemories();

        await Model.ReviewPagination.UpdateResults();
    }

    private async Task OnFetch()
    {
        if (Model.IsAutoAssignmentEnabled)
        {
            await AutoAssign();
        }
    }

    private async Task SaveGroup(ReviewGroup group, bool showMessage = true)
    {
        if (!Model.ValidateGroup(group)) return;

        try
        {
            await TransactionService.SaveTransactionGroupAsync(group);
            await Model.ReviewPagination.UpdateResults();
            if (showMessage)
            {
                Model.Validation.SetValidationState(ValidationType.Success, $"Saved transaction successfully");
            }
        }
        catch (Exception)
        {
            Model.Validation.SetValidationState(ValidationType.Error, "An unexpected error occurred. Please try again");
        }
        Model.Clean();
    }

    private async Task AutoAssign()
    {
        var assignedCount = 0;

        foreach (var group in Model.ReviewPagination.Result.Items)
        {
            foreach (var transaction in group.Transactions)
            {
                var category = await CategorisationService.SuggestCategory(transaction);
                if (category is not null)
                {
                    transaction.Category = category;
                    transaction.AutoCategorised = true;
                    assignedCount++;
                }
            }
        }

        if (assignedCount > 0)
        {
            Model.Validation.SetValidationState(ValidationType.Success, $"Auto assigned {assignedCount} transactions");
        }
        else
        {
            Model.Validation.SetValidationState(ValidationType.Info, "Not enough information to assign categories");
        }
    }

    private void UnAutoAssign()
    {
        var unassignedCount = 0;

        foreach (var group in Model.ReviewPagination.Result.Items)
        {
            foreach (var transaction in group.Transactions)
            {
                if (transaction.AutoCategorised)
                {
                    transaction.Category = null;
                    transaction.AutoCategorised = false;
                    unassignedCount++;
                }
            }
        }

        if (unassignedCount > 0)
        {
            Model.Validation.SetValidationState(ValidationType.Success, $"Reverted {unassignedCount} assignments");
        }
    }

    private async Task HandleAutoAssignChange()
    {
        if (Model.IsAutoAssignmentEnabled)
        {
            await AutoAssign();
        }
        else
        {
            UnAutoAssign();
        }
    }
}

<PageTitle>Review Transaction</PageTitle>

<Popup Type="Model.Validation.Type" Message="@Model.Validation.ValidationMessage" IsVisible="Model.Validation.HasState" OnClose="Model.Validation.ClearValidation" />

<h1 class="page-heading">Review transactions</h1>

@if (!Model.HasMemories)
{
    <div class="alert alert-info" role="alert">Review and correct transactions to help the automatic categorisation get smarter and more accurate.</div>
}

@if (Model.ReviewPagination.Result.TotalItems > 0)
{
    <div class="mb-3 text-muted d-flex align-bottom">
        <span class="align-self-end">
            Showing @Model.ReviewPagination.Result.StartItem -
            @Model.ReviewPagination.Result.EndItem of
            @Model.ReviewPagination.Result.TotalItems unreviewed transactions
        </span>
        <div class="ms-auto">
            <AutoAssignCheckbox @bind-IsChecked="Model.IsAutoAssignmentEnabled" @bind-IsChecked:after="HandleAutoAssignChange" />
        </div>
    </div>

    @foreach (var transactionGroup in Model.ReviewPagination.Result.Items)
    {
        <TransactionRow TransactionGroup="transactionGroup"
                        Categories="transactionGroup.IsIncome ? Model.IncomeCategories : Model.ExpenseCategories"
                        ErrorCategoryIds="Model.Validation.GetValidationItemIds(Model.CategoryKey)"
                        ErrorAmountIds="Model.Validation.GetValidationItemIds(Model.AmountKey)"
                        OnSave="() => SaveGroup(transactionGroup)"
                        OnFindTransfer="() => Model.OnFindTransfer(transactionGroup)"
                        OnFindReimbursement="(t) => Model.OnFindReimbursement(transactionGroup, t)" />
    }

    <Pagination PagedResult="Model.ReviewPagination.Result" OnPageChanged="Model.ReviewPagination.SetPage" />
}
else
{
    <div class="alert alert-success" role="alert">
        <i class="bi bi-check-circle"></i> All transactions have been reviewed!
    </div>
}

@if (Model.IsTransferSearchOpen && Model.CurrentGroup is not null)
{
    <Modal Title="Find transfer" OnClose="Model.EndFindTransfer">
        <BodyContent>
            <TransactionSearchActions Filters="Model.TransferPagination.Query" Categories="Model.Categories" OnFilterChanged="Model.TransferPagination.UpdateResults" />

            @if (Model.TransferPagination.Result.TotalItems > 0)
            {
                <div class="mb-2 text-muted small">
                    Showing @Model.TransferPagination.Result.StartItem - @Model.TransferPagination.Result.EndItem of @Model.TransferPagination.Result.TotalItems transactions
                </div>

                <TransactionSearchResults Transactions="Model.TransferPagination.Result.Items" OnSelect="Model.SetTransfer" />

                <Pagination PagedResult="Model.TransferPagination.Result" OnPageChanged="Model.TransferPagination.SetPage" />
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No matching transactions found. Try adjusting the filters.
                </div>
            }
        </BodyContent>
    </Modal>
}

@if (Model.IsReimburseSearchOpen && Model.CurrentTransaction is not null)
{
    <Modal Title="Find reimbursement" OnClose="Model.EndFindReimbursement">
        <BodyContent>
            <TransactionSearchActions Filters="Model.ReimbursePagination.Query" Categories="Model.Categories" OnFilterChanged="Model.ReimbursePagination.UpdateResults" />

            @if (Model.ReimbursePagination.Result.TotalItems > 0)
            {
                <div class="mb-2 text-muted small">
                    Showing @Model.ReimbursePagination.Result.StartItem - @Model.ReimbursePagination.Result.EndItem of @Model.ReimbursePagination.Result.TotalItems transactions
                </div>

                <TransactionSearchResults Transactions="Model.ReimbursePagination.Result.Items" OnSelect="Model.SetReimbursement" />

                <Pagination PagedResult="Model.ReimbursePagination.Result" OnPageChanged="Model.ReimbursePagination.SetPage" />
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No matching transactions found. Try adjusting the filters.
                </div>
            }
        </BodyContent>
    </Modal>
}