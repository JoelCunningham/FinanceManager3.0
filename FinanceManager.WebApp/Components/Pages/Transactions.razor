@page "/Transactions"

<PageTitle>Transactions</PageTitle>

<h1 class="page-heading">Transactions</h1>

<div class="transaction-graph">
    <HxTabPanel>
        <HxTab Title="Spend by cateogry">
            <Content>
                @if (GreatestScopeInPeriod > Chart2.Scope)
                {
                    <HxAlert Color="ThemeColor.Info">
                        This @ScopeToText(Chart2.Scope) has budgets with larger scopes.
                        They will be averaged across the @ScopeToText(Chart2.Scope)
                    </HxAlert>
                }
                <Graph2Actions AvailableMonths="AvailableMonths" Chart="Chart2" @bind-Period="Chart2Period" />
                <Chart Options="Chart2.Options" OnItemClick="Chart2.OnDrilldownClickAsync" />
            </Content>
        </HxTab>

        <HxTab Title="Spend over time">
            <Content>
                <Graph1Actions AvailableMonths="AvailableMonths" Chart="Chart1" @bind-MonthFrom="Chart1MonthFrom" @bind-MonthTo="Chart1MonthTo" />
                <Chart Options="Chart1.Options" OnItemClick="Chart1.OnDrilldownClickAsync" />
            </Content>
        </HxTab>

        <HxTab Title="Chart 3">
            <Content>This is the third tab.</Content>
        </HxTab>
    </HxTabPanel>
</div>