@page "/Transactions"

<PageTitle>Transactions</PageTitle>

<h1 class="page-heading">Transactions</h1>

<div class="transaction-graph">
    <HxTabPanel>
        <HxTab Title="Spend over time">
            <Content>
                <GraphActions AvailableMonths="AvailableMonths"
                              @bind-MonthFrom="MonthFrom"
                              @bind-MonthTo="MonthTo"
                              @bind-Mode="Chart1Mode"
                              IsGroupLevel="Chart1DrilldownGroupId is not null"
                              ResetLevelAsync="ClearChart1DrilldownAsync"
                              ReloadAsync="ReloadAsync" />
                <Chart Options="Chart1Options" OnItemClick="OnChart1ItemClickedAsync" />
            </Content>
        </HxTab>

        <HxTab Title="Spend by cateogry">
            <Content>
                <GroupBudgetActions AvailableMonths="AvailableMonths"
                                    @bind-Period="Chart2Period"
                                    @bind-Mode="Chart2Mode"
                                    IsGroupLevel="Chart2DrilldownGroupId is not null"
                                    ResetLevelAsync="ClearChart2DrilldownAsync"
                                    ReloadAsync="ReloadChart2Async" />
                <Chart Options="Chart2Options" OnItemClick="OnChart2ItemClickedAsync" />
            </Content>
        </HxTab>

        <HxTab Title="Chart 3">
            <Content>This is the third tab.</Content>
        </HxTab>
    </HxTabPanel>
</div>