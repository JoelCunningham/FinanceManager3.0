@page "/Transactions"

<PageTitle>Transactions</PageTitle>

<h1 class="page-heading">Transactions</h1>

<div class="transaction-graph">
    <HxAlert Color="ThemeColor.Info">
        Transactions by category over time (monthly).
    </HxAlert>

    <GraphActions AvailableMonths="AvailableMonths"
                  @bind-MonthFrom="MonthFrom"
                  @bind-MonthTo="MonthTo"
                  @bind-Mode="Mode"
                  ReloadAsync="ReloadAsync" />

    <Chart Options="ChartOption" />
</div>

