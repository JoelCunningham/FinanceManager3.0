@page "/Categories"

<PageTitle>Categories</PageTitle>

<h1 class="page-heading">Category groups</h1>

<CategoryGroupActions SearchQuery="@GroupSearch" SearchQueryChanged="OnGroupSearchChanged" />

@if (!FilteredGroups.Any())
{
    <div class="alert alert-light border mb-0">
        No groups match your search.
    </div>
}
else
{
    <CategoryCards Title="Income groups" Groups="IncomeGroups" />
    <CategoryCards Title="Expense groups" Groups="ExpenseGroups" />
}
