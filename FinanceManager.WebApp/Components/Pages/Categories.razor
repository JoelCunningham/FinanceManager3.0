@page "/Categories"
@inherits PageBase

<PageTitle>Categories</PageTitle>

@if (CurrentGroup is null || !CategoryGroups.Contains(CurrentGroup))
{
    <h1 class="page-heading">Categories</h1>

    <CategoryGroupActions SearchQuery="@GroupSearch"
                          GroupMode="@GroupMode"
                          SearchQueryChanged="OnGroupSearchChanged"
                          GroupModeChanged="OnGroupModeChanged"
                          OnCreate="OpenGroupCreateModal" />
    <CategoryCards Groups="FilteredGroups" OnGroupClicked="OpenGroupPanel" />
}
else
{
    <CategoryGroupPanel Group="CurrentGroup" Categories="SelectedGroupCategories" OnEdit="OpenGroupEditModal" OnClose="CloseGroupPanel" OnCategoryCreate="OpenCategoryCreateModal" OnCategoryEdit="OpenCategoryEditModal" />
}

<CategoryModal @ref="CategoryModal" IsEditing="IsEditing" Category="CurrentCategory" OnSave="OnCategorySave" OnCancel="CloseCategoryModal" />
<CategoryGroupModal @ref="GroupModal" IsEditing="IsEditing" Group="CurrentGroup" OnSave="OnGroupSave" OnCancel="CloseGroupModal" />