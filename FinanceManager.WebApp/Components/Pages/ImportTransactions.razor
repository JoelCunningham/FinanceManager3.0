@page "/import"

@rendermode InteractiveServer

@inject TransactionImportService ImportService
@inject TransactionParserService ParserService

@code {
    private string? selectedParser;
    private IReadOnlyList<ParserInfo>? availableParsers;
    private IReadOnlyList<BankRecord>? importedTransactions;

    protected override void OnInitialized()
    {
        availableParsers = ParserService.GetAvailableParsers();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (selectedParser is null) return;

        var fileExtension = Path.GetExtension(e.File.Name);
        await using var stream = e.File.OpenReadStream();

        try
        {
            importedTransactions = (await ImportService.ImportBankRecordsAsync(stream, selectedParser, fileExtension)).ToList();
        }
        catch (Exception)
        {
            importedTransactions = Array.Empty<BankRecord>();
        }
    }

    private bool SelectedParserHasExtensions(out IReadOnlyList<string>? extensions)
    {
        extensions = availableParsers?.FirstOrDefault(p => p.BankName == selectedParser)?.SupportedExtensions;
        return extensions is not null;
    }

    private string FormatExtensionsList(IReadOnlyList<string> extensions)
    {
        if (extensions.Count <= 1)
        {
            return extensions.FirstOrDefault() ?? string.Empty;
        }
        else
        {
            return string.Join(", ", extensions.Take(extensions.Count - 1)) + ", and " + extensions.Last();
        }
    }
}

<PageTitle>Import Transactions</PageTitle>

@if (availableParsers is not null && availableParsers.Any())
{
    <InputRadioGroup @bind-Value="selectedParser">
        @foreach (var parser in availableParsers)
        {
            <div class="form-check">
                <InputRadio Value="@parser.BankName" class="form-check-input" />
                <label class="form-check-label">@parser.BankName</label>
            </div>
        }
    </InputRadioGroup>
}

@if (SelectedParserHasExtensions(out var availableExtensions) && availableExtensions is not null)
{
    <InputFile OnChange="OnFileSelected" accept="@string.Join(',', availableExtensions)" class="form-control" />
    <label class="form-label fst-italic">Supports: @FormatExtensionsList(availableExtensions) files</label>
}

@if (importedTransactions is not null && importedTransactions.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in importedTransactions)
            {
                <tr>
                    <td>@transaction.Date.ToShortDateString()</td>
                    <td>@transaction.Narrative</td>
                    <td>@(transaction.CreditAmount + transaction.DebitAmount * -1)</td>
                </tr>
            }
        </tbody>
    </table>
}
