@page "/import"

@rendermode InteractiveServer

@inject TransactionImportService ImportService

@code {
    private ParserInfo? selectedParser;
    private IReadOnlyList<BankRecord>? importedTransactions;
    private string? importErrorMessage;

    private async Task ImportFileTransactions(IBrowserFile file)
    {
        importErrorMessage = null;
        importedTransactions = null;
        
        if (selectedParser is null) return;

        var fileExtension = Path.GetExtension(file.Name);
        await using var stream = file.OpenReadStream();
        try
        {
            importedTransactions = (await ImportService.ImportBankRecordsAsync(stream, selectedParser.BankName, fileExtension)).ToList();
        }
        catch (Exception)
        {
            importErrorMessage = "Unable to import transactions from this file. Please check it is correct.";
        }
    }
}

<PageTitle>Import Transactions</PageTitle>

<BankSelectComponent @bind-SelectedParser="selectedParser" />

<FileUploadComponent SelectedParser="@selectedParser" ImportErrorMessage="@importErrorMessage" OnFileImport="ImportFileTransactions" />

<TableComponent Transactions="@importedTransactions" />
