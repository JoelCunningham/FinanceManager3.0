@page "/import"

@rendermode InteractiveServer

@inject TransactionImportService ImportService

@code {
    private ImportPageModel Model = new();

    private async Task ImportFileTransactions(IBrowserFile file)
    {
        if (Model.SelectedBank is null) return;

        try
        {
            await using var stream = file.OpenReadStream();
            var bankName = Model.SelectedBank.BankName;
            var fileExtension = Path.GetExtension(file.Name);

            var results = await ImportService.ImportAsync(stream, bankName, fileExtension);
            Model.Success(results);
        }
        catch (Exception exception)
        {
            Model.Error(exception);
        }
    }

    private void OnBankChanged(ParserInfo? parser)
    {
        Model.Reset();
        Model.SelectedBank = parser;
    }

    private void OnContinue()
    {
        Model.FileValidation = FileValidationState.Accepted;
    }
}

<PageTitle>Import Transactions</PageTitle>

<h1 class="page-heading">Import transactions</h1>

@if (Model.FileValidation != FileValidationState.Accepted)
{
    <BankSelectComponent SelectedBank="Model.SelectedBank" OnBankChange="OnBankChanged" />

    <FileUploadComponent SelectedBank="@Model.SelectedBank" ValidationState="@Model.FileValidation" ImportErrorMessage="@Model.ImportErrorMessage" OnFileImport="ImportFileTransactions" @key="Model.SelectedBank?.BankName" />

    @if (Model.FileValidation == FileValidationState.Valid)
    {
        <button type="button" class="btn btn-primary my-3" @onclick="OnContinue">Continue</button>
    }
}
else
{
    <TableComponent Transactions="@Model.ImportedTransactions" />
}