@page "/import"

@rendermode InteractiveServer

@inject ImportService ImportService

@code {
    private string? selectedParser;
    private IReadOnlyList<ParserDescription>? availableParsers;
    private IReadOnlyList<BankRecord>? importedTransactions;

    protected override void OnInitialized()
    {
        availableParsers = ImportService.GetAvailableParsers().ToList();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (selectedParser is null)
            return;

        await using var stream = e.File.OpenReadStream();
        importedTransactions = (await ImportService.ImportBankRecordsAsync(stream, selectedParser)).ToList();
    }

    protected string GetSupportedFileExtentions()
    {
        return availableParsers?.FirstOrDefault(p => p.Name == selectedParser)?.FileTypes ?? string.Empty;
    }
}

<PageTitle>Import Transactions</PageTitle>

@if (availableParsers is not null && availableParsers.Any())
{
    <InputRadioGroup @bind-Value="selectedParser">
        @foreach (var parser in availableParsers)
        {
            <div class="form-check">
                <InputRadio Value="@parser.Name" class="form-check-input" />
                <label class="form-check-label">@parser.Name</label>
            </div>
        }
    </InputRadioGroup>
}

@if (selectedParser is not null)
{
    <InputFile OnChange="OnFileSelected" accept="@GetSupportedFileExtentions()" class="form-control" />
}

@if (importedTransactions is not null && importedTransactions.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var transaction in importedTransactions)
            {
                <tr>
                    <td>@transaction.Date.ToShortDateString()</td>
                    <td>@transaction.Narrative</td>
                    <td>@(transaction.CreditAmount + transaction.DebitAmount * -1)</td>
                </tr>
            }
        </tbody>
    </table>
}
