@page "/import"

@rendermode InteractiveServer

@inject TransactionImportService ImportService

@code {
    private ImportPageModel Model = new();
    private bool HasProgress => Model.MaxStageReached != ImportStage.FileUpload;

    private async Task ImportFileTransactions(IBrowserFile file)
    {
        if (Model.SelectedBank is null) return;

        try
        {
            await using var stream = file.OpenReadStream();
            var bankName = Model.SelectedBank.BankName;
            var fileExtension = Path.GetExtension(file.Name);

            var results = await ImportService.ImportAsync(stream, bankName, fileExtension);
            Model.ImportSuccess(results);
        }
        catch (Exception exception)
        {
            Model.ImportError(exception);
        }
    }

    private void OnBankChanged(ParserInfo? parser)
    {
        Model.Reset();
        Model.SelectedBank = parser;
    }

    private void OnStageChange(ImportStage stage)
    {
        Model.GoToStage(stage);
    }

    private void StageTransaction(ImportedTransaction transaction)
    {
        Model.CustomisedTransactions.Add(transaction);
    }
}

<PageTitle>Import Transactions</PageTitle>

<h1 class="page-heading">Import transactions</h1>

<BreadcrumbComponent CurrentStage="Model.CurrentStage" MaxStageReached="Model.MaxStageReached" OnStageChange="OnStageChange" />

<div class="@(Model.CurrentStage == ImportStage.FileUpload ? "" : "d-none")">
    <BankSelectComponent SelectedBank="Model.SelectedBank" OnBankChange="OnBankChanged" HasProgress="HasProgress" />
    <FileUploadComponent SelectedBank="@Model.SelectedBank" ValidationState="@Model.FileValidation" ImportErrorMessage="@Model.ImportErrorMessage" OnFileImport="ImportFileTransactions" />
</div>

<div class="@(Model.CurrentStage == ImportStage.ConfigureTransactions ? "" : "d-none")">
    <h2 class="section-heading">We detected some transfers:</h2>
    <TransferGrid Transactions="Model.ImportedTransactions" AcceptTransfer="StageTransaction" />
</div>

<div class="@(Model.CurrentStage == ImportStage.ConfigureReimbursements ? "" : "d-none")">
    <h2 class="section-heading">These look like reimbursements:</h2>
    @* Add *@
</div>

<div class="@(Model.CurrentStage == ImportStage.CategorizeTransactions ? "" : "d-none")">
    <h2 class="section-heading">Categorize your transactions:</h2>
    @* Add categorization component here *@
</div>

<div class="wizard-navigation">
    @if (Model.CanDecrementStage)
    {
        <button type="button" class="btn btn-secondary my-3" @onclick="Model.PreviousStage">Back</button>
    }
    
    @if (Model.CanIncrementStage)
    {
        <button type="button" class="btn btn-primary my-3" @onclick="Model.NextStage">
            @(Model.CurrentStage == ImportStage.CategorizeTransactions ? "Finish" : "Continue")
        </button>
    }
</div>