@page "/import"

@rendermode InteractiveServer

@inject TransactionImportService ImportService
@inject TransactionParserService ParserService

@code {
    private string? selectedParserName;
    private IReadOnlyDictionary<string, IEnumerable<string>>? availableParsers;
    private IReadOnlyList<BankRecord>? importedTransactions;

    protected override void OnInitialized()
    {
        availableParsers = ParserService.GetParserDetails().ToDictionary();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (selectedParserName is null) return;

        var fileExtension = Path.GetExtension(e.File.Name);
        await using var stream = e.File.OpenReadStream();

        importedTransactions = (await ImportService.ImportBankRecordsAsync(stream, selectedParserName, fileExtension)).ToList();
    }

    protected string GetSupportedFileExtentions()
    {
        var selectedParser = availableParsers?.FirstOrDefault(p => p.Key == selectedParserName);
        return string.Join(',', selectedParser?.Value ?? Enumerable.Empty<string>());
    }
}

<PageTitle>Import Transactions</PageTitle>

@if (availableParsers is not null && availableParsers.Any())
{
    <InputRadioGroup @bind-Value="selectedParserName">
        @foreach (var parser in availableParsers)
        {
            <div class="form-check">
                <InputRadio Value="@parser.Key" class="form-check-input" />
                <label class="form-check-label">@parser.Key</label>
            </div>
        }
    </InputRadioGroup>
}

@if (selectedParserName is not null)
{
    <InputFile OnChange="OnFileSelected" accept="@GetSupportedFileExtentions()" class="form-control" />
}

@if (importedTransactions is not null && importedTransactions.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Description</th>
                <th>Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var transaction in importedTransactions)
            {
                <tr>
                    <td>@transaction.Date.ToShortDateString()</td>
                    <td>@transaction.Narrative</td>
                    <td>@(transaction.CreditAmount + transaction.DebitAmount * -1)</td>
                </tr>
            }
        </tbody>
    </table>
}
