@page "/Import"

@rendermode InteractiveServer

@inject TransactionImportService ImportService

@code {
    private ImportPageModel Model = new();


    private async Task ImportFileTransactions(IBrowserFile file)
    {
        if (Model.SelectedBank is null) return;

        try
        {
            await using var stream = file.OpenReadStream();
            var bankName = Model.SelectedBank.BankName;
            var fileExtension = Path.GetExtension(file.Name);

            var results = await ImportService.ImportAsync(stream, bankName, fileExtension);

            if (results.ToList().Count == 0)
            {
                Model.NoTransactionsFound();
                return;
            }

            Model.Success(results);
        }
        catch (Exception exception)
        {
            Model.Error(exception);
        }
    }

    private async Task SaveImportedTransactions()
    {
        if (Model.ImportedTransactions is null) return;

        await ImportService.SaveAsync(Model.ImportedTransactions);
    }
}

<PageTitle>Import Transactions</PageTitle>

<h1 class="page-heading">Import transactions</h1>

<BankSelectList SelectedBank="Model.SelectedBank" OnBankChange="Model.BankChanged" />

@if (Model.SelectedBank is not null)
{
    <TransactionFileUpload SupportedExtensions="@Model.SupportedExtensions" ErrorMessage="@Model.UploadErrorMessage" ValidationState="Model.UploadValidationState" OnFileUploaded="ImportFileTransactions" />
}
@if (Model.ImportedTransactions is not null)
{
    <ImportActions TransactionCount="Model.ImportedTransactions.Count" OnSubmit="SaveImportedTransactions" OnPreview="Model.ShowPreview" OnCancel="Model.Reset" />
}
@if (Model.IsPreviewOpen && Model.ImportedTransactions is not null)
{
    <Modal Title="Preview transactions" OnClose="Model.ClosePreview">
        <TransactionsPreview Transactions="Model.ImportedTransactions" />
    </Modal>
}