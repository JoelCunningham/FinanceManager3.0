<PageHeading Heading="You've taken a wrong turn" Centred="true" />

<div class="textblock wide">
    <p class="text-center">
        The page you're looking for doesn't exist or has been moved. Try heading back to the dashboard, or use the navigation on the left.
    </p>
</div>

<HxButton OnClick="@(() => Navigation.NavigateTo(Pages.Dashboard))" Color="ThemeColor.Primary">
    Go to dashboard
</HxButton>

<HxButton OnClick="@(() => JS.InvokeVoidAsync(JsCommands.HistoryBack))" Color="ThemeColor.Light">
    Go back
</HxButton>