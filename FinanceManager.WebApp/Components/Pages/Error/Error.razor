<PageHeading Heading="We hit an unexpected error" Centred="true" />

<div class="textblock wide">
    <p class="text-center">
        Something went wrong on our end. Your data is safe — this is a temporary problem. Try refreshing the page, or come back in a moment.
    </p>
</div>

<HxButton OnClick="@(() => Navigation.NavigateTo(Pages.Dashboard))" Color="ThemeColor.Primary">
    Go to dashboard
</HxButton>

<HxButton OnClick="@(() => JS.InvokeVoidAsync(JsCommands.LocationReload))" Color="ThemeColor.Light">
    Try again
</HxButton>