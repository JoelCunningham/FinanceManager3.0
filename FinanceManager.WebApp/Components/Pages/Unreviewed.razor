@page "/Transactions/Uncategorised"

@rendermode InteractiveServer

@inject TransactionService TransactionService;
@inject CategoryService CategoryService;

@code {
    private IEnumerable<UnreviewedTransaction> uncategorised = [];

    private IEnumerable<Category> categories = [];

    protected override async Task OnInitializedAsync()
    {
        uncategorised = await TransactionService.GetUnreviewedAsync();
        categories = CategoryService.GetCategories();
    }
}

<PageTitle>Uncategorised Transactions</PageTitle>

<h1 class="page-heading">Categorise transactions</h1>

@foreach (var group in uncategorised)
{
    <TransactionRow TransactionGroup="group" Categories="categories" />
}