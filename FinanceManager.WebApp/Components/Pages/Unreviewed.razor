@page "/Transactions/Uncategorised"

@rendermode InteractiveServer

@inject TransactionService TransactionService;
@inject CategoryService CategoryService;

@code {
    private UnreviewedPageModel Model = new();

    protected override async Task OnInitializedAsync()
    {
        Model.UnreviewedGroups = (await TransactionService.GetUnreviewedAsync()).ToList();
        Model.Categories = CategoryService.GetCategories().ToList();
        Model.AllTransactions = (await TransactionService.SearchAsync(string.Empty)).ToList();
        // Add pagination
    }

    private async Task SetReimbursement(TransactionSummary transaction)
    {
        if (Model.CurrentTransaction is null) return;

        Model.CurrentTransaction.Reimburses = transaction;
        Model.Clean();
    }

    private async Task SetTransfer(TransactionSummary transaction)
    {
        if (Model.CurrentGroup is null) return;

        Model.CurrentGroup.Transfers = transaction;
        Model.Clean();
    }

    private async Task SaveGroup(ReviewGroup group)
    {
        if (group.Transactions.Any(t => t.Category is null) && group.Transfers is null)
        {
            // TODO highlight field
            return;
        }
        if (group.Transactions.Any(t => t.Amount == 0))
        {
            // TODO highlight field
            return;
        }

        try
        {
            await TransactionService.SaveTransactionGroupAsync(group);
            Model.UnreviewedGroups.Remove(group);
        }
        catch (Exception)
        {
            // TODO show error message?
        }
        Model.Clean();
    }

    private void OnFindReimbursement(ReviewGroup group, ReviewTransaction transaction)
    {
        Model.CurrentGroup = group;
        Model.CurrentTransaction = transaction;
        Model.IsReimbursementSearchOpen = true;
    }

    private void OnFindTransfer(ReviewGroup group)
    {
        Model.CurrentGroup = group;
        Model.IsTransferSearchOpen = true;
    }

    private void EndFindReimbursement()
    {
        Model.IsReimbursementSearchOpen = false;
        Model.Filters.ClearFilters();
    }

    private void EndFindTransfer()
    {
        Model.IsTransferSearchOpen = false;
        Model.Filters.ClearFilters();
    }
}

<PageTitle>Uncategorised Transactions</PageTitle>

<h1 class="page-heading">Categorise transactions</h1>

@foreach (var transactionGroup in Model.UnreviewedGroups)
{
    <TransactionRow TransactionGroup="transactionGroup"
                    Categories="Model.Categories"
                    OnSave="() => SaveGroup(transactionGroup)"
                    OnFindTransfer="() => OnFindTransfer(transactionGroup)"
                    OnFindReimbursement="(t) => OnFindReimbursement(transactionGroup, t)" />
}

@if (Model.IsTransferSearchOpen && Model.CurrentGroup is not null)
{
    <Modal Title="Find transfer" OnClose="EndFindTransfer">
        <BodyContent>
            <TransactionActions Filters="Model.Filters" Categories="Model.Categories" OnFilterChanged="StateHasChanged" />
            <TransactionSearch FilteredTransactions="Model.PotentialTransfers" OnSelect="SetTransfer" />
        </BodyContent>
    </Modal>
}

@if (Model.IsReimbursementSearchOpen && Model.CurrentTransaction is not null)
{
    <Modal Title="Find reimbursement" OnClose="EndFindReimbursement">
        <BodyContent>
            <TransactionActions Filters="Model.Filters" Categories="Model.Categories" OnFilterChanged="StateHasChanged" />
            <TransactionSearch FilteredTransactions="Model.PotentialReimbursements" OnSelect="SetReimbursement" />
        </BodyContent>
    </Modal>
}
