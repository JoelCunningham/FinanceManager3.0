@inherits MainPageBase

<PageTitle>Activities</PageTitle>
<PageHeading Heading="Activities">
    <SubheadingParts>
        @if (TransactionData.Result is not null && TransferData.Result is not null)
        {
            var showingCount =
                ActiveTabId == Tabs.ActivityList ? TransactionData.Result.Items.Count :
                ActiveTabId == Tabs.Transfers ? TransferData.Result.Items.Count :
                0;

            <span>@TransactionData.Result.TotalItems Activities</span>
            <span>@TransferData.Result.TotalItems Transfers</span>
            <span>Showing @showingCount</span>
        }
        else
        {
            <span>No activities found</span>
        }
    </SubheadingParts>
    <Actions>
        <HxButton Color="ThemeColor.Primary" Icon="BootstrapIcon.ArrowUpRightCircle" IconPlacement="ButtonIconPlacement.End" Text="Export" OnClick="() => { /* TODO */ }" />
    </Actions>
</PageHeading>

<TabPanel @bind-ActiveTabId="ActiveTabId" Page="@Pages.Activities">
    <HxTab Title="Activity list" Id="@Tabs.ActivityList">
        <Content>
            @if (UnreviewedCount > 0)
            {
                <Alert Level="Alert.AlertLevel.Info" ActionText="Review activities" ActionUrl="@Pages.Review">You have @UnreviewedCount unreviewed activities.</Alert>
            }
            @if (TransactionData.Result is null && !TransactionData.Query.HasFilters)
            {
                <NotificationScreen Text="It looks like you haven't imported any activities yet - let's get started!">
                    <HxButton Color="ThemeColor.Primary" @onclick="() => Navigation.NavigateTo(Pages.Import)">Import now</HxButton>
                </NotificationScreen>
            }
            <TransactionsGrid @bind-Data="TransactionData" Accounts="UniqueAccounts" Categories="Categories" OpenDetails="OpenTransactionDetailsModal" OpenEdit="OpenEditModal" />
        </Content>
    </HxTab>
    <HxTab Title="Activity summary" Id="@Tabs.ActivitySummary">
        <Content>
            <SummaryHeader Year="ActiveBudgetYear?.Year ?? DateTime.Now.Year"
                           EntryTypeFilter="EntryTypeFilter"
                           EntryTypeFilterChanged="OnEntryTypeFilterChanged"
                           HasPopulatedCategories="HasPopulatedCategories"
                           EntryTypeFilters="EntryTypeFilters"
                           HideEmptyCategories="HideEmptyCategories"
                           HideEmptyCategoriesChanged="OnHideEmptyCategoriesChanged"
                           CurrentRange="AvailableYears.ToList().IndexOf(ActiveBudgetYear?.Year ?? DateTime.Now.Year)"
                           Ranges="AvailableYears.Select((y, i) => (i, y.ToString()))"
                           OnRangeSelected="OnRangeSelected" />

            <BudgetGrid Scope="BudgetScope.Monthly"
                        Year="ActiveBudgetYear?.Year ?? DateTime.Now.Year"
                        GridMode="EntryTypeFilter"
                        BudgetMode="false"
                        Columns="SummaryColumns"
                        Categories="Categories"
                        HideEmptyCategories="HideEmptyCategories"
                        OnCellClicked="args => OpenCellModal(args.Item1, args.Item2)" />
        </Content>
    </HxTab>
    <HxTab Title="Transfers" Id="@Tabs.Transfers">
        <Content>
            <TransfersGrid @bind-Data="TransferData" Accounts="UniqueAccounts" RemoveTransfer="SeparateTransfer" OpenDetails="OpenTransferDetailsModal" />
        </Content>
    </HxTab>
</TabPanel>

<TransactionDetailsModal @ref="DetailsModal" Details="SelectedDetails" OnEdit="OpenEditModal" />

<EditTransactionModal @ref="EditModal"
                      EditTransaction="EditTransaction"
                      EditTransactionGroup="EditTransactionGroup"
                      Categories="Categories"
                      Validation="Validation"
                      SetCategory="SetCategory"
                      SetGroupCategory="(args) => SetCategory(args.Item1, args.Item2)"
                      SetGroupAmount="(args) => SetAmount(args.Item1, args.Item2, args.Item3)"
                      SetGroupDate="(args) => SetDate(args.Item1, args.Item2, args.Item3)"
                      SaveTransaction="SaveEdit"
                      SaveGroup="SaveGroupEdit" />

<TransferModal @ref="TransferModal" Transfer="SelectedTransfer" SeparateFromDetails="SeparateFromDetails" />

<BudgetCellModal @ref="BudgetCellModal"
                 Cell="CurrentCell"
                 Column="CurrentColumn"
                 OnActivityEdit="OpenEditModal"
                 OnClose="CloseCellModal" />