@inherits MainPageBase

<PageTitle>Category areas</PageTitle>

<PageHeading Heading="Category areas">
    <SubheadingParts>
        <span>@CategoryGroups.Count() areas</span>
        <span>@CategoryGroups.Sum(g => g.CategoryCount) categories</span>
    </SubheadingParts>
    <Actions>
        <CategoryGroupActions SearchQuery="@GroupSearch"
                              GroupMode="@GroupMode"
                              SearchQueryChanged="OnGroupSearchChanged"
                              GroupModeChanged="OnGroupModeChanged"
                              OnCreate="OpenGroupCreateModal" />
    </Actions>
</PageHeading>

@if (FilteredGroups.Any())
{
    <CategoryCards Groups="FilteredGroups" OnGroupClicked="OpenGroupPanel" />
}
else
{
    if (!string.IsNullOrWhiteSpace(GroupSearch))
    {
        <Alert Level="Alert.AlertLevel.Info">No category areas match your search.</Alert>
    }
    else
    {
        <NotificationScreen Text="You have no category areas yet. Create an area to get started categorising your transactions.">
            <HxButton Color="ThemeColor.Primary" @onclick="OpenGroupCreateModal">Create now</HxButton>
        </NotificationScreen>
    }
}


<CategoryGroupModal @ref="GroupModal"
                    IsEditing="false"
                    Group="CreateGroup"
                    HasIsIncomeError="@Validation.GetValidationItemIds(ValidationField.IsIncome).Contains(CreateGroup?.Id ?? Guid.Empty)"
                    HasNameError="@Validation.GetValidationItemIds(ValidationField.Name).Contains(CreateGroup?.Id ?? Guid.Empty)"
                    HasColourError="@Validation.GetValidationItemIds(ValidationField.Colour).Contains(CreateGroup?.Id ?? Guid.Empty)"
                    HasIconError="@Validation.GetValidationItemIds(ValidationField.Icon).Contains(CreateGroup?.Id ?? Guid.Empty)"
                    OnSave="OnGroupCreate"
                    OnCancel="CloseGroupCreateModal" />