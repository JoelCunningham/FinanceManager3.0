@code {
    [Parameter] public CategoryGroupSummary Group { get; set; } = default!;

    [Parameter] public EventCallback<CategoryGroupSummary> OnClicked { get; set; }
}

<div class="group-card" style="--group-accent-color: @Group.Colour;" @onclick="() => OnClicked.InvokeAsync(Group)">
    <div class="card-title">
        <HxIcon Icon="CategoryUtilities.GetCategroyGroupIcon(Group.Icon)" CssClass="fs-2 me-1" />
        <div class="group-card-header">
            <div class="group-card-title" title="@Group.Name">@Group.Name</div>
            <div class="group-card-subtitle">@(Group.IsIncome ? "Income" : "Expense") · @Group.CategoryCount categories</div>
        </div>
    </div>
</div>
