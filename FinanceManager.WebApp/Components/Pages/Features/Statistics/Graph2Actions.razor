@code
{
    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);

    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public IEnumerable<ScopedPeriod> Range { get; set; } = default!;
    [Parameter] public EventCallback<IEnumerable<ScopedPeriod>> RangeChanged { get; set; }

    [Parameter] public IEnumerable<ScopedPeriod> Periods { get; set; } = [];

    private int CurrentPeriod => Periods.ToList().IndexOf(Range.FirstOrDefault()!);

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income
    ];

    private async Task OnPeriodChangedAsync(int index)
    {
        var period = Periods.ElementAt(index);
        Chart.SetRange(ChartModel.GetPeriodsInRange(Periods, period, period));
        await RangeChanged.InvokeAsync(Chart.Range);
        await Chart.RefreshAsync();
    }

    private async Task OnResetAsync()
    {
        Chart.ResetRange();
        await RangeChanged.InvokeAsync(Chart.Range);
        await Chart.RefreshAsync();
    }
}


<GraphActions Modes="SupportedModes" Chart="Chart" OnReset="OnResetAsync">
    <MainSelect>
        <PeriodNav Periods="Periods.Select((p, i) => (i, p.PeriodDescription))"
                   CurrentPeriod="CurrentPeriod"
                   CurrentPeriodChanged="OnPeriodChangedAsync" />
    </MainSelect>
</GraphActions>