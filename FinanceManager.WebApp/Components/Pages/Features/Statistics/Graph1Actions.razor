@code
{
    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public IEnumerable<ScopedPeriod> Range { get; set; } = default!;
    [Parameter] public EventCallback<IEnumerable<ScopedPeriod>> RangeChanged { get; set; }

    [Parameter] public IEnumerable<ScopedPeriod> Periods { get; set; } = [];

    private int CurrentPeriod => Periods.ToList().IndexOf(Range.First());

    private int StartPeriod => Periods.ToList().IndexOf(Range.First());
    private int EndPeriod => Periods.ToList().IndexOf(Range.Last());

    private static readonly TransactionsGraphMode[] SupportedModes =
    [
        TransactionsGraphMode.Expense,
        TransactionsGraphMode.Income,
        TransactionsGraphMode.Net
    ];

    private async Task OnPeriodChangedAsync(int startIndex, int endIndex)
    {
        Chart.SetRange(ChartModel.GetPeriodsInRange(Periods, Periods.ElementAt(startIndex), Periods.ElementAt(endIndex)));
        await RangeChanged.InvokeAsync(Chart.Range);
        await Chart.RefreshAsync();
    }

    private async Task OnResetAsync()
    {
        Chart.ResetRange();
        await RangeChanged.InvokeAsync(Chart.Range);
        await Chart.RefreshAsync();
    }
}

<GraphActions Modes="SupportedModes" Chart="Chart" OnReset="OnResetAsync">
    <MainSelect>
        <RangeSelect StartPeriod="StartPeriod"
                     StartPeriodChanged="p => OnPeriodChangedAsync(p, EndPeriod)"
                     EndPeriod="EndPeriod"
                     EndPeriodChanged="p => OnPeriodChangedAsync(StartPeriod, p)"
                     Periods="Periods" />
    </MainSelect>
</GraphActions>