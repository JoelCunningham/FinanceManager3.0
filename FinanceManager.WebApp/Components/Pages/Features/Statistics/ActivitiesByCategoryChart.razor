@using FinanceManager.Application.UseCases
@inject UseCases UseCases

@code
{
    [Parameter] public IEnumerable<ScopedPeriod> Periods { get; set; } = [];
    [Parameter] public IEnumerable<CategoryGroupSummary> CategoryGroups { get; set; } = [];

    private ChartModel Chart { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        Chart = new(Periods, [ChartMode.Expense, ChartMode.Income], 1, ReloadChart);
        await Chart.RefreshAsync();
    }

    private async Task ReloadChart()
    {
        var result = await UseCases.GetChart2DataAsync(Chart.Range, CategoryGroups, Chart.DrilldownId, Chart.Mode);
        Chart.Title = result.Title;
        Chart.Options = result.Options;
    }
}

<div class="chart-wrapper">
    <div class="actions">
        <ChartActions Mode="Chart.Mode" ModeChanged="Chart.SetModeAsync" AvailableModes="Chart.AvailableModes" IsDrilldown="Chart.DrilldownId is not null" OnReset="Chart.ResetChartAsync" OnBackToAreas="Chart.ClearDrilldownAsync" GetModeDescription="Chart.GetModeDescription">
            <MainSelect>
                <PeriodNav Periods="Periods.Select((p, i) => (i, p.PeriodDescription))"
                           CurrentPeriod="Periods.ToList().IndexOf(Chart.Range.First())"
                           CurrentPeriodChanged="Chart.SetRangeEndAsync" />
            </MainSelect>
        </ChartActions>
    </div>
    <Chart ChartModel="Chart" />
</div>