@code
{
    [Parameter] public RenderFragment? MainSelect { get; set; }

    [Parameter] public ChartMode Mode { get; set; }
    [Parameter] public EventCallback<ChartMode> ModeChanged { get; set; }

    [Parameter] public IEnumerable<ChartMode> AvailableModes { get; set; } = [];
    [Parameter] public required Func<ChartMode, string> GetModeDescription { get; set; }

    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnBackToAreas { get; set; }

    [Parameter] public bool IsDrilldown { get; set; }
}

<div class="chart-actions">
    <ResposiveDropdown DropdownText="Options">
        @MainSelect

        <HxSelect Value="Mode"
                  ValueChanged="ModeChanged"
                  ValueExpression="() => Mode"
                  Data="AvailableModes"
                  TItem="ChartMode"
                  TValue="ChartMode"
                  Nullable="false"
                  AutoSort="false"
                  Enabled="!IsDrilldown"
                  TextSelector="m => GetModeDescription.Invoke(m)"
                  ValueSelector="m => m" />

        <HxButton Text="Reset" OnClick="OnReset" CssClass="reset" />

        @if (IsDrilldown)
        {
            <div>
                <HxButton Text="Back to areas" Icon="BootstrapIcon.ArrowLeft" OnClick="OnBackToAreas" />
            </div>
        }
    </ResposiveDropdown>
</div>