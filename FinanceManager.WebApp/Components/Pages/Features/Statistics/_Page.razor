@inherits MainPageBase

<PageTitle>Statistics</PageTitle>

<PageHeading Heading="Statistics" Subheading="Spend, budget, and trends across categories" />

@if (UserStatus == UserStatus.New)
{
    <NotificationScreen Text="To start getting your statistics, you first need to import your transactions.">
        <HxButton Color="ThemeColor.Primary" @onclick="() => Navigation.NavigateTo(Pages.Import)">Import now</HxButton>
    </NotificationScreen>
}
else
{
    <TabPanel @bind-ActiveTabId="ActiveTabId" Page="@Pages.Statistics">
        <HxTab Title="Spend by category" Id="@Tabs.Chart1.ToString()">
            <Content>
                <ActivitiesByCategoryChart Periods="Periods.OrderByDescending(p => p.StartDate)" GetData="GetChart2Data" CategoryGroups="CategoryGroups" />
            </Content>
        </HxTab>

        <HxTab Title="Spend over time" Id="@Tabs.Chart2.ToString()">
            <Content>
                <ActivitiesByCategoryOverTimeChart Periods="Periods.OrderByDescending(p => p.StartDate)" GetData="GetChart1Data" CategoryGroups="CategoryGroups" Categories="Categories" />
            </Content>
        </HxTab>
    </TabPanel>
}