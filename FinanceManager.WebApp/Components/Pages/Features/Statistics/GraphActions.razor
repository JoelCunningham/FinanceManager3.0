@code
{
    [Parameter] public ChartModel Chart { get; set; } = default!;

    [Parameter] public RenderFragment? Dropdowns { get; set; }

    [Parameter] public IReadOnlyList<TransactionsGraphMode> Modes { get; set; } = [];

    [Parameter] public EventCallback OnPreviousRange { get; set; }
    [Parameter] public EventCallback OnToday { get; set; }
    [Parameter] public EventCallback OnNextRange { get; set; }

    [Parameter] public EventCallback OnReset { get; set; }

    private async Task OnModeChangedAsync(TransactionsGraphMode mode)
    {
        Chart.Mode = mode;
        await Chart.RefreshAsync();
    }
}

<div class="graph-actions">
    <RangeNav OnPreviousRange="OnPreviousRange" OnFixed="OnToday" OnNextRange="OnNextRange" FixedText="Today" />

    <HxSelect Value="Chart.Mode"
              ValueChanged="OnModeChangedAsync"
              ValueExpression="() => Chart.Mode"
              Data="Modes"
              TItem="TransactionsGraphMode"
              TValue="TransactionsGraphMode"
              Nullable="false"
              AutoSort="false"
              Enabled="!Chart.IsCategoryLevel"
              TextSelector="m => m.ToString()"
              ValueSelector="m => m" />

    <HxButton Text="Reset" OnClick="OnReset" CssClass="reset" />

    @if (Chart.IsCategoryLevel)
    {
        <div>
            <HxButton Text="Back to areas" Icon="BootstrapIcon.ArrowLeft" OnClick="Chart.ClearDrilldownAsync" />
        </div>
    }

    <HxDropdownButtonGroup>
        <HxDropdownToggleButton Color="ThemeColor.Primary">Options</HxDropdownToggleButton>
        <HxDropdownContent CssClass="px-4 py-3">
            @Dropdowns
        </HxDropdownContent>
    </HxDropdownButtonGroup>
</div>