@inherits ModalBase

@code {
    [Parameter] public bool IsEditing { get; set; }

    [Parameter] public BudgetYearSummary? BudgetYear { get; set; }
    [Parameter] public EventCallback<BudgetYearSummary> BudgetYearChanged { get; set; }

    [Parameter] public IEnumerable<BudgetScope> AvailableScopes { get; set; } = [];

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
}

<HxModal @ref="_modal" Title="@(IsEditing ? "Edit budget" : "Create budget")">
    <BodyTemplate>
        <div class="d-flex flex-column gap-2">
            @if (BudgetYear is not null)
            {
                <HxInputNumber Label="Year" @bind-Value="BudgetYear.Year" Enabled="!IsEditing" />
                <HxSelect Label="Budget scope" @bind-Value="BudgetYear.Scope" Data="AvailableScopes" TextSelector="s => s.ToString()" ValueSelector="s => s" Nullable="false" />
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <ModalActions IsCreating="!IsEditing" OnCancel="OnCancel" OnSave="OnSave" OnDelete="OnDelete" />
    </FooterTemplate>
</HxModal>
