@inherits ModalBase

@code {
    [Parameter] public BudgetCell Cell { get; set; } = default!;

    [Parameter] public EventCallback<BudgetCell> OnEntryCreate { get; set; }
    [Parameter] public EventCallback<BudgetCellEntry> OnEntryEdit { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private IEnumerable<BudgetCellEntry> SortedEntries => Cell?.Entries.OrderByDescending(e => e.Amount) ?? Enumerable.Empty<BudgetCellEntry>();

}

<HxModal @ref="_modal" Title="@(Cell?.Label + " - " + Cell?.Category.Name)">
    <BodyTemplate>
        <div>
            <div class="description">
                <span>Total budget <span class="bold-success">@Cell?.BudgetAmount.ToString("C")</span> · </span>
                <span>Actual spend <span class="bold-danger">@Cell?.RealAmount.ToString("C")</span> · </span>
                <span>Net <span class="bold-primary">@(((Cell?.BudgetAmount ?? 0) - (Cell?.RealAmount ?? 0)).ToString("C"))</span></span>
            </div>
            @if (SortedEntries.Any())
            {
                <table>
                    <tbody>
                        @foreach (var entry in SortedEntries)
                        {
                            <tr @onclick="() => OnEntryEdit.InvokeAsync(entry)">
                                <td>@entry.Name</td>
                                <td class="text-end">@entry.Amount.ToString("C", CultureInfo.CurrentCulture)</td>
                            </tr>
                            <tr />
                        }
                    </tbody>
                </table>
            }
            else
            {
                <Alert Level="Alert.AlertLevel.Info">Click "Add entry" to create a budget entry.</Alert>
            }
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Color="ThemeColor.Secondary" OnClick="@(() => OnClose.InvokeAsync())">Close</HxButton>
        <HxButton Color="ThemeColor.Primary" OnClick="@(() => OnEntryCreate.InvokeAsync(Cell))">Add entry</HxButton>
    </FooterTemplate>
</HxModal>
