@code {
    [Parameter] public BudgetGridMode EntryTypeFilter { get; set; }
    [Parameter] public EventCallback<BudgetGridMode> EntryTypeFilterChanged { get; set; }

    [Parameter] public bool HasPopulatedCategories { get; set; }
    [Parameter] public bool HideEmptyCategories { get; set; }
    [Parameter] public EventCallback<bool> HideEmptyCategoriesChanged { get; set; }

    [Parameter] public IReadOnlyList<BudgetGridMode> EntryTypeFilters { get; set; } = [];

    [Parameter] public int CurrentRange { get; set; }
    [Parameter] public EventCallback<int> OnRangeSelected { get; set; }

    [Parameter] public IEnumerable<(int Index, string Name)> Ranges { get; set; } = [];

    [Parameter] public EventCallback OnEditYear { get; set; }
    [Parameter] public EventCallback OnCreateYear { get; set; }

}

<HxCheckbox Text="Hide empty"
            Value="HideEmptyCategories"
            ValueChanged="HideEmptyCategoriesChanged"
            ValueExpression="() => HideEmptyCategories"
            Enabled="HasPopulatedCategories" />

<PeriodNav CurrentPeriod="CurrentRange" CurrentPeriodChanged="OnRangeSelected" Periods="Ranges" />

<HxSelect Value="EntryTypeFilter"
          ValueChanged="EntryTypeFilterChanged"
          ValueExpression="() => EntryTypeFilter"
          Data="EntryTypeFilters"
          TItem="BudgetGridMode"
          TValue="BudgetGridMode"
          Nullable="false"
          AutoSort="false"
          TextSelector="f => f.ToString()"
          ValueSelector="f => f" />

@if (OnEditYear.HasDelegate && OnCreateYear.HasDelegate)
{
    <HxButton Color="ThemeColor.Secondary" OnClick="OnEditYear">Edit budget</HxButton>
    <HxButton Color="ThemeColor.Primary" OnClick="OnCreateYear">Create budget</HxButton>
}