@inherits MainPageBase

<PageTitle>Budget</PageTitle>
<PageHeading Heading="@("Budget " + (ActiveBudgetYear?.Year ?? DateTime.Now.Year))">
    <SubheadingParts>
        <span>Net <span class="bold-primary">@TotalBudget.ToString("C")</span></span>
        <span>Total in <span class="bold-success">@TotalIncome.ToString("C")</span></span>
        <span>Total out <span class="bold-danger">@TotalExpense.ToString("C")</span></span>
    </SubheadingParts>
    <Actions>
        <BudgetActions EntryTypeFilter="EntryTypeFilter"
                       EntryTypeFilterChanged="OnEntryTypeFilterChanged"
                       HasPopulatedCategories="HasPopulatedCategories"
                       EntryTypeFilters="EntryTypeFilters"
                       HideEmptyCategories="HideEmptyCategories"
                       HideEmptyCategoriesChanged="OnHideEmptyCategoriesChanged"
                       CurrentRange="AvailableYears.ToList().IndexOf(ActiveBudgetYear?.Year ?? DateTime.Now.Year)"
                       Ranges="AvailableYears.Select((y, i) => (i, y.ToString()))"
                       OnRangeSelected="OnRangeSelected"
                       OnEditYear="EditYear"
                       OnCreateYear="CreateYear" />
    </Actions>
</PageHeading>

<BudgetGrid Scope="ActiveBudgetYear?.Scope"
            Year="ActiveBudgetYear?.Year ?? DateTime.Now.Year"
            Columns="Columns"
            Categories="Categories"
            HideEmptyCategories="HideEmptyCategories"
            OnCellClicked="OpenCellModal"
            OnBudgetCreateClicked="CreateYear" />

<BudgetEntryModal @ref="BudgetEntryModal"
                  Entry="CurrentEntry"
                  CurrentBudgetYear="ActiveBudgetYear"
                  IsEditing="IsEditing"
                  Categories="Categories"
                  OnCancel="CancelEntry"
                  OnDelete="DeleteEntry"
                  OnSave="SaveEntry" />

<BudgetYearModal @ref="BudgetYearModal"
                 BudgetYear="CurrentYear"
                 AvailableScopes="BudgetScopes"
                 IsEditing="IsEditing"
                 OnSave="SaveBudget"
                 OnDelete="DeleteBudget"
                 OnCancel="CancelBudget" />

<BudgetCellModal @ref="BudgetCellModal" 
    Cell="CurrentCell" 
    OnEntryEdit="EditEntry"
    OnEntryCreate="CreateEntry"
    OnClose="CloseCellModal"/>