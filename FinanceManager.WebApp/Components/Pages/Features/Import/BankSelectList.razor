@code {
    [Parameter] public IReadOnlyList<BankParser> AvailableParsers { get; set; } = [];

    [Parameter] public BankParser? SelectedBank { get; set; }
    [Parameter] public EventCallback<BankParser?> SelectedBankChanged { get; set; }
}

<div class="bank-list">
    <HxRadioButtonList Label="Select your bank"
                       TItem="BankParser"
                       TValue="BankParser"
                       Data="AvailableParsers"
                       Value="SelectedBank"
                       ValueChanged="SelectedBankChanged"
                       ValueExpression="() => SelectedBank"
                       Color="ThemeColor.Primary"
                       Outline="true"
                       Inline="true"
                       RenderMode="RadioButtonListRenderMode.ToggleButtons"
                       ItemTextCssClass="me-2">
        <ItemTemplate Context="p">
            <div class="@("bank-select-content " + (SelectedBank == p ? "active" : ""))">
                <BankLogo BankName="@p.BankName" />
                <span>@p.BankName</span>
            </div>
        </ItemTemplate>
    </HxRadioButtonList>
</div>