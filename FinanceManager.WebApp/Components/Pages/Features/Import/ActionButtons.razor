@code {
    [Parameter] public bool Active { get; set; }

    [Parameter] public EventCallback Reset { get; set; }
    [Parameter] public EventCallback ShowPreview { get; set; }
    [Parameter] public EventCallback ImportTransactions { get; set; }
}

<div class="action-buttons">
    <HxButton Color="ThemeColor.Secondary" OnClick="Reset" Enabled="Active" Tooltip="@(Active ? "Reset import" : "No import in progress")">Cancel</HxButton>
    <HxButton Color="ThemeColor.Secondary" OnClick="ShowPreview" Enabled="Active" Tooltip="@(Active ? "Preview transactions" : "Upload a file first")">Preview</HxButton>
    <HxSubmit Color="ThemeColor.Primary" OnClick="ImportTransactions" Enabled="Active" Tooltip="@(Active ? "Import transactions" : "Upload a file first")">Import</HxSubmit>
</div>