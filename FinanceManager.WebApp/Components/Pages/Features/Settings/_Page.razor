@inherits MainPageBase

<PageHeading Heading="Settings" Subheading="Manage your account details and preferences" />

<SettingsPanel Title="Options">
    <EditForm FormName="Settings.Options" Model="OptionsModel">
        <DataAnnotationsValidator />

        <HxRadioButtonList Label="Colour mode"
                           TItem="ColourTheme"
                           TValue="ColourTheme"
                           @bind-Value="OptionsModel.PreferredColourMode"
                           Data="[ColourTheme.Light, ColourTheme.Dark, ColourTheme.System]"
                           Inline="true"
                           ItemTextSelector="@(colourMode => ThemeUtilities.GetColourModeDescription(colourMode))"
                           ItemValueSelector="@(colourMode => colourMode)"
                           RenderMode="RadioButtonListRenderMode.ButtonGroup"
                           Color="ThemeColor.Light"
                           Outline="true"
                           CssClass="mt-2"
                           @bind-Value:after="HandleOptionsUpdate" />
    </EditForm>
</SettingsPanel>

<SettingsPanel Title="Profile">
    <EditForm FormName="Settings.Profile" Model="ProfileModel">
        <DataAnnotationsValidator />

        @if (HasChangedEmail)
        {
            <Alert Level="Alert.AlertLevel.Warning">
                You have requested to change your email address. Please check your inbox for a confirmation link. Once you confirm your new email, it will be updated here and you will be able to use it to sign in.
            </Alert>
        }
        <HxInputText @bind-Value="ProfileModel.NewName" Label="Name" />
        <HxInputText @bind-Value="ProfileModel.NewEmail" Label="Email address" />

        <div class="settings-footer">
            <p>Changing your email will send a confirmation link to the new address.</p>
            <HxSubmit Color="ThemeColor.Primary" OnValidClick="HandleProfileUpdate">Save changes</HxSubmit>
        </div>
    </EditForm>
</SettingsPanel>

<SettingsPanel Title="Security">
    <EditForm FormName="Settings.Security" Model="PasswordModel">
        <DataAnnotationsValidator />

        <HxInputText @bind-Value="PasswordModel.CurrentPassword" Label="Current password" Type="InputType.Password" />
        <HxInputText @bind-Value="PasswordModel.NewPassword" Label="New password" Type="InputType.Password" />
        <HxInputText @bind-Value="PasswordModel.ConfirmPassword" Label="Confirm password" Type="InputType.Password" />

        <div class="settings-footer">
            <p>Remember to choose a strong password you haven't used before.</p>
            <HxSubmit Color="ThemeColor.Primary" OnValidClick="HandlePasswordUpdate">Update password</HxSubmit>
        </div>
    </EditForm>
</SettingsPanel>

<SettingsPanel Title="Delete account">
    <EditForm FormName="Settings.DeleteAccount" Model="new()">
        <div class="settings-footer">
            <p>Deleting your account is permanent and cannot be undone.</p>
            <HxSubmit Color="ThemeColor.Primary" OnValidClick="HandleUserDelete">Delete account</HxSubmit>
        </div>
    </EditForm>
</SettingsPanel>

<MfaModal @ref="MfaModal" EmailAddress="@ProfileModel.CurrentEmail" HasError="MfaCodeError" OnConfirmIdentity="HandleMfaSubmit" OnRequestNewCode="GenerateNewMfaCode" />

<Confirmation @ref="Confirmation" />