@inherits MainPageBase
@*
@if (HasAuthenicated)
{
    <PageHeading Heading="Settings" Subheading="Manage your settings and preferences" />

    <EditForm FormName="Settings" Model="Model" OnValidSubmit="HandleChangePassword">
        <HxInputText @bind-Value="Model.Name" Label="Name" />
        <HxInputText @bind-Value="Model.Email" Label="Email" />

        <HxSubmit Color="ThemeColor.Primary">Change password</HxSubmit>
    </EditForm>
}
else
{
    <PageHeading Heading="Confirm identity" Subheading="For your security, please complete two-factor authentication" />

    <HxButton Color="ThemeColor.Primary" OnClick="() => Open2FAModal()">Confirm</HxButton>
}

 *@