@using FinanceManager.Application.UseCases
@inject UseCases UseCases
@inject NavigationManager NavigationManager

@code
{
    [Parameter] public CategoryGroupSummary Group { get; set; } = default!;
    [Parameter] public IEnumerable<CategorySummary> Categories { get; set; } = [];

    [Parameter] public int Length { get; set; }
    [Parameter] public BudgetScope Scope { get; set; }

    private ChartModel Chart { get; set; } = default!;

    private CategoryGraphMode CurrentGraphMode = CategoryGraphMode.ActualAndBudget;
    private IEnumerable<CategoryGraphMode> SupportedGraphModes = [CategoryGraphMode.Actual, CategoryGraphMode.Budget, CategoryGraphMode.ActualAndBudget, CategoryGraphMode.Variance];

    private IEnumerable<CategorySummary> SelectedCategories = [];

    private ScopedPeriod StartPeriod = default!;
    private ScopedPeriod EndPeriod = default!;
    private IEnumerable<ScopedPeriod> Periods = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Categories.Any())
        {
            Periods = (await UseCases.GetAvailablePeriodsAsync(Group.Id, true)).Periods;
            var correctedLength = Math.Min(Length, Periods.Count());

            StartPeriod = Periods.ElementAt(correctedLength - 1);
            EndPeriod = Periods.First();

            SelectedCategories = Categories;

            if (Chart is null) Chart = new ChartModel(ChartModel.GetPeriodsInRange(Periods, StartPeriod, EndPeriod), ReloadChart);
            await ReloadChart();
        }
    }

    public void SetRange(ScopedPeriod start, ScopedPeriod end)
    {
        StartPeriod = start;
        EndPeriod = end;
        Chart.Range = ChartModel.GetPeriodsInRange(Periods, StartPeriod, EndPeriod);
        _ = ReloadChart();
    }

    private async Task ReloadChart()
    {
        var result = await UseCases.GetCategoryGraphAsync(SelectedCategories, Chart.Range);

        var hasBudget = result.BudgetSeries.Any(s => s.Value.Any(v => v != 0.00m));
        var hasActual = result.ActualSeries.Any(s => s.Value.Any(v => v != 0.00m));

        var labels = Chart.Range.Select(p => p.StartDate.ToString("yyyy-MM")).ToArray();

        var series = new List<object>();

        if (CurrentGraphMode != CategoryGraphMode.Budget && CurrentGraphMode != CategoryGraphMode.Variance)
        {
            series.AddRange(result.ActualSeries
                .Where(s => s.Value.Any(v => v != 0.00m))
                .Select(s =>
                    new { name = s.Key.Name, type = "line", lineStyle = new { type = "solid" }, itemStyle = new { color = s.Key.Colour }, smooth = true, data = Group.IsIncome ? s.Value : s.Value.Select(v => -v).ToArray() }
                ).ToArray());
        }
        if (CurrentGraphMode != CategoryGraphMode.Actual && CurrentGraphMode != CategoryGraphMode.Variance)
        {
            series.AddRange(result.BudgetSeries
            .Where(s => s.Value.Any(v => v != 0.00m))
            .Select(s =>
                new { name = s.Key.Name + " Budget", type = "line", lineStyle = new { type = "dashed" }, itemStyle = new { color = s.Key.Colour }, smooth = true, data = s.Value }
            ).ToArray());
        }
        if (CurrentGraphMode == CategoryGraphMode.Variance)
        {
            var varianceSeries = result.ActualSeries
                .Where(s => s.Value.Any(v => v != 0.00m))
                .Select(s =>
                    new { name = s.Key.Name + " Variance", type = "line", lineStyle = new { type = "solid" }, itemStyle = new { color = s.Key.Colour }, smooth = true, data = s.Value.Zip(result.BudgetSeries.FirstOrDefault(b => b.Key.Id == s.Key.Id).Value ?? Array.Empty<decimal>(), (actual, budget) => Group.IsIncome ? actual - budget : budget + actual).ToArray() }
                ).ToArray();
            series.AddRange(varianceSeries);
        }

        Chart.Title = $"{Group.Name} categories actual vs budget for {Chart.Range.First().StartDate:MMM yyyy} - {Chart.Range.Last().EndDate:MMM yyyy}";
        Chart.Options = new
        {
            tooltip = new
            {
                trigger = "axis",
                valueFormatter = new HxEChart.JSFunc(@"function (value) {
                    return '$' + value.toFixed(2);
                }")
            },
            legend = new { show = false },
            grid = new { left = "3%", right = "4%", bottom = "3%", containLabel = true },
            xAxis = new { type = "category", data = labels },
            yAxis = new { type = "value" },
            series = series.ToArray()
        };
    }

    private async Task OnModeChangedAsync(CategoryGraphMode newMode)
    {
        CurrentGraphMode = newMode;
        await ReloadChart();
    }

    private string GetModeDescription(CategoryGraphMode mode)
    {
        return mode switch
        {
            CategoryGraphMode.Actual => "Actual",
            CategoryGraphMode.Budget => "Budget",
            CategoryGraphMode.ActualAndBudget => "Actual and Budget",
            CategoryGraphMode.Variance => "Variance",
            _ => throw new ArgumentOutOfRangeException(nameof(mode), mode, null)
        };
    }

    private async Task ToggleCategory(CategorySummary category)
    {
        if (SelectedCategories.Contains(category))
        {
            SelectedCategories = SelectedCategories.Where(c => c.Id != category.Id);
        }
        else
        {
            SelectedCategories = SelectedCategories.Append(category);
        }
        await ReloadChart();
    }

    private async Task OnStartPeriodSelected(int index)
    {
        StartPeriod = Periods.ElementAt(index);
        Chart.SetRange(ChartModel.GetPeriodsInRange(Periods, StartPeriod, EndPeriod));
        await ReloadChart();
    }

    private async Task OnEndPeriodSelected(int index)
    {
        EndPeriod = Periods.ElementAt(index);
        Chart.SetRange(ChartModel.GetPeriodsInRange(Periods, StartPeriod, EndPeriod));
        await ReloadChart();
    }
}

@if (!Categories.Any())
{
    <div class="message">
        <Alert Level="Alert.AlertLevel.Info">
            You do not have any categories in this area.
        </Alert>
    </div>
}
else
{
    <div class="chart-wrapper">
        <div class="actions">
            <HxSelect Value="CurrentGraphMode"
                      ValueChanged="OnModeChangedAsync"
                      ValueExpression="() => CurrentGraphMode"
                      TItem="CategoryGraphMode"
                      TValue="CategoryGraphMode"
                      Data="SupportedGraphModes"
                      Nullable="false"
                      AutoSort="false"
                      TextSelector="f => GetModeDescription(f)"
                      ValueSelector="f => f"
                      CssClass="me-auto" />

            <RangeSelect StartPeriod="Periods.ToList().IndexOf(StartPeriod)"
                         StartPeriodChanged="OnStartPeriodSelected"
                         EndPeriod="Periods.ToList().IndexOf(EndPeriod)"
                         EndPeriodChanged="OnEndPeriodSelected"
                         Periods="Periods" />
        </div>
        <div class="legend">
            @foreach (var category in Categories)
            {
                <HxButton CssClass="legend-item" OnClick="@(() => ToggleCategory(category))">
                    <span class="legend-line" style="border-color: @category.Colour;" />
                    <span class="@(SelectedCategories.Contains(category) ? "" : "inactive")">@category.Name</span>
                </HxButton>
            }
        </div>

        <Chart Options="Chart.Options" OnItemClick="Chart.OnDrilldownClickAsync" />
    </div>
}
