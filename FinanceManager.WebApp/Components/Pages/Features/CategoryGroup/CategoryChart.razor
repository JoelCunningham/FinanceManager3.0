@using FinanceManager.Application.UseCases
@inject UseCases UseCases

@code
{
    [Parameter] public IEnumerable<ScopedPeriod> Periods { get; set; } = [];
    [Parameter] public CategoryGroupDetails CategoryGroup { get; set; } = default!;

    private ChartModel Chart { get; set; } = default!;
    private IEnumerable<CategorySummary> SelectedCategories = [];

    protected override async Task OnParametersSetAsync()
    {
        SelectedCategories = CategoryGroup.Categories;

        if (Chart is null) Chart = new ChartModel(Periods, [ChartMode.ActualAndBudget, ChartMode.Actual, ChartMode.Budget, ChartMode.Variance], null, ReloadChart);
        await Chart.RefreshAsync();
    }

    private async Task ReloadChart()
    {
        var result = await UseCases.GetCategoryChartAsync(SelectedCategories, Chart.Range, Chart.Mode, CategoryGroup.IsIncome);
        var labels = Chart.Range.Select(p => p.StartDate.ToString("yyyy-MM")).ToArray();
        var title = $"{CategoryGroup.Name} categories actual vs budget for {Chart.Range.First().StartDate:MMM yyyy} - {Chart.Range.Last().EndDate:MMM yyyy}";

        Chart.Title = title;
        Chart.Options = new
        {
            tooltip = new
            {
                trigger = "axis",
                formatter = new HxEChart.JSFunc(@"function (value) {
                    return '$' + Number(value).toFixed(2);
                }"),
            },
            legend = new { show = false },
            grid = new { left = "3%", right = "4%", bottom = "3%", containLabel = true },
            xAxis = new { type = "category", data = labels, axisLabel = new { color = ThemeUtilities.ThemePlaceholder } },
            yAxis = new { type = "value", axisLabel = new { color = ThemeUtilities.ThemePlaceholder } },
            series = result.Series
        };
    }

    private async Task ToggleCategory(CategorySummary category)
    {
        if (SelectedCategories.Contains(category))
        {
            SelectedCategories = SelectedCategories.Where(c => c.Id != category.Id);
        }
        else
        {
            SelectedCategories = SelectedCategories.Append(category);
        }
        await Chart.RefreshAsync();
    }
}

@if (!CategoryGroup.Categories.Any())
{
    <div class="message">
        <Alert Level="Alert.AlertLevel.Info">
            You do not have any categories in this area.
        </Alert>
    </div>
}
else
{
    <div class="chart-wrapper">
        <div class="actions">
            <HxSelect Value="Chart.Mode"
                      ValueChanged="m => Chart.SetModeAsync(m)"
                      ValueExpression="() => Chart.Mode"
                      TItem="ChartMode"
                      TValue="ChartMode"
                      Data="Chart.AvailableModes"
                      Nullable="false"
                      AutoSort="false"
                      TextSelector="f => Chart.GetModeDescription(f)"
                      ValueSelector="f => f"
                      CssClass="me-auto" />

            <RangeSelect StartPeriod="Chart.RangeStart"
                         StartPeriodChanged="Chart.SetRangeStartAsync"
                         EndPeriod="Chart.RangeEnd"
                         EndPeriodChanged="Chart.SetRangeEndAsync"
                         Periods="Chart.Periods" />
        </div>
        <div class="legend">
            @foreach (var category in CategoryGroup.Categories)
            {
                <HxButton CssClass="legend-item" OnClick="@(() => ToggleCategory(category))">
                    <span class="legend-line" style="border-color: @category.Colour;" />
                    <span class="@(SelectedCategories.Contains(category) ? "" : "inactive")">@category.Name</span>
                </HxButton>
            }
        </div>

        <Chart Options="Chart.Options" OnItemClick="Chart.OnDrilldownClickAsync" />
    </div>
}
