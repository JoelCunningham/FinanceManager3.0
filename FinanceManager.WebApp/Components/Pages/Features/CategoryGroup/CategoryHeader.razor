@code {
    [Parameter] public bool IsIncome { get; set; }
    [Parameter] public decimal Amount { get; set; }
    [Parameter] public decimal Budget { get; set; }

    private string AmountColour => ColourUtilities.GetAmountColour(IsIncome ? Amount - Budget : Budget - Amount);
}

<div class="heading">
    <span style="@($"color: {AmountColour};")">@Amount.ToString("C")</span>
    <span>@(IsIncome ? "earned" : "spent")</span>
    @if (Budget != 0)
    {
        <span> of @Budget.ToString("C") budgeted</span>
    }
</div>