@inherits MainPageBase

<PageHeading Heading="@Group.Name">
    <SubheadingParts>
        <span>@(Group.IsIncome ? "Income" : "Expense")</span>
        <span>@Group.Categories.Count() categories</span>
        <span><ColourDot Colour="@Group.Colour" /></span>
    </SubheadingParts>
    <Actions>
        <CategoryActions OnEdit="OpenGroupModal" OnClose="() => Navigation.NavigateTo(Pages.Categories)" OnCategoryCreate="OpenCategoryCreateModal" />
    </Actions>
</PageHeading>

<CategoryGroupPanel Group="Group"
                    OnToday="OnToday"
                    OnNext="OnNext"
                    OnPrevious="OnPrevious"
                    OnCategoryClicked="OpenTransactionsModal"
                    OnCategoryEdit="OpenCategoryEditModal" />

<CategoryGroupModal @ref="GroupModal"
                    IsEditing="true"
                    Group="EditGroup"
                    HasIsIncomeError="@Validation.GetValidationItemIds(ValidationField.IsIncome).Contains(EditGroup?.Id ?? Guid.Empty)"
                    HasNameError="@Validation.GetValidationItemIds(ValidationField.Name).Contains(EditGroup?.Id ?? Guid.Empty)"
                    HasColourError="@Validation.GetValidationItemIds(ValidationField.Colour).Contains(EditGroup?.Id ?? Guid.Empty)"
                    HasIconError="@Validation.GetValidationItemIds(ValidationField.Icon).Contains(EditGroup?.Id ?? Guid.Empty)"
                    OnSave="OnGroupSave"
                    OnCancel="CloseGroupModal"
                    OnDelete="OnGroupDelete" />

<CategoryModal @ref="CategoryModal"
               IsEditing="IsEditing"
               Category="EditCategory"
               HasNameError="@Validation.GetValidationItemIds(ValidationField.Name).Contains(EditCategory?.Id ?? Guid.Empty)"
               HasColourError="@Validation.GetValidationItemIds(ValidationField.Colour).Contains(EditCategory?.Id ?? Guid.Empty)"
               OnSave="OnCategorySave"
               OnCancel="CloseCategoryModal"
               OnDelete="OnCategoryDelete" />

<TransactionsModal @ref="TransactionsModal" Category="CurrentCategory" TransactionData="TransactionData" OnCategoryEdit="OpenCategoryEditModal" />

<Confirmation @ref="Confirmation" />