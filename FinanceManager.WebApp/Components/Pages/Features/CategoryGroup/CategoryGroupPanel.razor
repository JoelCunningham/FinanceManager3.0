@code {
    [Parameter] public CategoryGroupDetails Group { get; set; } = default!;

    [Parameter] public EventCallback OnToday { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }

    [Parameter] public EventCallback<CategoryPeriodDetails> OnCategoryClicked { get; set; }
    [Parameter] public EventCallback<CategoryPeriodDetails> OnCategoryEdit { get; set; }

    private CategoryChart? Chart;
    private HxGrid<CategoryPeriodDetails>? Grid;

    protected override async Task OnParametersSetAsync()
    {
        if (Grid is not null) await Grid.RefreshDataAsync();
        if (Chart is not null) await Chart.SetScope(Group.PeriodScope ?? BudgetScope.Monthly);
    }

    private Task<GridDataProviderResult<CategoryPeriodDetails>> GetGridData(GridDataProviderRequest<CategoryPeriodDetails> request)
    {
        return Task.FromResult(request.ApplyTo(Group.Categories));
    }

    private Dictionary<string, object> GetRowAttributes(CategoryPeriodDetails item)
    {
        return new Dictionary<string, object>
        {
            { "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnCategoryClicked.InvokeAsync(item)) },
            { "style", "cursor: pointer;" }
        };
    }

    private string GetRowClass(CategoryPeriodDetails item)
    {
        return ColourUtilities.GetUsageStyle(item.PeriodProportion, true, Group.IsIncome);
    }
}

<div class="category-group-panel">
    <div class="header">
        <CategoryHeader IsIncome="Group.IsIncome"
                        Amount="@Group.Categories.Sum(c => c.SignedPeriodTotal)"
                        Budget="Group.Categories.Sum(c => c.PeriodBudget)" />

        <RangeNav FixedText="@Group.PeriodName" OnFixed="OnToday" OnNextRange="OnNext" OnPreviousRange="OnPrevious" />
    </div>

    <HxGrid @ref="Grid"
            TItem="CategoryPeriodDetails"
            DataProvider="GetGridData"
            SelectionEnabled="false"
            Responsive="false"
            Hover="true"
            PageSize="20"
            ItemRowAdditionalAttributesSelector="GetRowAttributes"
            ItemRowCssClassSelector="GetRowClass">
        <Columns>
            <HxGridColumn HeaderText="Name" SortString="Name" SortKeySelector="@(c => c.Name)">
                <ItemTemplate Context="category">
                    <CategoryBubble Category="@category" IsSplit="true" />
                </ItemTemplate>
            </HxGridColumn>
            <HxGridColumn HeaderText="Progress" SortString="PeriodProportion" SortKeySelector="@(c => c.PeriodProportion)" IsDefaultSortColumn="true" SortDirection="SortDirection.Descending">
                <ItemTemplate Context="category">
                    <ProgressBar Proportion="@category.PeriodProportion" IsIncome="@Group.IsIncome" />
                </ItemTemplate>
            </HxGridColumn>
            <HxGridColumn HeaderText="Budget" SortString="PeriodBudget" SortKeySelector="@(c => c.PeriodBudget)" HeaderCssClass="text-end" ItemCssClass="text-end">
                <ItemTemplate Context="category">
                    @if (category.PeriodBudget != 0)
                    {
                        <b>@category.PeriodBudget.ToString("C")</b>
                    }
                    else
                    {
                        <span>@category.PeriodBudget.ToString("C")</span>
                    }
                </ItemTemplate>
            </HxGridColumn>
            <HxGridColumn HeaderText="Actual" SortString="PeriodTotal" SortKeySelector="@(c => c.SignedPeriodTotal)" ItemCssClass="text-end" HeaderCssClass="text-end">
                <ItemTemplate Context="category">
                    <span style="@($"color: {ColourUtilities.GetUsageColour(category.PeriodProportion, true, Group.IsIncome)};")">
                        @if (category.PeriodBudget != 0 || category.SignedPeriodTotal != 0)
                        {
                            <b>@category.SignedPeriodTotal.ToString("C")</b>
                        }
                        else
                        {
                            @category.SignedPeriodTotal.ToString("C")
                        }
                    </span>
                </ItemTemplate>
            </HxGridColumn>
            <HxContextMenuGridColumn Context="category" ItemCssClass="category-action-col">
                <HxContextMenu>
                    <HxContextMenuItem Text="View activities" OnClick="() => OnCategoryClicked.InvokeAsync(category)" Icon="BootstrapIcon.List" />
                    <HxContextMenuItem Text="Edit" OnClick="() => OnCategoryEdit.InvokeAsync(category)" Icon="BootstrapIcon.PencilSquare" />
                </HxContextMenu>
            </HxContextMenuGridColumn>
        </Columns>
    </HxGrid>

    <CategoryChart @ref="Chart" Group="Group" Categories="Group.Categories" Length="6" Scope="Group.PeriodScope ?? BudgetScope.Monthly" />
</div>