@inherits MainPageBase

<PageTitle>Dashboard</PageTitle>
<PageHeading Heading="Dashboard" Subheading="@DateTime.Today.ToString("dddd, dd MMMM yyyy", CultureInfo.CurrentCulture)">
    <Actions>
        <PeriodNav Periods="DashboardData?.AvailablePeriods.Select((p, i) => (i, p.PeriodDescription)) ?? []"
                   CurrentPeriod="DashboardData?.AvailablePeriods.ToList().IndexOf(CurrentPeriod) ?? 0"
                   CurrentPeriodChanged="OnPeriodChange" />
    </Actions>
</PageHeading>

@if (UserStatus == UserStatus.New)
{
    <NotificationScreen Text="Once you add your first transaction, your dashboard will be populated with useful insights.">
        <HxButton Color="ThemeColor.Primary" @onclick="() => Navigation.NavigateTo(Pages.Import)">Import now</HxButton>
    </NotificationScreen>
}
else
{
    @if (DashboardData?.TopOverBudgetCategory is not null)
    {
        <Alert Level="Alert.AlertLevel.Warning" ActionText="Review budget" ActionUrl="@Pages.Budget">@GetWarningText()</Alert>
    }

    <DashboardCards Count="4">
        <BasicCard Title="Over budget" Value="@OverBudgetText" Description="@OverBudgetDescription" Colour="@OverBudgetColour" OnClick="@(() => Navigation.NavigateTo(Pages.Statistics + '/' + Tabs.Chart1))" />
        <BasicCard Title="Spent this month" Value="@SpentThisMonthText" Description="@SpentThisMonthDescription" Colour="@SpentThisMonthColour" OnClick="@(() => Navigation.NavigateTo(Pages.Activities))" />
        <BasicCard Title="Remaining" Value="@RemainingText" Description="@RemainingDescription" Colour="@RemainingColour" OnClick="@(() => Navigation.NavigateTo(Pages.Budget))" />
        <BasicCard Title="Unassigned" Value="@UnassignedText" Description="@UnassignedDescription" Colour="@UnassignedColour" OnClick="@(() => Navigation.NavigateTo(Pages.Review))" />
    </DashboardCards>

    <DashboardCards Count="2">
        <BudgetCard CategoryUsages="BudgetCategoryUsages?.OrderByDescending(x => x.Proportion).ToList()" />
        <SpendCard CategoryUsages="BudgetCategoryUsages?.OrderByDescending(x => x.Amount).ToList()" />
    </DashboardCards>

    <DashboardCards Count="2">
        <BasicCard Title="Income share" Value="@IncomeShareText" Description="@IncomeShareDescription" Colour="@IncomeShareColour" OnClick="@(() => Navigation.NavigateTo(Pages.Activities))" />
        <BasicCard Title="Last transaction" Value="@LastTransactionText" Description="@LastTransactionDescription" Colour="@LastTransactionColour" OnClick="@(() => Navigation.NavigateTo(Pages.Import))" />
    </DashboardCards>
}
