@inherits MainPageBase

<PageTitle>Dashboard</PageTitle>
<PageHeading Heading="Dashboard" Subheading="@DateTime.Today.ToString("dddd, dd MMMM yyyy", CultureInfo.CurrentCulture)">
    <Actions>
        <HxSelect TItem="ScopedPeriod"
                  TValue="ScopedPeriod"
                  @bind-Value="CurrentPeriod"
                  @bind-Value:after="OnPeriodChange"
                  Data="DashboardData?.AvailablePeriods ?? [CurrentPeriod]"
                  TextSelector="@(period => ScopeHelper.GetPeriodName(period.StartDate, period.Scope))"
                  AutoSort="false"
                  Nullable="false" />
    </Actions>
</PageHeading>

@if (DashboardData is not null)
{
    @if (DashboardData.TopOverBudgetCategory is not null)
    {
        <Alert Level="Alert.AlertLevel.Warning" ActionText="Review budget" ActionUrl="/Budget">@GetWarningText()</Alert>
    }

    <DashboardCards Count="4">
        <BasicCard Title="Over budget"
                   Value="@($"{DashboardData.OverBudgetCategories} {LanguageUtilities.Pluralise("categories", DashboardData.OverBudgetCategories)}")"
                   Description="@($"{LanguageUtilities.Pluralise("needs", DashboardData.OverBudgetCategories, true)} attention")"
                   Colour="@(DashboardData.OverBudgetCategories > 0 ? ColourUtilities.DangerColour : ColourUtilities.PrimaryColour)"
                   OnClick="@(() => Navigation.NavigateTo("/Statistics/Legacy1"))" />

        <BasicCard Title="Spent this month"
                   Value="@(DashboardData.SpentThisMonth.ToString("C", CultureInfo.CurrentCulture))"
                   Description="@($"of {DashboardData.BudgetedThisMonth.ToString("C", CultureInfo.CurrentCulture)} budgeted")"
                   Colour="@ColourUtilities.PrimaryColour"
                   OnClick="@(() => Navigation.NavigateTo("/Activities"))" />

        <BasicCard Title="Remaining"
                   Value="@((DashboardData.BudgetedThisMonth - DashboardData.SpentThisMonth).ToString("C", CultureInfo.CurrentCulture))"
                   Description="@($"{(DashboardData.BudgetedThisMonth == 0m ? 0m : DashboardData.SpentThisMonth / DashboardData.BudgetedThisMonth):P0} through budget")"
                   Colour="@(DashboardData.BudgetedThisMonth - DashboardData.SpentThisMonth <= 0m ? ColourUtilities.DangerColour : ColourUtilities.SuccessColour)"
                   OnClick="@(() => Navigation.NavigateTo("/Budget"))" />

        <BasicCard Title="Unassigned"
                   Value="@($"{DashboardData.UnassignedTransactions} {LanguageUtilities.Pluralise("activities", DashboardData.UnassignedTransactions)}")"
                   Description="@($"{LanguageUtilities.Pluralise("needs", DashboardData.UnassignedTransactions, true)} categorising")"
                   Colour="@(DashboardData.UnassignedTransactions > 0 ? ColourUtilities.WarningColour : ColourUtilities.PrimaryColour)"
                   OnClick="@(() => Navigation.NavigateTo("/Review"))" />
    </DashboardCards>

    <DashboardCards Count="2">
        <BudgetCard CategoryUsages="BudgetCategoryUsages.OrderByDescending(x => x.Proportion).ToList()" />
        <SpendCard CategoryUsages="BudgetCategoryUsages.OrderByDescending(x => x.Amount).ToList()" />
    </DashboardCards>

    <DashboardCards Count="2">
        <BasicCard Title="Income share"
                   Value="@(DashboardData.IncomeShare.ToString("P0", CultureInfo.CurrentCulture))"
                   Description="of transacted value"
                   Colour="@(ColourUtilities.PrimaryColour)"
                   OnClick="@(() => Navigation.NavigateTo("/Activities"))" />

        <BasicCard Title="Last transaction"
                   Value="@(DashboardData.DaysSinceLastImport == 0 ? "today" : $"{DashboardData.DaysSinceLastImport} {LanguageUtilities.Pluralise("days", DashboardData.DaysSinceLastImport)} ago")"
                   Description="@($"on {DateTime.Today.AddDays(-DashboardData.DaysSinceLastImport):yyyy-MM-dd}")"
                   Colour="@(ColourUtilities.PrimaryColour)"
                   OnClick="@(() => Navigation.NavigateTo("/Import"))" />
    </DashboardCards>
}
