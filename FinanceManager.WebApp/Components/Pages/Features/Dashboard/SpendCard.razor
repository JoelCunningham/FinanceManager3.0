@code {
    [Parameter] public IReadOnlyList<BudgetCategoryUsage> CategoryUsages { get; set; } = [];

    private bool IsByGroupView { get; set; } = true;

    private decimal TotalSpending => CategoryUsages.Sum(c => c.Amount);

    private const int MaxResults = 6;

    private IReadOnlyList<BudgetCategoryUsage> DisplayCategoryUsages => CategoryUsages
        .OrderByDescending(c => c.Amount)
        .Take(MaxResults)
        .Concat(GetOtherCategoryUsage())
        .ToList();

    private IReadOnlyList<BudgetCategoryUsage> DisplayCategoryGroupUsages => CategoryUsages
        .GroupBy(c => c.Summary.GroupName)
        .Select(g => new BudgetCategoryUsage
        {
            Summary = new CategorySummary
            {
                Name = g.Key,
                GroupName = g.Key,
                Colour = g.First().Summary.GroupColour,
            },
            Amount = g.Sum(c => c.Amount),
            Proportion = GetAmountProportion(g.Sum(c => c.Amount)),
        })
        .OrderByDescending(c => c.Amount)
        .Take(MaxResults)
        .Concat(GetOtherCategoryUsage())
        .ToList();


    private void ToggleView()
    {
        IsByGroupView = !IsByGroupView;
    }

    private decimal GetAmountProportion(decimal amount) => TotalSpending == 0 ? 0 : amount / TotalSpending;

    private IEnumerable<BudgetCategoryUsage> GetOtherCategoryUsage()
    {
        var otherAmount = CategoryUsages
            .OrderByDescending(c => c.Amount)
            .Skip(MaxResults)
            .Sum(c => c.Amount);

        if (otherAmount <= 0m) return [];

        return [new BudgetCategoryUsage
        {
            Summary = new CategorySummary
            {
                Name = "Other",
                GroupName = "Other",
                Colour = ""
            },
            Amount = otherAmount,
            Proportion = GetAmountProportion(otherAmount),
        }];
    }

    private object GetChartOptions(bool isByGroupView)
    {
        var options = new
        {
            tooltip = new { show = false, trigger = "item", formatter = "{b}: {d}%" },
            legend = new
            {
                orient = "horizontal",
                bottom = "30",
                left = "center",
            },
            title = new
            {
                text = TotalSpending.ToString("C"),
                left = "49.5%",
                top = "50%",
                textAlign = "center",
                textVerticalAlign = "middle",
                textStyle = new { fontSize = 20, fontWeight = "bold" },
            },
            series = new[]
            {
                new
                {
                    name = "Spending",
                    type = "pie",
                    radius = new List<string>() { "35%", "50%" },
                    center = new List<string>() { "50%", "50%" },
                    data = isByGroupView
                        ? DisplayCategoryGroupUsages.Select(c => new { value = GetAmountProportion(c.Amount), name = c.Summary.Name == "Other" ? "Other" : c.Summary.GroupName })
                        : DisplayCategoryUsages.Select(c => new { value = GetAmountProportion(c.Amount), name = c.Summary.Name == "Other" ? "Other" : c.DisplayName }),
                    label = new { show = false },
                    silent = true,
                }
            },
        };
        return options;
    }
}

<div class="card">
    <div class="heading">
        <h5 class="card-title>">Budget usage</h5>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <HxButton Color="ThemeColor.Light" OnClick="ToggleView">@(!IsByGroupView ? "By category" : "By area")</HxButton>
        </div>
    </div>
    @if (!CategoryUsages.Any())
    {
        <div class="empty-text">
            <p class="text-muted">No spending activities have been recorded for this period.</p>
        </div>
    }
    else
    {
        <div class="chart">
            <HxEChart Options="@GetChartOptions(IsByGroupView)" AutoResize="true" />
        </div>
    }
</div>