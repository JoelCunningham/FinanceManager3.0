@using FinanceManager.Application.UseCases
@inject UseCases UseCases

@code
{
    [Parameter] public string Title { get; set; } = default!;
    [Parameter] public ChartSeries Data { get; set; } = default!;

    private ChartModel Chart { get; set; } = default!;

    protected override async Task OnParametersSetAsync()
    {
        Chart = new([], [], 1, ReloadChart);
        await Chart.RefreshAsync();
    }

    private async Task ReloadChart()
    {
        Chart.Options = new(hideXAxis: true, legendBottom: "30");
        Chart.Options.SetTitle(Title);
        Chart.Options.AddSeries(Data);
    }
}

<div class="chart-wrapper">
    <Chart ChartModel="Chart" />
</div>