@if (Success)
{
    <PageHeading Heading="Your email has been confirmed" Centred="true" />

    <div class="textblock">
        @if (Model.Reason == ConfirmEmailReason.UpdateEmail)
        {
            <p class="text-center">You can now use your new email address to sign in</p>
        }
        else
        {
            <p class="text-center">You can now start using your account</p>
        }
    </div>
}
else
{
    <PageHeading Heading="Email confirmation failed" Centred="true" />

    <div class="textblock">
        <p class="text-center">@Message</p>
    </div>
}

<HxButton Color="ThemeColor.Primary" @onclick="() => Navigation.NavigateTo(Pages.Login)">Go to sign in</HxButton>