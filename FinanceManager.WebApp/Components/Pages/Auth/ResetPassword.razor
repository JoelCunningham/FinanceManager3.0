@page "/ResetPassword"
@inherits AuthPageBase

<PageHeading Heading="Reset Password" Subheading="Create a new password" />

@if (!Complete)
{
    <EditForm FormName="ResetPasswordForm" Model="Model" OnValidSubmit="HandleResetPassword">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Password</label>
            <InputText type="password" class="form-control" @bind-Value="Model.Password" />
        </div>

        <div class="mb-3">
            <label>Confirm Password</label>
            <InputText type="password" class="form-control" @bind-Value="Model.ConfirmPassword" />
        </div>

        <button class="btn btn-primary">
            Reset Password
        </button>
    </EditForm>
}
else
{
    <p>Password reset successfully.</p>

    <a href="@Pages.Login">Login</a>
}

@if (Message != null)
{
    <p class="text-danger">@Message</p>
}