@if (Success)
{
    <PageHeading Heading="Your new password has been set" Centred="true" />

    <div class="textblock">
        <p class="text-center">You can now sign in with your new password.</p>
    </div>

    <HxButton Color="ThemeColor.Primary" @onclick="() => Navigation.NavigateTo(Pages.Login)">Go to sign in</HxButton>
}
else if (!RequestValid)
{
    <PageHeading Heading="Reset link expired" Centred="true" />
    <div class="textblock">
        <p class="text-center">Your reset link has expired. Please request a new password reset.</p>
    </div>
    <HxButton Color="ThemeColor.Primary" @onclick="() => Navigation.NavigateTo(Pages.ForgotPassword)">Request new link</HxButton>
}
else
{
    <PageHeading Heading="Set a new password" Subheading="Your reset link is valid. Choose a new password for your account." />

    if (Message is not null)
    {
        <Alert Level="Alert.AlertLevel.Error">@Message</Alert>
    }

    <EditForm FormName="ResetPasswordForm" Model="Model">
        <DataAnnotationsValidator />

        <HxInputText @bind-Value="Model.Password" Label="Password" Type="InputType.Password" />

        <HxInputText @bind-Value="Model.ConfirmPassword" Label="Confirm password" Type="InputType.Password" />

        <HxSubmit Color="ThemeColor.Primary" OnValidClick="HandleResetPassword">Set new password</HxSubmit>
    </EditForm>

    <span class="auth-link">Remembered your password? <a href="@Pages.Login">Sign in</a></span>
}