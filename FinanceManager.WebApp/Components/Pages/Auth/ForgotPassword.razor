<PageHeading Heading="Forgot Password" Subheading="Enter your email to reset your password" />

<EditForm FormName="ForgotPasswordForm" Model="Model" OnValidSubmit="HandleForgotPassword">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="Model.Email" />
    </div>

    <button class="btn btn-primary">
        Send Reset Link
    </button>
</EditForm>

@if (Message != null)
{
    <p class="mt-3">@Message</p>
}