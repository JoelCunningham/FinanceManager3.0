@if (Success)
{
    <PageHeading Heading="Check your email" Centred="true" />

    <div class="textblock">
        <p class="text-center">We've sent a confirmation link to</p>
        <p class="text-center mb-3"><b>@Model.Email</b>.</p>

        <p class="text-center">Click the link in the email to verify your account and get started.</p>
    </div>

    <HxButton Color="ThemeColor.Primary" OnClick="() => Navigation.NavigateTo(Pages.Login)">Go to sign in</HxButton>

    <span class="auth-link">Haven't received the email? <a href="@Pages.ForgotPassword" @onclick="() => Success = false">Try again</a></span>
}
else
{
    <PageHeading Heading="Reset your password" Subheading="Enter your email address and we'll send you a link to choose a new password." />

    @if (Message is not null)
    {
        <Alert Level="Alert.AlertLevel.Error">@Message</Alert>
    }

    <EditForm FormName="ForgotPasswordForm" Model="Model" OnValidSubmit="HandleForgotPassword">
        <HxInputText @bind-Value="Model.Email" Label="Email address" />

        <HxSubmit Color="ThemeColor.Primary">Send reset link</HxSubmit>
    </EditForm>

    <span class="auth-link"><a href="@Pages.Login">Back to sign in</a></span>
}
