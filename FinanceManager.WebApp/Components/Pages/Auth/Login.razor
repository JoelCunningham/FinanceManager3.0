<PageHeading Heading="Welcome back" Subheading="Sign in to your account to continue." />

@if (Message is not null)
{
    <Alert Level="Alert.AlertLevel.Error">@Message</Alert>
}

<EditForm FormName="LoginForm" Model="Model">
    <DataAnnotationsValidator />

    <HxInputText @bind-Value="Model.Email" Label="Email address" />

    <HxInputText @bind-Value="Model.Password" Type="InputType.Password" LabelCssClass="d-flex justify-content-between">
        <LabelTemplate>
            <span>Password</span>
            <a href="@Pages.ForgotPassword">Forgot password?</a>
        </LabelTemplate>
    </HxInputText>

    <HxCheckbox @bind-Value="Model.RememberMe" Text="Remember me" />

    <HxSubmit Color="ThemeColor.Primary" OnValidClick="HandleLogin">Sign in</HxSubmit>
</EditForm>

<span class="auth-link">Don't have an account? <a href="@Pages.Register">Create one</a></span>