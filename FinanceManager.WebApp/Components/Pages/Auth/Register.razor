@inherits AuthPageBase

<PageHeading Heading="Register" Subheading="Create a new account" />

<EditForm FormName="RegisterForm" Model="Model" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="Model.Name" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="Model.Email" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText type="password" class="form-control" @bind-Value="Model.Password" />
    </div>

    <div class="mb-3">
        <label>Confirm Password</label>
        <InputText type="password" class="form-control" @bind-Value="Model.ConfirmPassword" />
    </div>

    <button class="btn btn-primary">Register</button>
</EditForm>

@if (Errors.Any())
{
    <ul class="text-danger mt-2">
        @foreach (var error in Errors)
        {
            <li>@error</li>
        }
    </ul>
}