@page "/"
@inherits PageBase
@inject NavigationManager NavigationManager

<PageTitle>Dashboard</PageTitle>

<h1 class="page-heading">Dashboard</h1>

<div class="d-flex justify-content-evenly gap-2">
    <BasicCard Title="Spent this month" Value="$2,410.00" Description="of $3,200.00 budgeted" Colour="var(--bs-primary)" OnClick="@(() => NavigationManager.NavigateTo("/Activities"))" />
    <BasicCard Title="Remaining" Value="$790.00" Description="75% through month" Colour="var(--bs-success)" OnClick="@(() => NavigationManager.NavigateTo("/Budget"))" />
    <BasicCard Title="Over budget" Value="3 categories" Description="needs attention" Colour="var(--bs-warning)" OnClick="@(() => NavigationManager.NavigateTo("/Statistics"))" />
    <BasicCard Title="Unassigned" Value="12 txns" Description="need categorising" Colour="var(--bs-primary)" OnClick="@(() => NavigationManager.NavigateTo("/Review"))" />
</div>

<div class="py-2">
    <HxAlert Color="ThemeColor.Warning" CssClass="m-0">
        Eating Out is 114% of budget — $28 over. Groceries at 91%.
    </HxAlert>
</div>

<div class="d-flex justify-content-evenly gap-2">
    <BudgetCard CategoryUsages="BudgetCategoryUsages" />
    <SpendCard CategoryUsages="BudgetCategoryUsages" />
</div>

<div class="d-flex justify-content-evenly gap-2 py-2">
    <BasicCard Title="Incomes make up" Value="60%" Description="of transaction value" Colour="var(--bs-primary)" />
    <BasicCard Title="Last import" Value="19 days ago" Description="click to import now" Colour="var(--bs-primary)" OnClick="@(() => NavigationManager.NavigateTo("/Import"))" />
</div>
